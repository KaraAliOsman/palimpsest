ied"},{"concept_id":"nausea_vomiting","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.06,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.21,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:2.135":{"ref":"De materia medica 2.135","headword":"σίκυς ἥμερος εὐκοίλιος","lang":"grc","source":"dioscorides","text":"σίκυς ἥμερος εὐκοίλιος, εὐστόμαχος, ψυκτικός, οὐ φθειρόμενος, κύστει ἁρμόδιος, ἀνακτητικὸς λειποθυμιῶν ὀσφραινόμενος. καὶ τὸ σπέρμα δὲ αὐτοῦ μετρίως οὐρητικόν, ἁρμόζον σὺν γάλακτι ἢ γλυκεῖ πρὸς τὰς ἐν κύστει ἑλκώσεις. τὰ δὲ φύλλα αὐτοῦ σὺν οἴνῳ καταπλασθέντα κυνόδηκτα ἰᾶται, σὺν μέλιτι δὲ καὶ ἐπινυκτίδας. ἡ δὲ τοῦ πέπονος σὰρξ καὶ αὐτὴ πεπτική, οὐρητικὴ ἐσθιομένη, καταπλασθεῖσα δὲ ὀφθαλμοῦ φλεγμονὰς πραύνει. τὸ δὲ δέρμα αὐτοῦ σειριῶσι παιδίοις ἐπιτίθεται ἐπὶ τοῦ βρέγματος, καὶ ῥαυματιζομένοις ὀφθαλμοῖς ἀντὶ ἀνακολλήματος κατὰ τοῦ μετώπου. ὁ δὲ χυλὸς σὺν τῷ σπέρματι μιγεὶς ἀλεύρῳ καὶ ξηρανθεὶς ἐν ἡλίῳ σμῆγμα γίνεται ῥυπτικὸν καὶ προσώπου λαμπρυντικόν. ἡ δὲ ῥίζα ξηρὰ ποθεῖσα σὺν ὑδρομέλιτι δραχμῆς μιᾶς ὁλκὴ ἐμέτους κινεῖ· εἰ δέ τις πραέως ἀπὸ δείπνου ἐμέσαι θέλοι, ἀρκέσουσιν ὀβολοὶ δύο· ὑγιάζει δὲ καὶ κηρία καταπλασθεῖσα λεία μετὰ τοῦ μέλιτος.","spans":[{"start":13,"end":20,"concept_id":"constipation","polarity":"action"},{"start":24,"end":32,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":62,"end":68,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":91,"end":99,"concept_id":"heart","polarity":"therapeutic"},{"start":149,"end":156,"concept_id":"diuresis","polarity":"action"},{"start":201,"end":207,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":208,"end":216,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":259,"end":267,"concept_id":"envenomation","polarity":"therapeutic"},{"start":294,"end":303,"concept_id":"abscess","polarity":"therapeutic"},{"start":347,"end":354,"concept_id":"diuresis","polarity":"action"},{"start":384,"end":398,"concept_id":"conjunctivitis","polarity":"therapeutic"},{"start":393,"end":400,"concept_id":"inflammation","polarity":"therapeutic"},{"start":498,"end":504,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":715,"end":726,"concept_id":"nausea_vomiting","polarity":"action"},{"start":811,"end":816,"concept_id":"abscess","polarity":"therapeutic"}]}},"gloss":{"dsc:2.135":{"13":"loosening the bowels (εὔκοιλιος)","24":"good for the stomach (εὐστόμαχος)","62":"bladder (κύστις)","91":"fainting (λειποθυμία)","149":"diuretic (οὐρητικός, διουρητικός)","201":"bladder (κύστις)","208":"ulcers (ἕλκη, ἑλκώσεις)","259":"dog-bitten (κυνόδηκτοι)","294":"night-pustules (ἐπινυκτίδες)","347":"diuretic (οὐρητικός, διουρητικός)","384":"inflammation of the eyes","393":"inflammations (φλεγμοναί)","498":"the eyes; eye-salves (ὀφθαλμικά)","715":"provokes vomiting (emetic)","811":"honeycomb boils (κηρία)"}},"images":[]}