persistent":true,"epmc_pair":0,"lift":0.78,"evidence_tier":"unstudied"},{"concept_id":"tuberculosis","dsc":1,"cul":1,"persistent":true,"epmc_pair":2,"lift":1.39,"evidence_tier":"sparse"},{"concept_id":"common_cold","dsc":0,"cul":2,"persistent":false,"epmc_pair":1,"lift":1.69,"evidence_tier":"sparse"},{"concept_id":"dermatitis","dsc":0,"cul":2,"persistent":false,"epmc_pair":0,"lift":0.47,"evidence_tier":"unstudied"},{"concept_id":"liver_disease","dsc":0,"cul":2,"persistent":false,"epmc_pair":4,"lift":1.72,"evidence_tier":"sparse"},{"concept_id":"amenorrhea","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.7,"evidence_tier":"unstudied"},{"concept_id":"helminthiasis","dsc":0,"cul":1,"persistent":false,"epmc_pair":2,"lift":2.74,"evidence_tier":"sparse"},{"concept_id":"itch_scabies","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.74,"evidence_tier":"unstudied"},{"concept_id":"kidney_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":2,"lift":1.08,"evidence_tier":"sparse"},{"concept_id":"pleurisy_pneumonia","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.31,"evidence_tier":"unstudied"},{"concept_id":"spleen_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":0.93,"evidence_tier":"sparse"}],"lead_score":0.5848},"texts":{"dsc:3.105":{"ref":"De materia medica 3.105","headword":"πράσιον","lang":"grc","source":"dioscorides","text":"πράσιον, οἱ δὲ φιλοφαρές· θάμνος ἐστιν ἀπὸ μιᾶς ῥίζης πολύκλαδος, ὑπόδασυς, λευκός, τετράγωνος τοῖς ῥαβδίοις· φύλλον δὲ τῷ μεγάλῳ δακτύλῳ ἴσον, ὑποστρόγγυλον, δασύ, ἔρρυσον, πικρὸν τῇ γεύσει· ἐκ διαστημάτων δὲ ἐπὶ τῶν καυλῶν τὸ σπέρμα καὶ τὰ ἄνθη, οἱονεὶ σφόνδυλοι, τραχέα φύεται περὶ τὰ οἰκόπεδα καὶ ἐρείπια. τούτου τὰ φύλλα ξηρὰ σὺν τῷ σπέρματι ἀφεψόμενα ἐν ὕδατι ἢ χυλιζόμενα χλωρὰ δίδοται μετὰ μέλιτος φθισικοῖς, ἀσθματικοῖς, βήσσουσιν· ἀνάγει καὶ πάχος ἐκ θώρακος ἴριδος ξηρᾶς μιγείσης· δίδοται καὶ ταῖς μὴ καθαιρομέναις γυναιξὶ πρὸς 2 ἀγωγὴν ἐμμήνων καὶ δευτέρων καὶ δυστοκούσαις καὶ θηριοδήκτοις καὶ τοῖς θανάσιμον πεπωκόσι· κύστει μέντοι καὶ νεφροῖς ἄθετον. τὰ δὲ φύλλα καταπλασσόμενα σὺν μέλιτι ῥυπαρὰ ἕλκη ἀνακαθαίρει, πτερύγιά τε καὶ νομὰς ἀφίστησι καὶ ὀδύνην πλευρῶν παραιτεῖται· καὶ τὸ ἐξ αὐτοῦ δὲ κατασκευαζόμενον χύλισμα ἐκθλιβομένων τῶν φύλλων καὶ συστρεφομένων ἐν ἡλίῳ πρὸς τὰ αὐτὰ ποιεῖ, ἔστι δὲ ὀξυδερκὲς σὺν μέλιτι ἐγχριόμενον καὶ ἴκτερον ἀποκαθαίρει διὰ τῶν ῥινῶν, ὠταλγίαις τε ἁρμόζει ἐγχυματιζόμενον καθ᾿ ἑαυτὸ καὶ μετὰ ῥοδίνου.","spans":[{"start":406,"end":412,"concept_id":"tuberculosis","polarity":"therapeutic"},{"start":417,"end":421,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":430,"end":434,"concept_id":"cough","polarity":"therapeutic"},{"start":441,"end":466,"concept_id":"cough","polarity":"action"},{"start":541,"end":568,"concept_id":"labor","polarity":"action"},{"start":573,"end":579,"concept_id":"labor","polarity":"therapeutic"},{"start":590,"end":599,"concept_id":"envenomation","polarity":"therapeutic"},{"start":612,"end":619,"concept_id":"poisoning","polarity":"therapeutic"},{"start":622,"end":627,"concept_id":"poisoning","polarity":"therapeutic"},{"start":632,"end":638,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":650,"end":662,"concept_id":"kidney_disease","polarity":"adverse"},{"start":711,"end":715,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":745,"end":750,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":764,"end":776,"concept_id":"pleurisy_pneumonia","polarity":"therapeutic"},{"start":914,"end":921,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":951,"end":956,"concept_id":"jaundice","polarity":"therapeutic"},{"start":986,"end":991,"concept_id":"ear_disease","polarity":"therapeutic"}]},"dsc:5.48":{"ref":"De materia medica 5.48","headword":"ὁ διὰ πρασίου","lang":"grc","source":"dioscorides","text":"ὁ διὰ πρασίου· πρασίου τοῦ ἀκμαίου φύλλων κόψας χοίνικας β΄ κάθες εἰς μετρητὴν γλεύκους, καὶ τὰ ἄλλα ὁμοίως ποίει· ἁρμόζει τοῖς περὶ θώρακα καὶ πρὸς ὅσα καὶ τὸ πράσιον.","spans":[]},"cul:161-horehound":{"ref":"Culpeper, Complete Herbal: Horehound","headword":"Horehound","lang":"en","source":"culpeper","text":"It is an herb of Mercury. A decoction of the dried herb, with the seed, or the juice of the green herb taken with honey, is a remedy for those that are short-winded, have a cough, or are fallen into a consumption, either through long sickness, or thin distillations of rheum upon the lungs. It helps to expectorate tough phlegm from the chest, being taken from the roots of Iris or Orris. It is given to women to bring down their courses, to expel the after-birth, and to them that have taken poison, or are stung or bitten by venemous serpents. The leaves used with honey, purge foul ulcers, stay running or creeping sores, and the growing of the flesh over the nails. It also helps pains of the sides. The juice thereof with wine and honey, helps to clear the eyesight, and snuffed up into the nostrils, purges away the yellow-jaundice, and with a little oil of roses dropped into the ears, eases the pains of them. Galen saith, it opens obstructions both of the liver and spleen, and purges the breast and lungs of phlegm: and used outwardly it both cleanses and digests. A decoction of Horehound (saith Matthiolus) is available for those that have hard livers, and for such as have itches and running tetters. The powder hereof taken, or the decoction, kills worms. The green leaves bruised, and boiled in old hog’s grease into an ointment, heals the biting of dogs, abates the swellings and pains that come by any pricking of thorns, or such like means; and used with vinegar, cleanses and heals tetters. There is a syrup made of Horehound to be had at the apothecaries, very good for old coughs, to rid the tough phlegm; as also to void cold rheums from the lungs of old folks, and for those that are asthmatic or short-winded.","spans":[{"start":152,"end":164,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":173,"end":178,"concept_id":"cough","polarity":"therapeutic"},{"start":201,"end":212,"concept_id":"tuberculosis","polarity":"therapeutic"},{"start":252,"end":265,"concept_id":"common_cold","polarity":"therapeutic"},{"start":269,"end":274,"concept_id":"common_cold","polarity":"therapeutic"},{"start":303,"end":314,"concept_id":"cough","polarity":"action"},{"start":321,"end":342,"concept_id":"cough","polarity":"action"},{"start":413,"end":437,"concept_id":"amenorrhea","polarity":"action"},{"start":452,"end":463,"concept_id":"labor","polarity":"therapeutic"},{"start":493,"end":499,"concept_id":"poisoning","polarity":"therapeutic"},{"start":508,"end":513,"concept_id":"envenomation","polarity":"therapeutic"},{"start":517,"end":523,"concept_id":"envenomation","polarity":"therapeutic"},{"start":527,"end":535,"concept_id":"envenomation","polarity":"therapeutic"},{"start":536,"end":544,"concept_id":"envenomation","polarity":"therapeutic"},{"start":585,"end":591,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":618,"end":623,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":752,"end":770,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":829,"end":837,"concept_id":"jaundice","polarity":"therapeutic"},{"start":878,"end":908,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":940,"end":970,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":975,"end":981,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":998,"end":1024,"concept_id":"cough","polarity":"action"},{"start":1152,"end":1163,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":1186,"end":1192,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":1205,"end":1212,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":1263,"end":1268,"concept_id":"helminthiasis","polarity":"therapeutic"},{"start":1355,"end":1364,"concept_id":"envenomation","polarity":"therapeutic"},{"start":1501,"end":1508,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":1