t_id":"scrofula","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.89,"evidence_tier":"unstudied"},{"concept_id":"syphilis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.88,"evidence_tier":"unstudied"},{"concept_id":"tinea","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":2.14,"evidence_tier":"sparse"}],"lead_score":null},"texts":{"dsc:1.76":{"ref":"De materia medica 1.76","headword":"βράθυ","lang":"grc","source":"dioscorides","text":"βράθυ, ὅ ἔνιοι βόρατον καλοῦσιν. ἔστι τούτου εἴδη φύο· τὸ γὰρ ἐστιν σὺτοῦ τοῖς ὅμοιον κυπαρίσσῳ, ἀκανθωδέστερον δὲ καὶ βαρύοσμον, κολοβόν τε τὸ δένδρον καὶ εἰς πλάτος μᾶλλον ἐκχεόμενον· χρῶνται δὲ τούτου τοῖς φύλλοις ἀντὶ θυμιάματος. τὸ δὲ ἕτερὸν ἐστι μυρίκη τοῖς φύλλοις ὅμοιον. ἀμφοτέρων δὲ τὰ φύλλα ἵστησι νομάς καὶ φλεγμονὰς καταπλασσόμενα πραύνει, ἀποκαθαίρει τε μελανίας σὺν μέλιτι καταπλασσόμενα καὶ τάς ῥυπαρίας καὶ ἄνθρακας περιρρήσσει. ποθέντα δὲ καὶ ΑἾΜΑ δι᾿ οὔρων ἄγει καὶ ἔμβρυα ἐκτινάσσει· προστεθέντα δὲ καὶ ὑποθυμιαθέντα τὸ αὐτὸ ποιεῖ, μείγνυται δὲ καὶ τοῖς θερμαντικοῖς χρίσμασιν, ἰδίως δὲ τῳ γλευκίνῳ.","spans":[{"start":309,"end":314,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":319,"end":326,"concept_id":"inflammation","polarity":"therapeutic"},{"start":424,"end":432,"concept_id":"abscess","polarity":"therapeutic"},{"start":470,"end":480,"concept_id":"diuresis","polarity":"action"},{"start":485,"end":502,"concept_id":"abortifacient","polarity":"action"}]},"cul:274-savine":{"ref":"Culpeper, Complete Herbal: Savine","headword":"Savine","lang":"en","source":"culpeper","text":"It is under the dominion of Mars, being hot and dry in the third degree, and being of exceeding clean parts, is of a very digesting quality. If you dry the herb into powder, and mix it with honey, it is an excellent remedy to cleanse old filthy ulcers and fistulas; but it hinders them from healing. The same is excellently good to break carbuncles and plague-sores; also helps the king’s evil, being applied to the place. Being spread over a piece of leather, and applied to the navel, kills the worms in the belly, helps scabs and itch, running sores, cankers, tetters, and ringworms; and being applied to the place, may haply cure venereal sores. This I thought good to speak of, as it may be safely used outwardly, for inwardly it cannot be taken without manifest danger.","spans":[{"start":245,"end":251,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":256,"end":264,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":338,"end":348,"concept_id":"abscess","polarity":"therapeutic"},{"start":353,"end":359,"concept_id":"plague","polarity":"therapeutic"},{"start":382,"end":393,"concept_id":"scrofula","polarity":"therapeutic"},{"start":497,"end":502,"concept_id":"helminthiasis","polarity":"therapeutic"},{"start":523,"end":528,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":533,"end":537,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":547,"end":552,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":554,"end":561,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":563,"end":570,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":576,"end":585,"concept_id":"tinea","polarity":"therapeutic"},{"start":634,"end":648,"concept_id":"syphilis","polarity":"therapeutic"}]}},"gloss":{"dsc:1.76":{"309":"spreading ulcers (νομαί)","319":"inflammations (φλεγμοναί)","424":"carbuncles (ἄνθρακες)","470":"moves the urine","485":"expels / destroys the embryo"},"cul:274-savine":{"245":"ulcers (old, foul, running, fretting)","256":"fistula, fistulous ulcers","338":"carbuncle","353":"plague","382":"king's evil: scrofula","497":"worms (intestinal)","523":"scabs: scabies / scabby skin","533":"itch, itches, itching","547":"sores, running sores","554":"canker: spreading / eating ulcer","563":"tetters: vesicular or scaly eruptions (eczema, herpes)","576":"ringworm","634":"veneral heat of the reins in the French pox; venereal sores"}},"images":[]}