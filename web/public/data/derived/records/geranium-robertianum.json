{"slug":"geranium-robertianum","plant":{"taxon":"Geranium robertianum","family":"Geraniaceae","rank":"species","gbif_key":2890668,"wikidata":"Q160096","iucn":null,"gbif_occurrences":1153377,"common_name":"Herb Robert","names":[{"source":"culpeper","name":"Herb Robert","monograph_id":"cul:157-herb-robert","confidence":"high","note":"Standard identification."}],"n_compounds":16,"top_compounds":[{"name":"chromium","qid":"Q725"},{"name":"gallic acid","qid":"Q375837"},{"name":"kaempferol","qid":"Q393336"},{"name":"rutin","qid":"Q407857"},{"name":"quercetin","qid":"Q409478"},{"name":"trans-caffeic acid","qid":"Q414116"},{"name":"ellagic acid","qid":"Q422044"},{"name":"quercitrin","qid":"Q1649777"}],"epmc_total":51,"trials":0,"claims":[{"concept_id":"skin_ulcers","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.93,"evidence_tier":"unstudied"},{"concept_id":"wounds","dsc":0,"cul":1,"persistent":false,"epmc_pair":2,"lift":2.7,"evidence_tier":"sparse"}],"lead_score":null},"texts":{"cul:157-herb-robert":{"ref":"Culpeper, Complete Herbal: Herb Robert","headword":"Herb Robert","lang":"en","source":"culpeper","text":"It is under the dominion of Venus. Herb Robert is commended not only against the stone, but to stay blood, where or howsoever flowing, it speedily heals all green wounds, and is effectual in old ulcers in the privy parts, or elsewhere. You may persuade yourself this is true, and also conceive a good reason for it, do but consider it is an herb of Venus, for all it hath a man’s name.","spans":[{"start":163,"end":169,"concept_id":"wounds","polarity":"therapeutic"},{"start":195,"end":201,"concept_id":"skin_ulcers","polarity":"therapeutic"}]}},"gloss":{"cul:157-herb-robert":{"81":"the stone (urinary calculus)","95":"stays / stanches blood","163":"wounds (green, fresh, inward, old); wound-herb","195":"ulcers (old, foul, running, fretting)"}},"images":[]}