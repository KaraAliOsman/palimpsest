er":"sparse"},{"concept_id":"diarrhea","dsc":1,"cul":0,"persistent":false,"epmc_pair":4,"lift":0.23,"evidence_tier":"sparse"},{"concept_id":"diuresis","dsc":0,"cul":1,"persistent":false,"epmc_pair":2,"lift":0.28,"evidence_tier":"sparse"},{"concept_id":"envenomation","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.21,"evidence_tier":"unstudied"},{"concept_id":"headache","dsc":0,"cul":1,"persistent":false,"epmc_pair":3,"lift":0.18,"evidence_tier":"sparse"},{"concept_id":"jaundice","dsc":0,"cul":1,"persistent":false,"epmc_pair":2,"lift":0.22,"evidence_tier":"sparse"},{"concept_id":"leukorrhea","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.22,"evidence_tier":"unstudied"},{"concept_id":"lice","dsc":1,"cul":0,"persistent":false,"epmc_pair":6,"lift":1.62,"evidence_tier":"studied"},{"concept_id":"liver_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":34,"lift":0.53,"evidence_tier":"studied"},{"concept_id":"menorrhagia","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.27,"evidence_tier":"unstudied"},{"concept_id":"mouth_gums","dsc":0,"cul":1,"persistent":false,"epmc_pair":3,"lift":0.28,"evidence_tier":"sparse"},{"concept_id":"scaly_skin","dsc":1,"cul":0,"persistent":false,"epmc_pair":2,"lift":0.19,"evidence_tier":"sparse"},{"concept_id":"skin_blemishes","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.16,"evidence_tier":"unstudied"},{"concept_id":"spleen_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":6,"lift":0.19,"evidence_tier":"studied"},{"concept_id":"toothache","dsc":0,"cul":1,"persistent":false,"epmc_pair":3,"lift":0.39,"evidence_tier":"sparse"},{"concept_id":"vertigo","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":0.23,"evidence_tier":"sparse"}],"lead_score":0.5516},"texts":{"dsc:2.123":{"ref":"De materia medica 2.123","headword":"σεῦτλον διττόν ἐστιν","lang":"grc","source":"dioscorides","text":"σεῦτλον διττόν ἐστιν, οὗ τὸ μὲν μέλαν σταλτικώτερον κοιλίας σύν φακῇ ἑψηθέν, καὶ μᾶλλον ἡ ῥίζα, τὸ δὲ λευκὸν εὐκοίλιον. κακόχυμα δὲ ἀμφότερα διὰ τὸ ἐν αὐτοῖς νιτρῶδες, ὅθεν ὁ χυλὸς αὐτῶν καθαίρει κεφαλὴν ῥινὶ ἐγχεόμενος μετὰ μέλιτος καὶ ὠταλγίας ὠφελεῖ, τὸ δὲ τῶν ῥιζῶν καὶ τῶν φύλλων ἀφέψημα πιτύρων καὶ κονίδων σμηκτικὸν καὶ χιμέτλης πραυντικὸν καταντλούμενον. ὠμοῖς δὲ τοῖς φύλλοις καταπλάσσειν δεῖ ἀλφοὺς προεκνιτρωθέντας καὶ ἀλωπεκίας προκατασεῦτλον κνισθείσας καὶ τὰ νεμόμενα ἕλκη. ἑφθὴ δὲ ἐξανθήματα καὶ πυρίκαυτα καὶ ἐρυσιπέλατα ἰᾶται.","spans":[{"start":38,"end":57,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":109,"end":116,"concept_id":"constipation","polarity":"action"},{"start":237,"end":242,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":305,"end":310,"concept_id":"lice","polarity":"therapeutic"},{"start":402,"end":408,"concept_id":"scaly_skin","polarity":"therapeutic"},{"start":430,"end":437,"concept_id":"alopecia","polarity":"therapeutic"},{"start":482,"end":486,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":496,"end":503,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":511,"end":518,"concept_id":"burns","polarity":"therapeutic"},{"start":525,"end":533,"concept_id":"erysipelas","polarity":"therapeutic"}]},"cul:031-beets":{"ref":"Culpeper, Complete Herbal: Beets","headword":"Beets","lang":"en","source":"culpeper","text":"The government of these two sorts of Beets are far different; the red Beet being under Saturn and the white under Jupiter; therefore take the virtues of them apart, each by itself. The white Beet much loosens the belly, and is of a cleansing, digesting quality, and provokes urine. The juice of it opens obstructions both of the liver and spleen, and is good for the head-ache and swimmings therein, and turnings of the brain; and is effectual also against all venomous creatures; and applied to the temples, stays inflammations of the eyes; it helps burnings, being used with oil, and with a little alum put to it, is good for St. Anthony’s fire. It is good for all wheals, pushes, blisters, and blains in the skin: the herb boiled, and laid upon chilblains or kibes, helps them. The decoction thereof in water and some vinegar, heals the itch, if bathed therewith; and cleanses the head of dandruff, scurf, and dry scabs, and does much good for fretting and running sores, ulcers, and cankers in the head, legs, or other parts, and is much commended against baldness and shedding the hair. The red Beet is good to stay the bloody-flux, women’s courses, and the whites, and to help the yellow jaundice; the juice of the root put into the nostrils, purges the head, helps the noise in the ears, and the tooth-ache; the juice snuffed up the nose, helps a stinking breath, if the cause lie in the nose, as many times it does, if any bruise has been there: as also want of smell coming that way.","spans":[{"start":201,"end":218,"concept_id":"constipation","polarity":"action"},{"start":266,"end":280,"concept_id":"diuresis","polarity":"action"},{"start":304,"end":334,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":339,"end":345,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":367,"end":376,"concept_id":"headache","polarity":"therapeutic"},{"start":381,"end":398,"concept_id":"vertigo","polarity":"therapeutic"},{"start":404,"end":425,"concept_id":"vertigo","polarity":"therapeutic"},{"start":461,"end":469,"concept_id":"envenomation","polarity":"therapeutic"},{"start":515,"end":540,"concept_id":"conjunctivitis","polarity":"therapeutic"},{"start":551,"end":559,"concept_id":"burns","polarity":"therapeutic"},{"start":632,"end":646,"concept_id":"erysipelas","polarity":"therapeutic"},{"start":667,"end":673,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":675,"end":681,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":697,"end":703,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":840,"end":844,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":892,"end":900,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":902,"end":907,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":917,"end":922,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":968,"end":973,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":975,"end":981,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":987,"end":994,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":1060,"end":1068,"concept_id":"alopecia","polarity":"therapeutic"},{"start":1073,"end":1090,"concept_id":"alopecia","polarity":"therapeutic"},{"start":1116,"end":1153,"concept_id":"menorrhagia","polarity":"therapeutic"},{"start":1163,"end":1169,"concept_id":"leukorrhea","polarity":"therapeutic"},{"start":1194,"end":1202,"concept_id":"jaundice","polarity":"therapeutic"},{"start":1276,"end":1293,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":1303,"end":1313,"concept_id":"toothache","polarity":"therapeutic"},{"start":1354,"end":1369,"concept_id":"mouth_gums","polarity":"therapeutic"},{"start":1427,"end":1437,"concept_id":"bruises","polarity":"therapeutic"}]}},"images":["seutlon-melan-agrion-302r-dioscoride-vienne"]}