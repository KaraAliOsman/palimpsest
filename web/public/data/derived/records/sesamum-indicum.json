ατος ποιητικόν, ὁπόταν βιβρωσκόμενον ἐμμείνῃ μεταξὺ τῶν ὀδόντων. καταπλασθὲν δὲ διαφορεῖ τὰς ἐν νεύροις παχύτητας καὶ τὰ ἐν ὠσὶ θλάσματα καὶ φλεγμονάς καὶ πυρίκαυτα καὶ κόλου ἀλγήματα, καὶ κεράστου δῆγμα θεραπεύει· σὺν ῥοδίνῳ δὲ κεφαλῆς ἀλγήματα ἐξ ἐγκαύσεως γινόμενα παραμυθεῖται. ἡ δὲ πόα καθεψηθεῖσα ἐν οἴνῳ τὰ αὐτὰ ποιεῖ, μάλιστα δὲ φλεγμοναῖς ὀφθαλμῶν καὶ περιωδυνίαις ἁρμόζει. γίνεται δὲ καὶ ἔλαιον ἐξ αὐτοῦ, ᾧ οἱ ἐν Αἰγύπτῳ χρῶνται.","spans":[{"start":8,"end":18,"concept_id":"dyspepsia","polarity":"adverse"},{"start":25,"end":40,"concept_id":"mouth_gums","polarity":"therapeutic"},{"start":162,"end":165,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":166,"end":171,"concept_id":"bruises","polarity":"therapeutic"},{"start":179,"end":186,"concept_id":"inflammation","polarity":"therapeutic"},{"start":193,"end":200,"concept_id":"burns","polarity":"therapeutic"},{"start":227,"end":240,"concept_id":"envenomation","polarity":"therapeutic"},{"start":267,"end":278,"concept_id":"headache","polarity":"therapeutic"},{"start":375,"end":392,"concept_id":"conjunctivitis","polarity":"therapeutic"},{"start":399,"end":407,"concept_id":"pain","polarity":"therapeutic"}]}},"gloss":{"dsc:2.99":{"8":"bad for the stomach (κακοστόμαχος)","25":"ulcers / sores / bad odour of the mouth; mouth-remedies","162":"the ears (ὦτα)","166":"contusions (θλάσματα)","179":"inflammations (φλεγμοναί)","193":"burns (πυρίκαυτα)","227":"bites of beasts, snakes, vipers, shrews","267":"pain / heaviness of the head","375":"inflammation of the eyes","399":"violent pain (περιωδυνία)"}},"images":[]}