"cul":1,"persistent":false,"epmc_pair":0,"lift":0.98,"evidence_tier":"unstudied"},{"concept_id":"heart","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.75,"evidence_tier":"unstudied"},{"concept_id":"hemorrhage","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.87,"evidence_tier":"unstudied"},{"concept_id":"hemorrhoids","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"kidney_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.89,"evidence_tier":"unstudied"},{"concept_id":"liver_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.88,"evidence_tier":"unstudied"},{"concept_id":"sciatica","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"skin_blemishes","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"wounds","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.91,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:4.91":{"ref":"De materia medica 4.91","headword":"κοτυληδών","lang":"grc","source":"dioscorides","text":"κοτυληδών· οἱ δὲ σκυτάλιον, ἄλλοι δὲ κυμβάλιον. φύλλον ἔχει ὥσπερ ὀξύβαφον περιφερές, λεληθότως κοῖλον, καυλίον δὲ βραχύ, ἐφʼ οὗ σπέρμα, ῥίζαν ὡς ἐλαίαν στρογγύλην. ταύτης καὶ τῶν φύλλων ὁ χυλὸς μετʼ οἴνου περιχριόμενος ἢ ἐγκλυζόμενος φιμοὺς τοὺς ἐν αἰδοίοις χαλᾷ, φλεγμονάς τε καὶ ἐρυσιπέλατα καὶ χιμέτλας καὶ χοιράδας καταπλασσομένη ὠφελεῖ καὶ στόμαχον καυσούμενον. ἐσθιόμενα δὲ τὰ φύλλα σὺν τῇ ῥίζη λίθους θρύπτει καὶ οὖρα κινεῖ καὶ ὑδρωπικοῖς σὺν οἰνομέλιτι δίδοται· χρῶνται δὲ αὐτῇ καὶ εἰς φίλτρα.","spans":[{"start":265,"end":272,"concept_id":"inflammation","polarity":"therapeutic"},{"start":282,"end":290,"concept_id":"erysipelas","polarity":"therapeutic"},{"start":311,"end":317,"concept_id":"scrofula","polarity":"therapeutic"},{"start":335,"end":352,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":402,"end":414,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":421,"end":431,"concept_id":"diuresis","polarity":"action"},{"start":436,"end":441,"concept_id":"edema_dropsy","polarity":"therapeutic"}]},"cul:169-kidneywort-or-wall-pennyroyal-or-wall-pe":{"ref":"Culpeper, Complete Herbal: Kidneywort, Or Wall Pennyroyal, Or Wall Pennywort","headword":"Kidneywort, Or Wall Pennyroyal, Or Wall Pennywort","lang":"en","source":"culpeper","text":"Venus challenges the herb under Libra. The juice or the distilled water being drank, is very effectual for all inflammations and unnatural heats, to cool a fainting hot stomach, a hot liver, or the bowels: the herb, juice, or distilled water thereof, outwardly applied, heals pimples, St. Anthony’s fire, and other outward heats. The said juice or water helps to heal sore kidneys, torn or fretted by the stone, or exulcerated within; it also provokes urine, is available for the dropsy, and helps to break the stone. Being used as a bath, or made into an ointment, it cools the painful piles or hæmorrhoidal veins. It is no less effectual to give ease to the pains of the gout, the sciatica, and helps the kernels or knots in the neck or throat, called the king’s evil: healing kibes and chilblains if they be bathed with the juice, or anointed with ointment made thereof, and some of the skin of the leaf upon them: it is also used in green wounds to stay the blood, and to heal them quickly.","spans":[{"start":111,"end":124,"concept_id":"inflammation","polarity":"therapeutic"},{"start":156,"end":164,"concept_id":"heart","polarity":"therapeutic"},{"start":165,"end":176,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":180,"end":189,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":276,"end":283,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":289,"end":303,"concept_id":"erysipelas","polarity":"therapeutic"},{"start":373,"end":380,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":405,"end":410,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":443,"end":457,"concept_id":"diuresis","polarity":"action"},{"start":480,"end":486,"concept_id":"edema_dropsy","polarity":"therapeutic"},{"start":511,"end":516,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":587,"end":592,"concept_id":"hemorrhoids","polarity":"therapeutic"},{"start":596,"end":608,"concept_id":"hemorrhoids","polarity":"therapeutic"},{"start":673,"end":677,"concept_id":"gout","polarity":"therapeutic"},{"start":683,"end":691,"concept_id":"sciatica","polarity":"therapeutic"},{"start":707,"end":745,"concept_id":"scrofula","polarity":"therapeutic"},{"start":758,"end":769,"concept_id":"scrofula","polarity":"therapeutic"},{"start":943,"end":949,"concept_id":"wounds","polarity":"therapeutic"},{"start":953,"end":967,"concept_id":"hemorrhage","polarity":"therapeutic"}]}},"gloss":{"dsc:4.91":{"265":"inflammations (φλεγμοναί)","282":"erysipelas","311":"scrofulous glands (χοιράδες)","335":"benefits / braces the stomach","402":"breaks up stones (λίθους θρύπτει)","421":"moves the urine","436":"dropsy (ὕδρωψ, ὑδρωπικοί)"},"cul:169-kidneywort-or-wall-pennyroyal-or-wall-pe":{"111":"inflammations","156":"faintings, fainting spirits","165":"weak / cold / hot stomach (dyspepsia)","180":"hot / cold / hard liver (Galenic distemper of the liver)","276":"pimples","289":"St. Anthony's fire: erysipelas","373":"kidneys","405":"the stone (urinary calculus)","443":"provokes urine: diuretic","480":"dropsy, dropsies","511":"the stone (urinary calculus)","587":"piles: haemorrhoids","596":"haemorrhoids (hæmorrhoids, morrhoids)","673":"gout","683":"sciatica","707":"kernels in / of the throat, neck or ears: swollen glands","758":"king's evil: scrofula","943":"wounds (green, fresh, inward, old); wound-herb","953":"stays / stanches blood"}},"images":[]}