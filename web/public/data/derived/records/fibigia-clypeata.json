{"slug":"fibigia-clypeata","plant":{"taxon":"Fibigia clypeata","family":"Brassicaceae","rank":"species","gbif_key":3051652,"wikidata":"Q5446398","iucn":null,"gbif_occurrences":3536,"common_name":"alysson","names":[{"source":"dioscorides","name":"ἄλυσσον","monograph_id":"dsc:3.91","confidence":"low","note":"Double shield-like silicles; Sprengel/Fraas Farsetia clypeata (= Fibigia clypeata)."}],"n_compounds":5,"top_compounds":[{"name":"4-Pentenylglucosinolate","qid":"Q76403354"},{"name":"2-Hydroxy-3-butenyl glucosinolate","qid":"Q104253326"},{"name":"[(2R,3S,4S,5S,6S)-3,4,5-trihydroxy-6-(hydroxymethyl)oxan-2-yl] (1Z)-5-methylsulfanyl-N-sulfooxypentanimidothioate","qid":"Q105010335"},{"name":"[3,4,5-trihydroxy-6-(hydroxymethyl)oxan-2-yl] N-sulfooxybut-3-enimidothioate","qid":"Q105209351"},{"name":"[3,4,5-trihydroxy-6-(hydroxymethyl)oxan-2-yl] N-sulfooxypent-4-enimidothioate","qid":"Q105211319"}],"epmc_total":4,"trials":0,"claims":[{"concept_id":"hiccup","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"rabies","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"skin_blemishes","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":2.99,"evidence_tier":"sparse"}],"lead_score":null},"texts":{"dsc:3.91":{"ref":"De materia medica 3.91","headword":"ἄλυσσον","lang":"grc","source":"dioscorides","text":"ἄλυσσον· φρυγάνιόν ἐστιν ὑπότραχυ, μονόκαυλον, φύλλα ἔχον στρογγύλα, παῤ οἷς ὁ καρπὸς ὡς ἀσπιδίσκια διπλᾶ, ἐν οἷς τὸ σπέρμα ὑπόπλατυ φύεται ἐν ὀρεινοῖς καὶ τραχέσι χωρίοις. ταύτης τὸ ἀφέψημα ποθὲν λυγμοὺς τοὺς δίχα πυρετοῦ λύει· καὶ κρατηθὲν δὲ ἢ ὀφθὲν τὸ αὐτὸ δρᾷ. σὺν μέλιτι δὲ λεῖον φακοὺς καὶ ἔφηλιν ἀποκαθαίρει. δοκεῖ δὲ καὶ λύσσαν κυνὸς ἰᾶσθαι συγκοπὲν ἐδέσματι καὶ δοθέν· καὶ κρεμάμενον δὲ ἐν οἰκίᾳ ὑγιεινὸν λέγεται εἶναι ἀνθρώποις καὶ ζῴοις. περιαφθὲν δὲ φοινικῷ ῥάκει θρεμμάτων νόσους παύει.","spans":[{"start":197,"end":201,"concept_id":"hiccup","polarity":"therapeutic"},{"start":286,"end":292,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":297,"end":301,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":330,"end":334,"concept_id":"rabies","polarity":"therapeutic"}]}},"images":[]}