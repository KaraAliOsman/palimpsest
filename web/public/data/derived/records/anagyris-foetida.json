ακροῖς, τὸ σχῆμα νεφρῶν, ποικίλος, στερεός· σκληρύνεται δὲ περὶ τὸν τῆς σταφυλῆς πεπασμόν. ταύτης τά φύλλα ἁπαλὰ καταπλασσόμενα λεῖα οἰδήματα στέλλει· ποτίζεται δὲ δραχμῆς μιᾶς πλῆθος ἐν γλυκεῖ πρὸς ἆσθμα καὶ ἐκβολὴν χορίου καὶ ἐμβρύου καὶ ἐμμήνων, πρὸς δὲ φαλαγγίων πληγάς σύν οἴνῳ. ἐστι δὲ καὶ περίαπτον δυστοκούσαις· δεῖ μέντοι μετὰ τὸ τεκεῖν εὐθέως ἀφελόντα ῥίπτειν τὸ περίαμμα. τῆς δὲ ῥίζης ὁ φλοιὸς διαφορεῖ καὶ ἐκπέσσει· ὁ δὲ καρπὸς ἐσθιόμενος ἔμετον συντόνως κινεῖ.","spans":[{"start":197,"end":203,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":313,"end":318,"concept_id":"inflammation","polarity":"therapeutic"},{"start":379,"end":383,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":389,"end":427,"concept_id":"amenorrhea","polarity":"action"},{"start":437,"end":451,"concept_id":"envenomation","polarity":"therapeutic"},{"start":486,"end":492,"concept_id":"labor","polarity":"therapeutic"},{"start":631,"end":650,"concept_id":"nausea_vomiting","polarity":"action"}]}},"images":[]}