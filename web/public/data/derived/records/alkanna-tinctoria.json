ir":1,"lift":0.61,"evidence_tier":"sparse"},{"concept_id":"scaly_skin","dsc":1,"cul":1,"persistent":true,"epmc_pair":11,"lift":12.07,"evidence_tier":"studied"},{"concept_id":"skin_ulcers","dsc":1,"cul":1,"persistent":true,"epmc_pair":2,"lift":3.83,"evidence_tier":"sparse"},{"concept_id":"spleen_disease","dsc":1,"cul":1,"persistent":true,"epmc_pair":0,"lift":0.29,"evidence_tier":"unstudied"},{"concept_id":"envenomation","dsc":0,"cul":2,"persistent":false,"epmc_pair":0,"lift":0.88,"evidence_tier":"unstudied"},{"concept_id":"wounds","dsc":0,"cul":2,"persistent":false,"epmc_pair":20,"lift":9.41,"evidence_tier":"studied"},{"concept_id":"abortifacient","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.49,"evidence_tier":"unstudied"},{"concept_id":"bruises","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.56,"evidence_tier":"unstudied"},{"concept_id":"helminthiasis","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":1.59,"evidence_tier":"sparse"},{"concept_id":"inflammation","dsc":0,"cul":1,"persistent":false,"epmc_pair":18,"lift":3.25,"evidence_tier":"studied"},{"concept_id":"labor","dsc":0,"cul":1,"persistent":false,"epmc_pair":3,"lift":3.1,"evidence_tier":"sparse"},{"concept_id":"skin_blemishes","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":2.52,"evidence_tier":"sparse"},{"concept_id":"urolithiasis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.77,"evidence_tier":"unstudied"},{"concept_id":"uterine_disorders","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.24,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:4.23":{"ref":"De materia medica 4.23","headword":"ἄγχουσα","lang":"grc","source":"dioscorides","text":"ἄγχουσα· ἣν ἔνιοι κάλυκα, οἱ δὲ ὀνοκλείαν καλοῦσι. φύλλα θρίδακι τῇ ὀξυφύλλῳ παραπλήσια, δασέα, τραχέα, μέλανα, πολλά, πανταχόθεν τῆς ῥίζης προσπεπλασμένα τῇ γῇ, ἀκανθώδη· ἡ δὲ ῥίζα δακτύλου πάχος, τὴν χρόαν ὕφαιμος ἐν τῳ θέρει γινομένη καὶ βάπτουσα τὰς χεῖρας· φύεται ἐν εὐγείοις τόποις. ἐστι δὲ ἡ ῥίζα στυπτική, ποιοῦσα πρὸς κατακαύματα καὶ παλαιὰ ἕλκη ἐναφεψομένη κηρῷ καὶ ἐλαίῳ· ἐρυσιπέλατα δὲ σὺν ἀλφίτῳ καταπλασθεῖσα θεραπεύει, καὶ ἀλφοὺς καὶ λέπρας σὺν ὄξει καταπλασσομένη, προστιθεμένη δὲ καὶ ἔμβρυα κατασπᾷ· τὸ δὲ ἀφέψημα αὐτῆς δίδοται καὶ ἰκτερικοῖς, νεφριτικοῖς, σπληνικοῖς πυρέσσουσι μετὰ μελικράτου, ἀπυρέτοις δὲ μετʼ οἴνου. τὰ δὲ φύλλα κοιλίαν ἵστησι μετʼ οἴνου πινόμενα. χρῶνται δὲ καὶ οἱ μυρεψοὶ τῇ δίζῃ πρὸς τάς στύψεις τῶν μύρων.","spans":[{"start":327,"end":335,"concept_id":"burns","polarity":"therapeutic"},{"start":350,"end":354,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":383,"end":391,"concept_id":"erysipelas","polarity":"therapeutic"},{"start":438,"end":444,"concept_id":"scaly_skin","polarity":"therapeutic"},{"start":449,"end":453,"concept_id":"scaly_skin","polarity":"therapeutic"},{"start":501,"end":515,"concept_id":"abortifacient","polarity":"action"},{"start":549,"end":554,"concept_id":"jaundice","polarity":"therapeutic"},{"start":561,"end":572,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":574,"end":584,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":650,"end":664,"concept_id":"diarrhea","polarity":"therapeutic"}]},"cul:003-alkanet":{"ref":"Culpeper, Complete Herbal: Alkanet","headword":"Alkanet","lang":"en","source":"culpeper","text":"It is an herb under the dominion of Venus, and indeed one of her darlings, though somewhat hard to come by. It helps old ulcers, hot inflammations, burnings by common fire, and St. Anthony’s fire, by antipathy to Mars; for these uses, your best way is to make it into an ointment; also, if you make a vinegar of it, as you make vinegar of roses, it helps the morphew and leprosy; if you apply the herb to the privities, it draws forth the dead child. It helps the yellow jaundice, spleen, and gravel in the kidneys. Dioscorides saith it helps such as are bitten by a venomous beast, whether it be taken inwardly, or applied to the wound; nay, he saith further, if any one that hath newly eaten it, do but spit into the mouth of a serpent, the serpent instantly dies. It stays the flux of the belly, kills worms, helps the fits of the mother. Its decoction made in wine, and drank, strengthens the back, and eases the pains thereof: It helps bruises and falls, and is as gallant a remedy to drive out the small pox and measles as any is; an ointment made of it, is excellent for green wounds, pricks or thrusts.","spans":[{"start":121,"end":127,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":133,"end":146,"concept_id":"inflammation","polarity":"therapeutic"},{"start":148,"end":156,"concept_id":"burns","polarity":"therapeutic"},{"start":181,"end":195,"concept_id":"erysipelas","polarity":"therapeutic"},{"start":359,"end":366,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":371,"end":378,"concept_id":"scaly_skin","polarity":"therapeutic"},{"start":439,"end":449,"concept_id":"labor","polarity":"therapeutic"},{"start":471,"end":479,"concept_id":"jaundice","polarity":"therapeutic"},{"start":481,"end":487,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":493,"end":499,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":507,"end":514,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":555,"end":561,"concept_id":"envenomation","polarity":"therapeutic"},{"start":567,"end":575,"concept_id":"envenomation","polarity":"therapeutic"},{"start":631,"end":636,"concept_id":"wounds","polarity":"therapeutic"},{"start":730,"end":737,"concept_id":"envenomation","polarity":"therapeutic"},{"start":743,"end":750,"concept_id":"envenomation","polarity":"therapeutic"},{"start":780,"end":797,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":805,"end":810,"concept_id":"helminthiasis","polarity":"therapeutic"},{"start":830,"end":840,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":941,"end":948,"concept_id":"bruises","polarity":"therapeutic"},{"start":1084,"end":1090,"concept_id":"wounds","polarity":"therapeutic"}]}},"gloss":{"dsc:4.23":{"327":"burns (κατακαύματα)","350":"ulcers (ἕλκη, ἑλκώσεις)","383":"erysipelas","438":"alphos (white scaly patches)","449":"lepra (scaly skin)","501":"expels / destroys the embryo","549":"jaundice (ἴκτερος, ἰκτερικοί)","561":"kidneys / nephritics (νεφριτικοί)","574":"the spleen / spleen patients (σπληνικοί)","650":"binds / checks the bowels"},"cul:003-alkanet":{"121":"ulcers (old, foul, running, fretting)","133":"inflammations","148":"burnings","181":"St. Anthony's fire: erysipelas","359":"morphew: scurfy, discoloured skin","371":"leprosy (lepra)","439":"expels the dead child / dead birth","471":"yellow jaundice, black jaundice","481":"spleen: hardness, swelling, stoppings of the spleen","493":"gravel: small urinary concretions","507":"kidneys","555":"bitten or stung","567":"venomous beasts / creatures","631":"wounds (green, fresh, inward, old); wound-herb","730":"serpents, vipers, adders, scorpions, wasps","743":"serpents, vipers, adders, scorpions, wasps","780":"flux of the belly: diarrhoea","805":"worms (intestinal)","830":"the mother: the womb (fits, rising, suffocation, pains of the mother)","941":"bruises","1084":"wounds (green, fresh, inward, old); wound-herb"}},"images":["anchusa-wiener-dioskurides"]}