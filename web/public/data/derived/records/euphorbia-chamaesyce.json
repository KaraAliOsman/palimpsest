{"slug":"euphorbia-chamaesyce","plant":{"taxon":"Euphorbia chamaesyce","family":"Euphorbiaceae","rank":"species","gbif_key":3067869,"wikidata":"Q5410411","iucn":null,"gbif_occurrences":5855,"common_name":"prostrate spurge","names":[{"source":"dioscorides","name":"χαμαισύκη","monograph_id":"dsc:4.169","confidence":"medium","note":"Milky prostrate branches with lentil-like leaves; Berendes: Erdfeige."}],"n_compounds":32,"top_compounds":[{"name":"beta-sitosterol","qid":"Q121802"},{"name":"gallic acid","qid":"Q375837"},{"name":"kaempferol","qid":"Q393336"},{"name":"rutin","qid":"Q407857"},{"name":"lupeol","qid":"Q409366"},{"name":"quercetin","qid":"Q409478"},{"name":"ellagic acid","qid":"Q422044"},{"name":"1,2,6-Trigalloyl glucose","qid":"Q4545648"}],"epmc_total":6,"trials":0,"claims":[{"concept_id":"envenomation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"eye_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.88,"evidence_tier":"unstudied"},{"concept_id":"inflammation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.76,"evidence_tier":"unstudied"},{"concept_id":"pain","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.78,"evidence_tier":"unstudied"},{"concept_id":"uterine_disorders","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.91,"evidence_tier":"unstudied"},{"concept_id":"warts","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.98,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:4.169":{"ref":"De materia medica 4.169","headword":"χαμαισύκη","lang":"grc","source":"dioscorides","text":"χαμαισύκη, οἱ δὲ συκῆν· κλῶνας ἀνίησι τετραδακτύλους, ἐπὶ γῆς ἐρριμμένους περιφερῶς, ἀποῦ μεστούς, φύλλα φακοειδῆ, τῷ πέπλῳ ὅμοια, μικρά, λεπτά, πρὸς τῇ γῇ· καρπὸς δὲ ὑπὸ τοῖς φύλλοις στρογγύλος, ὡς πέπλου· οὔτε δὲ ἄνθος οὔτε καυλὸν ἔχει, ῥίζαν δὲ λεπτήν, αχρξστον. δύναμιν δὲ ἔχουσιν οἱ κλῶνες, λεανθέντες σὺν οἴνῳ τὰς περὶ μήτραν ὀδύνας παύειν ἀντὶ πεσσοῦ προστεθέντες, καταπλασσόμνοι δὲ οἰδήματα καὶ ἀκροχορδόνας καὶ μυρμηκίας αἴρουσιν, ἑφθοὶ δὲ ἐσθιόμενοι κοιλίαν ἐκλύουσι. καὶ ὁ ἐξ αὐτῶν δὲ ὀπὸς τὰ αὐτὰ δρᾷ, καὶ καταχριόμενος σκορπιοπλήκτοις βοηθεῖ, ἁρμόζει δὲ καὶ πρὸς ἀμβλυωπίας καὶ ἀχλῦς καὶ ἀρχομένας ὑποχύσεις, οὐλάς, νεφέλια σὺν μέλιτι ἐγχριόμενος. φύεται ἐν πετρώδεσι καὶ αὐχμηροῖς τόποις.","spans":[{"start":325,"end":331,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":332,"end":338,"concept_id":"pain","polarity":"therapeutic"},{"start":390,"end":395,"concept_id":"inflammation","polarity":"therapeutic"},{"start":403,"end":411,"concept_id":"warts","polarity":"therapeutic"},{"start":420,"end":427,"concept_id":"warts","polarity":"therapeutic"},{"start":532,"end":544,"concept_id":"envenomation","polarity":"therapeutic"},{"start":576,"end":583,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":591,"end":595,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":611,"end":616,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":629,"end":635,"concept_id":"eye_disease","polarity":"therapeutic"}]}},"images":[]}