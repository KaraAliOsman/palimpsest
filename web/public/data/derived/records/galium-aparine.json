ul":1,"persistent":false,"epmc_pair":1,"lift":1.6,"evidence_tier":"sparse"},{"concept_id":"liver_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":0.49,"evidence_tier":"sparse"},{"concept_id":"poisoning","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.36,"evidence_tier":"unstudied"},{"concept_id":"scrofula","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.72,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.74,"evidence_tier":"unstudied"},{"concept_id":"sore_throat","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.78,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:3.90":{"ref":"De materia medica 3.90","headword":"ἀπαρίνη","lang":"grc","source":"dioscorides","text":"ἀπαρίνη· οἱ δὲ ἀμπελόκαρπον, οἱ δὲ ὀμφαλόκαρπον καλοῦσιν, οἱ δὲ φιλάνθρωπον. κλῶνες πολλοί, μακροί, τετράγωνοι, τραχεῖς· φύλλα δὲ ἐκ διαστήματος περικείμενα κυκλοτερῶς ὥσπερ τὰ τοῦ ἐρυθροδάνου, ἄνθη λευκά, σπέρμα σκληρόν, στρογγύλον, ὑπόκοιλον ἐκ μέσου ὡς ὀμφαλός· προσέχεται δὲ καὶ ἱματίοις ἡ πόα. χρῶνται δ᾿ αὐτῇ καὶ οἱ ποιμένες ἀντὶ ἠθμοῦ ἐπὶ τοῦ γάλακτος πρὸς ἔκληψιν τῶν ἐν αὐτῷ τριχῶν. ταύτης τὸ σπέρμα καὶ οἱ καυλοὶ καὶ τὰ φύλλα χυλισθέντα φαλαγγιοδήκτοις καὶ ἐχιοδήκτοις βοηθεῖ μετ᾿ οἴνου πινόμενα, καὶ ὠταλγίας ἰᾶται ὁ χυλὸς ἐγχυματιζόμενος. ἡ δὲ πόα ἀναληφθεῖσα ὀξυγγίῳ διαφορεῖ χοιράδας.","spans":[{"start":447,"end":459,"concept_id":"envenomation","polarity":"therapeutic"},{"start":467,"end":475,"concept_id":"envenomation","polarity":"therapeutic"},{"start":511,"end":516,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":589,"end":595,"concept_id":"scrofula","polarity":"therapeutic"}]},"cul:081-cleavers":{"ref":"Culpeper, Complete Herbal: Cleavers","headword":"Cleavers","lang":"en","source":"culpeper","text":"It is under the dominion of the Moon. The juice of the herb and the seed together taken in wine, helps those bitten with an adder, by preserving the heart from the venom. It is familiarly taken in broth to keep them lean and lank, that are apt to grow fat. The distilled water drank twice a day, helps the yellow jaundice, and the decoction of the herb, in experience, is found to do the same, and stays lasks and bloody-fluxes. The juice of the leaves, or they a little bruised, and applied to any bleeding wounds, stays the bleeding. The juice also is very good to close up the lips of green wounds, and the powder of the dried herb strewed thereupon doth the same, and likewise helps old ulcers. Being boiled in hog’s grease, it helps all sorts of hard swellings or kernels in the throat, being anointed therewith. The juice dropped into the ears, takes away the pain of them. It is a good remedy in the Spring, eaten (being first chopped small, and boiled well) in water-gruel, to cleanse the blood, and strengthen the liver, thereby to keep the body in health, and fitting it for that change of season that is coming.","spans":[{"start":109,"end":115,"concept_id":"envenomation","polarity":"therapeutic"},{"start":124,"end":129,"concept_id":"envenomation","polarity":"therapeutic"},{"start":134,"end":154,"concept_id":"heart","polarity":"therapeutic"},{"start":164,"end":169,"concept_id":"poisoning","polarity":"therapeutic"},{"start":313,"end":321,"concept_id":"jaundice","polarity":"therapeutic"},{"start":404,"end":409,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":414,"end":427,"concept_id":"dysentery","polarity":"therapeutic"},{"start":499,"end":507,"concept_id":"hemorrhage","polarity":"therapeutic"},{"start":508,"end":514,"concept_id":"wounds","polarity":"therapeutic"},{"start":526,"end":534,"concept_id":"hemorrhage","polarity":"therapeutic"},{"start":567,"end":584,"concept_id":"wounds","polarity":"therapeutic"},{"start":594,"end":600,"concept_id":"wounds","polarity":"therapeutic"},{"start":691,"end":697,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":751,"end":765,"concept_id":"cancer","polarity":"therapeutic"},{"start":756,"end":790,"concept_id":"sore_throat","polarity":"therapeutic"},{"start":836,"end":870,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":1008,"end":1028,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":1041,"end":1054,"concept_id":"constipation","polarity":"action"}]}},"images":[]}