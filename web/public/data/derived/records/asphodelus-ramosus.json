ft":0.99,"evidence_tier":"unstudied"},{"concept_id":"eye_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.77,"evidence_tier":"unstudied"},{"concept_id":"inflammation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.6,"evidence_tier":"unstudied"},{"concept_id":"pleurisy_pneumonia","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.86,"evidence_tier":"unstudied"},{"concept_id":"poisoning","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.91,"evidence_tier":"unstudied"},{"concept_id":"scaly_skin","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.94,"evidence_tier":"unstudied"},{"concept_id":"toothache","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.96,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:2.169":{"ref":"De materia medica 2.169","headword":"ἀσφόδελος","lang":"grc","source":"dioscorides","text":"ἀσφόδελος· φυτὸν τοῖς πλείστοις γνώριμον, φύλλον ἔχον πράσῳ μεγάλῳ ἐοικός, καυλὸν δὲ λεῖον, ἔχοντα ἐπ ἄκρου ἄνθος, καλούμενον ἀνθερικόν. ῥίζαι δὲ ὕπεισιν ἐπιμήκεις, στρογγύλαι, βαλάνοις ὅμοιαι, δριμεῖαι τὴν γεῦσιν, καὶ τὴν δύναμιν θερμαντικαί. κινοῦσι δὲ καὶ οὔρησιν καὶ ἔμμηνα ποθεῖσαι, ἰῶνται καὶ πλευρᾶς ἀλγήματα καὶ βῆχας καὶ σπάσματα καὶ δήγματα δραχμῆς μιᾶς τὸ πλῆθος τῆς ῥίζης ἐν οἴνῳ πινομένης. ποιεῖ δὲ καὶ εὐημεστέρους ὅσον ἀστράγαλος βρωθεῖσα, καὶ ἑρπετοδήκτοις 2 δίδοται ὠφελίμως ὅσον δραχμῶν τριῶν τὸ πλῆθος· καὶ καταπλάττειν δὲ δεῖ τὰ δήγματα τοῖς τε φύλλοις καὶ τῇ ῥίζῃ καὶ τοῖς ἄνθεσι σὺν οἴνῳ, καὶ τὰ ῥυπαρὰ καὶ νεμόμενα ἕλκη καὶ μαστῶν καὶ διδύμων φλεγμονὰς καὶ φύματα καὶ δοθιῆνας, συγκαθεψομένης τρυγὸς οἴνου τῇ ῥίζῃ, πρὸς δὲ τὰς προσφάτους φλεγμονὰς μετ᾿ ἀλφίτου. ὁ δὲ χυλὸς τῆς ῥίζης προσλαβὼν οἴνου παλαιοῦ γλυκέος καὶ σμύρνης καὶ κρόκου συνεψηθέντων ἐπὶ τὸ αὐτὸ ἔγχριστον γίνεται ὀφθαλμοῖς φάρμακον, καὶ πρὸς ὦτα πυορροοῦντα καθ᾿ ἑαυτὸν καὶ σὺν λιβανωτῷ καὶ μέλιτι καὶ οἴνῳ καὶ σμύρνῃ χλιανθεὶς ἁρμόζει, ὀδονταλγίας τε καθ᾿ ἑαυτὸν ἐγχυθεὶς ὁ χυλὸς τῷ ἀντικειμένῳ ὠτίῳ πραύνει. 3 καεῖσα δὲ ἡ ῥίζα, τῆς τέφρας ἐπιπλασσομένης, ἀλωπεκίας δασύνει, ἐνεψηθὲν δὲ ἔλαιον κεκοιλωμέναις ταῖς ῥίζαις ἐπὶ πυρὸς εἱλκωμένας χιμέτλας καὶ πυρίκαυτα ὑπαλειφόμενον ὠφελεῖ, καὶ ὠταλγιῶσι βοηθεῖ ἐγχεόμενον εἰς τὸ οὖς, ἀλφόν τε λευκὸν προανατριφθέντα ἐν ὀθονίῳ ἐν ἡλίῳ καταχρισθεῖσα ἡ ῥίζα σμήχει. ὁ δὲ καρπὸς καὶ τὰ ἄνθη κατ᾿ ἐξοχὴν σκολοπένδρων καὶ σκορπίων ἀντιφάρμακόν ἐστιν ἐν οἴνῳ ποθέντα· ταράττει δὲ καὶ τὴν κοιλίαν.","spans":[{"start":244,"end":277,"concept_id":"amenorrhea","polarity":"action"},{"start":299,"end":310,"concept_id":"pleurisy_pneumonia","polarity":"therapeutic"},{"start":320,"end":323,"concept_id":"cough","polarity":"therapeutic"},{"start":330,"end":337,"concept_id":"convulsions","polarity":"therapeutic"},{"start":459,"end":469,"concept_id":"envenomation","polarity":"therapeutic"},{"start":638,"end":642,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":666,"end":673,"concept_id":"inflammation","polarity":"therapeutic"},{"start":680,"end":686,"concept_id":"abscess","polarity":"therapeutic"},{"start":691,"end":697,"concept_id":"abscess","polarity":"therapeutic"},{"start":761,"end":768,"concept_id":"inflammation","polarity":"therapeutic"},{"start":904,"end":910,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":933,"end":936,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":1028,"end":1036,"concept_id":"toothache","polarity":"therapeutic"},{"start":1148,"end":1155,"concept_id":"alopecia","polarity":"therapeutic"},{"start":1222,"end":1232,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":1246,"end":1253,"concept_id":"burns","polarity":"therapeutic"},{"start":1282,"end":1287,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":1322,"end":1327,"concept_id":"scaly_skin","polarity":"therapeutic"},{"start":1463,"end":1473,"concept_id":"poisoning","polarity":"therapeutic"}]}},"images":[]}