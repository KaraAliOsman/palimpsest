{"slug":"centaurea-calcitrapa","plant":{"taxon":"Centaurea calcitrapa","family":"Asteraceae","rank":"species","gbif_key":3128483,"wikidata":"Q1763537","iucn":null,"gbif_occurrences":29961,"common_name":"red star-thistle","names":[{"source":"culpeper","name":"Star Thistle","monograph_id":"cul:290-star-thistle","confidence":"high","note":"Star thistle with spreading branches."}],"n_compounds":28,"top_compounds":[{"name":"vanillin","qid":"Q33495"},{"name":"squalene","qid":"Q407560"},{"name":"rutin","qid":"Q407857"},{"name":"quercetin","qid":"Q409478"},{"name":"linalool","qid":"Q410932"},{"name":"phytol","qid":"Q415945"},{"name":"apigenin","qid":"Q424567"},{"name":"stigmasterol","qid":"Q425004"}],"epmc_total":29,"trials":0,"claims":[{"concept_id":"diuresis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.92,"evidence_tier":"unstudied"},{"concept_id":"fever","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.72,"evidence_tier":"unstudied"},{"concept_id":"liver_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.6,"evidence_tier":"unstudied"},{"concept_id":"malaria","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":2.53,"evidence_tier":"sparse"},{"concept_id":"plague","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.83,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.96,"evidence_tier":"unstudied"},{"concept_id":"syphilis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.94,"evidence_tier":"unstudied"},{"concept_id":"urolithiasis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.96,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"cul:290-star-thistle":{"ref":"Culpeper, Complete Herbal: Star Thistle","headword":"Star Thistle","lang":"en","source":"culpeper","text":"This, as almost all Thistles are, is under Mars. The seed of this Star Thistle made into powder, and drank in wine, provokes urine, and helps to break the stone, and drives it forth. The root in powder, and given in wine and drank, is good against the plague and pestilence; and drank in the morning fasting for some time together, it is very profitable for fistulas in any part of the body. Baptista Sardas doth much commend the distilled water thereof, being drank, to help the French disease, to open the obstructions of the liver, and cleanse the blood from corrupted humours, and is profitable against the quotidian or tertian ague.","spans":[{"start":116,"end":130,"concept_id":"diuresis","polarity":"action"},{"start":155,"end":160,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":252,"end":258,"concept_id":"plague","polarity":"therapeutic"},{"start":263,"end":273,"concept_id":"plague","polarity":"therapeutic"},{"start":358,"end":366,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":480,"end":494,"concept_id":"syphilis","polarity":"therapeutic"},{"start":508,"end":533,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":611,"end":620,"concept_id":"fever","polarity":"therapeutic"},{"start":624,"end":631,"concept_id":"malaria","polarity":"therapeutic"}]}},"gloss":{"cul:290-star-thistle":{"116":"provokes urine: diuretic","155":"the stone (urinary calculus)","252":"plague","263":"pestilence, pestilential fevers / sores","358":"fistula, fistulous ulcers","480":"French disease: syphilis","508":"obstructions / heat of the liver","611":"quotidian ague (daily fever)","624":"tertian ague (fever every third day)"}},"images":[]}