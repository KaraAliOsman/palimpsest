{"slug":"thalictrum-flavum","plant":{"taxon":"Thalictrum flavum","family":"Ranunculaceae","rank":"species","gbif_key":7509607,"wikidata":"Q162764","iucn":null,"gbif_occurrences":133176,"common_name":"common meadow-rue","names":[{"source":"culpeper","name":"Meadow-Rue","monograph_id":"cul:260-meadow-rue","confidence":"high","note":"Yellow stringy creeping root, divided leaves: meadow rue."}],"n_compounds":53,"top_compounds":[{"name":"tyramine","qid":"Q165930"},{"name":"dopamine","qid":"Q170304"},{"name":"berberine","qid":"Q176525"},{"name":"protopine","qid":"Q390706"},{"name":"protoanemonin","qid":"Q421294"},{"name":"chelidonine","qid":"Q1069066"},{"name":"cryptopine","qid":"Q1142307"},{"name":"glaucine","qid":"Q2398298"}],"epmc_total":31,"trials":0,"claims":[{"concept_id":"constipation","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.94,"evidence_tier":"unstudied"},{"concept_id":"jaundice","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.89,"evidence_tier":"unstudied"},{"concept_id":"lice","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.96,"evidence_tier":"unstudied"},{"concept_id":"plague","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.82,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.95,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"cul:260-meadow-rue":{"ref":"Culpeper, Complete Herbal: Meadow-Rue","headword":"Meadow-Rue","lang":"en","source":"culpeper","text":"Dioscorides saith, That this herb bruised and applied, perfectly heals old sores, and the distilled water of the herb and flowers doth the like. It is used by some among other pot-herbs to open the body, and make it soluble; but the roots washed clean, and boiled in ale and drank, provokes to stool more than the leaves, but yet very gently. The root boiled in water, and the places of the body most troubled with vermin and lice washed therewith while it is warm, destroys them utterly. In Italy it is good against the plague, and in Saxony against the jaundice, as _Camerarius_ saith.","spans":[{"start":75,"end":80,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":189,"end":202,"concept_id":"constipation","polarity":"action"},{"start":415,"end":421,"concept_id":"lice","polarity":"therapeutic"},{"start":426,"end":430,"concept_id":"lice","polarity":"therapeutic"},{"start":521,"end":527,"concept_id":"plague","polarity":"therapeutic"},{"start":555,"end":563,"concept_id":"jaundice","polarity":"therapeutic"}]}},"images":[]}