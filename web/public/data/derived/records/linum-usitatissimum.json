 σὺν μέλιτι καὶ ἐλαίῳ καὶ ὕδατι ὠμὸν ἀναλημφθέν. αἴρει δὲ καὶ ἐφήλεις καὶ ἰόνθους καταπλασθὲν σὺν νίτρῳ καὶ σύκῳ, σύν κονίᾳ δὲ παρωτίδας καὶ σκληρίας διαφορεῖ, ἕρπητάς τε σὺν οἴνῳ ἑψηθὲν καὶ κηρία ἐκκαθαίρει, ὄνυχάς τε λεπρούς ἀφίστησι σὺν ἴσῳ καρδάμῳ καὶ μέλιτι· ἀνάγει καὶ τὰ ἐκ θώρακος σὺν μέλιτι ἀντὶ ἐκλεικτοῦ λημφθὲν καὶ βῆχας παρηγορεῖ, παρίστησι δὲ καὶ πρὸς ἀφροδίσια μιγὲν μέλιτι καὶ πεπέρει ἀντὶ κοπτῆς πολὺ λαμβανόμενον· καὶ τὸ ἀφέψημα δὲ αὐτοῦ ἐνίεται πρὸς ἐντέρων καὶ ὑστέρας δηγμούς καὶ ἐκκομιδὴν περιττωμάτων, καὶ πρὸς φλεγμονάς τὰς ἐν μήτρᾳ εἰς ἐγκάθισμα, ὥσπερ τὸ τῆς τήλεως, εὐχρηστεῖ.","spans":[{"start":81,"end":88,"concept_id":"inflammation","polarity":"therapeutic"},{"start":171,"end":175,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":183,"end":187,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":236,"end":243,"concept_id":"abscess","polarity":"therapeutic"},{"start":269,"end":274,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":300,"end":305,"concept_id":"abscess","polarity":"therapeutic"},{"start":328,"end":332,"concept_id":"scaly_skin","polarity":"therapeutic"},{"start":373,"end":395,"concept_id":"cough","polarity":"action"},{"start":436,"end":439,"concept_id":"cough","polarity":"therapeutic"},{"start":475,"end":483,"concept_id":"sexual_function","polarity":"action"},{"start":590,"end":597,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":643,"end":650,"concept_id":"inflammation","polarity":"therapeutic"},{"start":660,"end":665,"concept_id":"uterine_disorders","polarity":"therapeutic"}]}},"images":[]}