:false,"epmc_pair":0,"lift":0.65,"evidence_tier":"unstudied"},{"concept_id":"flatulence","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.98,"evidence_tier":"unstudied"},{"concept_id":"hemoptysis","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.97,"evidence_tier":"unstudied"},{"concept_id":"hemorrhage","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.49,"evidence_tier":"unstudied"},{"concept_id":"jaundice","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.87,"evidence_tier":"unstudied"},{"concept_id":"joint_pain","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":1.69,"evidence_tier":"sparse"},{"concept_id":"kidney_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.56,"evidence_tier":"unstudied"},{"concept_id":"liver_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.52,"evidence_tier":"unstudied"},{"concept_id":"poisoning","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.76,"evidence_tier":"unstudied"},{"concept_id":"sciatica","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.93,"evidence_tier":"unstudied"},{"concept_id":"spleen_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.68,"evidence_tier":"unstudied"},{"concept_id":"tuberculosis","dsc":1,"cul":0,"persistent":false,"epmc_pair":2,"lift":3.2,"evidence_tier":"sparse"}],"lead_score":null},"texts":{"dsc:3.1":{"ref":"De materia medica 3.1","headword":"ἀγαρικόν","lang":"grc","source":"dioscorides","text":"ἀγαρικόν· ῥίζα φέρεται σιλφίῳ ἐμφερής, οὐ πυκνὴ τὴν ἐπιφάνειαν ὥσπερ τὸ σίλφιον, ἀραιὰ δέ ἐστιν ὅλη. ἐστι δὲ αὐτοῦ τὸ μὲν ἄρρεν τὸ δὲ θῆλυ, ὧν διαφέρει τὸ θῆλυ ἔχον κτηδόνας εὐθείας ἐντός, τὸ δὲ ἄρρεν περιφερές τέ ἐστι καὶ πανταχόθεν συμφυές· γεύσει δὲ ἀμφότερα ὁμοια, κατʼ ἀρχὰς μὲν γλυκάζοντα, εἶτα ἐξ ἀναδόσεως ἔμπικρα. γεννᾶται δὲ ἐν τῇ Ἀγαρίᾳ τῆς Σαρματικῆς· λέγουσι δὲ οἱ μὲν φυτοῦ ῥίζαν εἶναι, τινὲς δὲ ἐν φηγίνοις δένδρεσι κατὰ σῆψιν γίνεσθαι, καθάπερ καὶ οἱ μύκητες ἐπιφύονται. γεννᾶται δὲ καὶ ἐν τῇ κατὰ Ἀσίαν Γαλατίᾳ καὶ Κιλικίᾳ ἐπὶ τῶν κέδρων, εὔθρυπτον μέντοι καὶ ἀσθενὲς τῇ δυνάμει. ἐστι δὲ στυπτικόν, θερμαντικόν, ποιοῦν πρός τε στρόφους καὶ ὠμότητας, ῥήγματά τε καὶ πτώματα, ὀβολῶν δυεῖν πλῆθος μετὰ οἰνομέλιτος διδόμενον ἀπυρέτοις, πυρέσσουσι δὲ ἐν μελικράτῳ· καὶ ἡπατικοῖς δὲ καὶ ἀσθματικοῖς καὶ δυσουροῦσι καὶ νεφριτικοῖς καὶ ἰκτεριώδεσι καὶ ὑστερικαῖς πνιξὶ καὶ κακοχροίαις ὡς δραχμὴ μία διδόμενον, φθισικοῖς δὲ μετὰ γλυκέος, σπληνικοῖς δὲ μετʼ ὀξυμέλιτος, στομαχικοῖς δὲ ὡς ἐστι διαμασώμενον καὶ καταπινόμενον μηδενὸς ὑγροῦ ἐπιρροφουμένου, ὁμοίως δὲ ὀξυρεγμιῶσιν. ἵστησι δὲ καὶ αἵματος ἀναγωγάς ὁλκὴ τριωβόλου μεθ᾿ ὕδατος λαμβανόμενον· ποιεῖ καὶ πρὸς ἰσχίων καὶ ἄρθρων ἀλγήματα καὶ ἐπιληψίας μετʼ ὀξυμέλιτος λαμβανομένου τοῦ ἴσου πλήθους. ἄγει δὲ καὶ ἔμμηνα καὶ ταῖς ἐμπνευματουμέναις ὑστέραν γυναιξὶν ὠφελίμως τὸ ἴσον δίδοται. λύει δὲ καὶ ῥῖγος πρὸ τῆς ἐπισημασίας διδόμενον, καθαίρει δὲ καὶ κοιλίαν δραχμὴ μία ἢ δύο μετά μελικράτου πινόμενον. ἐστι δὲ καὶ θανασίμων ἀντίδοτος μετά κράματος δραχμῆς μιᾶς ὁλκὴ λαμβανόμενον, καὶ πρὸς ἑρπετῶν δὲ πληγάς καὶ δήγματα ὁλκὴ τριωβόλου μετʼ οἴνου πινόμενον βοηθεῖ· καὶ καθόλου πρὸς τὰ ἐντὸς πάντα πάθη ἁρμόζει πρὸς δύναμιν καὶ ἡλικίαν διδόμενον, οἷς μὲν μεθʼ ὕδατος, οἷς δὲ μετʼ οἴνου ἢ ὀξυμέλιτος ἢ μελικράτου.","spans":[{"start":644,"end":652,"concept_id":"colic","polarity":"therapeutic"},{"start":667,"end":671,"concept_id":"bruises","polarity":"therapeutic"},{"start":682,"end":687,"concept_id":"bruises","polarity":"therapeutic"},{"start":781,"end":790,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":798,"end":802,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":814,"end":820,"concept_id":"dysuria","polarity":"therapeutic"},{"start":829,"end":840,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":845,"end":850,"concept_id":"jaundice","polarity":"therapeutic"},{"start":861,"end":868,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":919,"end":925,"concept_id":"tuberculosis","p