{"slug":"silene-latifolia","plant":{"taxon":"Silene latifolia","family":"Caryophyllaceae","rank":"species","gbif_key":5384805,"wikidata":"Q27624","iucn":null,"gbif_occurrences":562114,"common_name":"White campion","names":[{"source":"culpeper","name":"Campion, Wild","monograph_id":"cul:062-campion-wild","confidence":"high","note":"Wild white campion described; red wild campion = Silene dioica."}],"n_compounds":4,"top_compounds":[{"name":"veratrole","qid":"Q131994"},{"name":"20-hydroxyecdysone","qid":"Q423338"},{"name":"2-deoxyecdysone","qid":"Q27109207"},{"name":"Silenoside","qid":"Q105365378"}],"epmc_total":403,"trials":0,"claims":[{"concept_id":"constipation","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.55,"evidence_tier":"unstudied"},{"concept_id":"diuresis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.45,"evidence_tier":"unstudied"},{"concept_id":"envenomation","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.79,"evidence_tier":"unstudied"},{"concept_id":"hemorrhage","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.09,"evidence_tier":"unstudied"},{"concept_id":"kidney_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":2,"lift":0.56,"evidence_tier":"sparse"},{"concept_id":"plague","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.26,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.62,"evidence_tier":"unstudied"},{"concept_id":"urolithiasis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.62,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"cul:062-campion-wild":{"ref":"Culpeper, Complete Herbal: Campion, Wild","headword":"Campion, Wild","lang":"en","source":"culpeper","text":"They belong to Saturn, and it is found by experience, that the decoction of the herb, either in white or red wine being drank, doth stay inward bleedings, and applied outwardly it does the like; and being drank, helps to expel urine, being stopped, and gravel and stone in the reins and kidneys. Two drams of the seed drank in wine, purges the body of choleric humours, and helps those that are stung by scorpions, or other venomous beasts, and may be as effectual for the plague. It is of very good use in old sores, ulcers, cankers, fistulas, and the like, to cleanse and heat them, by consuming the moist humours falling into them and correcting the putrefaction of humours offending them.","spans":[{"start":144,"end":153,"concept_id":"hemorrhage","polarity":"therapeutic"},{"start":221,"end":232,"concept_id":"diuresis","polarity":"action"},{"start":253,"end":259,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":264,"end":269,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":277,"end":282,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":287,"end":294,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":333,"end":348,"concept_id":"constipation","polarity":"action"},{"start":395,"end":400,"concept_id":"envenomation","polarity":"therapeutic"},{"start":404,"end":413,"concept_id":"envenomation","polarity":"therapeutic"},{"start":424,"end":432,"concept_id":"envenomation","polarity":"therapeutic"},{"start":473,"end":479,"concept_id":"plague","polarity":"therapeutic"},{"start":511,"end":516,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":518,"end":524,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":526,"end":533,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":535,"end":543,"concept_id":"skin_ulcers","polarity":"therapeutic"}]}},"gloss":{"cul:062-campion-wild":{"144":"bleeding (inward / outward / of wounds)","221":"provokes urine: diuretic","253":"gravel: small urinary concretions","264":"the stone (urinary calculus)","277":"reins: kidneys","287":"kidneys","333":"purges / opens / loosens the belly: laxative, purgative","395":"bitten or stung","404":"serpents, vipers, adders, scorpions, wasps","424":"venomous beasts / creatures","473":