ινόν. χυλίζεται δὲ ὅλον σὺν τῇ ῥίζῃ. ποιεῖ δὲ ὁ χυλὸς πρὸς αἵματος ἀναγωγάς πινόμενος καὶ κοιλιακοὺς καὶ ῥοῦν ἐρυθρόν, ψύχων καὶ στύφων· ἐπέχει δὲ καὶ τάς ἐκ μυκτήρων αἱμορραγίας. τὰ δὲ θυλάκια λεῖα τοῖς νεοτρώτοις ἐπιτιθέμενα μέχρι ἀπουλώσεως ἐνεργεῖ.","spans":[{"start":254,"end":268,"concept_id":"hemoptysis","polarity":"therapeutic"},{"start":285,"end":292,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":300,"end":310,"concept_id":"menorrhagia","polarity":"therapeutic"},{"start":353,"end":365,"concept_id":"nosebleed","polarity":"therapeutic"},{"start":362,"end":370,"concept_id":"hemorrhage","polarity":"therapeutic"},{"start":399,"end":406,"concept_id":"wounds","polarity":"therapeutic"},{"start":428,"end":433,"concept_id":"wounds","polarity":"action"}]}},"images":[]}