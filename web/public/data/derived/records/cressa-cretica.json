υῖ τὰ φύλλα καὶ τὰ κλωνία ἔοικε, δασύτερα μέντοι καὶ βραχύτερα· τὸ δʼ ἄνθος πορφυροῦν, βαρύοσμον ἰσχυρῶς, ῥίζα ὥσπερ κιχορίου. δόναται δὲ ἰσχυρῶς δυσουροῦσι καὶ νεφριτικοῖς βοηθεῖν 2 πινομένη πλῆθος δραχμῶν τεσσάρων. ἐκμαλάσσουσι δὲ φλεγμονάς τάς ἐν ὑστέρᾶ λεῖαι σύν ῥοδίνῳ καὶ γάλακτι προστιθέμεναι· ἰῶνται δὲ καὶ τραύματα. ἡ δὲ τῇ χαμαιπίτυϊ ὁμοία μετὰ τῶν ἄλλων καὶ ἐπιληπτικῶν βοήθημα σύν ὀξυμέλιτι πινομένη.","spans":[{"start":361,"end":367,"concept_id":"dysuria","polarity":"therapeutic"},{"start":376,"end":387,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":448,"end":455,"concept_id":"inflammation","polarity":"therapeutic"},{"start":462,"end":471,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":530,"end":536,"concept_id":"wounds","polarity":"therapeutic"},{"start":584,"end":591,"concept_id":"epilepsy","polarity":"therapeutic"}]}},"images":[]}