l":0,"persistent":false,"epmc_pair":0,"lift":0.63,"evidence_tier":"unstudied"},{"concept_id":"sciatica","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.8,"evidence_tier":"unstudied"},{"concept_id":"scrofula","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.82,"evidence_tier":"unstudied"},{"concept_id":"toothache","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.72,"evidence_tier":"unstudied"},{"concept_id":"urolithiasis","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.84,"evidence_tier":"unstudied"},{"concept_id":"uterine_disorders","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.33,"evidence_tier":"unstudied"},{"concept_id":"wounds","dsc":1,"cul":0,"persistent":false,"epmc_pair":11,"lift":7.33,"evidence_tier":"studied"}],"lead_score":null},"texts":{"dsc:3.146":{"ref":"De materia medica 3.146","headword":"ἀολθαία","lang":"grc","source":"dioscorides","text":"ἀολθαία, ἣν ἔνιοι ἐβίσκον καλοῦσι, μολόχης ἐστὶν ἀγρίας εἶδος· ἔχει δὲ φύλλα περιφερῆ ὥσπερ κυκλάμινος, ἔγχνοα, ἄνθος ῥοδοειδές, καυλὸν δὲ πηχυαῖον, ῥίζαν δὲ γλίσχραν, λευκὴν ἕνδοθεν. ὠνόμασται δὲ ἀλθαία διὰ τὸ πολυαλθὲς καὶ πολύχρηστον αὐτῆς· ἑψηθεῖσα γὰρ ἐν μελικράτῳ ἢ οἴνῳ ἢ καθʼ ἑαυτὴν κοπεῖσα ποιεῖ πρὸς τραύματα, παρωτίδας, χοιράδας, ἀποστήματα, μαστούς φλεγμαίνοντας, φλεγμονὰς δακτυλίου, θλάσματα, ἐμφυσήματα, συντάσεις νεύρων διαφορεῖ γάρ καὶ ἐκπέσσει καὶ ῥήγνυσι καὶ ἀπουλοῖ. συμμαλαχθεῖσα δὲ ἑφθή, ὡς εἴρηται, στέατι ὑείῳ ἡ χηνείῳ καὶ τερεβινθίνῃ πρὸς ὑστέρας φλεγμονάς καὶ μύσεις ἐν προσθέματι ποιεῖ· καὶ τὸ ἀφέψημα δὲ αὐτῆς τὰ αὐτὰ ποιεῖ, ἄγον καὶ τὰ καλούμενα λοχεῖα. τὸ δὲ τῆς ῥίζης ἀφέψημα πινόμενον σύν οἴνῳ ὠφελεῖ δυσουποῦντας, λιθιῶντας, ὠμότητας ἰσχιαδικούς, δυσεντερικούς, τρομώδεις, ῥηγματίας, καὶ πόνους ὀδόντων πραΰνει σὺν ὄξει ἀφεψηθεῖσα καὶ διακλυζομένη. ὁ δὲ καρπὸς χλωρός τε καὶ ξηρὸς λεῖος καταχρισθεὶς σύν ὄξει ἐν ἡλίῳ σμηκτικός ἐστιν ἀλφῶν, μετʼ ὀξελαίου δὲ σύγχρισμα προφυλακτικὸν ἰοβόλων· ποιεῖ δὲ καὶ πρὸς δυσεντερίαν, ὰἵματος ἀναγωγήν, διάρροιαν. τὸ δὲ ἀφέψημα τοῦ σπέρματος πινόμενον καὶ πρὸς μελισσῶν καὶ τῶν λεπτῶν θηρίων πληγάς πάντων ἐν ὀξυδράτῳ ποθὲν ἡ ἐν οἴνῳ· καὶ τὰ φύλλα δὲ μετʼ ἐλαίου ὀλίγου καταπλάσσεται ἐπὶ τῶν δηγμάτων καὶ ἐπὶ πυρικαύτων. πήγνυσι δὲ ἡ ῥίζα καὶ ὕδωρ μιγεῖσα λεία καὶ συνεξαιθριασθεῖσα.","spans":[{"start":310,"end":316,"concept_id":"wounds","polarity":"therapeutic"},{"start":320,"end":327,"concept_id":"abscess","polarity":"therapeutic"},{"start":331,"end":337,"concept_id":"scrofula","polarity":"therapeutic"},{"start":341,"end":348,"concept_id":"abscess","polarity":"therapeutic"},{"start":361,"end":369,"concept_id":"inflammation","polarity":"therapeutic"},{"start":376,"end":383,"concept_id":"inflammation","polarity":"therapeutic"},{"start":397,"end":402,"concept_id":"bruises","polarity":"therapeutic"},{"start":478,"end":483,"concept_id":"wounds","polarity":"action"},{"start":564,"end":571,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":572,"end":579,"concept_id":"inflammation","polarity":"therapeutic"},{"start":675,"end":680,"concept_id":"labor","polarity":"therapeutic"},{"start":747,"end":752,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":767,"end":773,"concept_id":"sciatica","polarity":"therapeutic"},{"start":780,"end":788,"concept_id":"dysentery","polarity":"therapeutic"},{"start":795,"end":804,"concept_id":"paralysis","polarity":"therapeutic"},{"start":806,"end":810,"concept_id":"bruises","polarity":"therapeutic"},{"start":821,"end":833,"concept_id":"toothache","polarity":"therapeutic"},{"start":966,"end":971,"concept_id":"scaly_skin","polarity":"therapeutic"},{"start":1014,"end":1019,"concept_id":"envenomation","polarity":"therapeutic"},{"start":1041,"end":1049,"concept_id":"dysentery","polarity":"therapeutic"},{"start":1054,"end":1068,"concept_id":"hemoptysis","polarity":"therapeutic"},{"start":1072,"end":1078,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":1154,"end":1165,"concept_id":"envenomation","polarity":"therapeutic"},{"sta