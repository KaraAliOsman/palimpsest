α αὐτῆς πρὸς θηρίων δήγματα καὶ σπάσματα καὶ ῥήγματα καὶ στραγγουρίας· ἄγει καὶ ἔμμηνα καὶ ἔμβρυα, καὶ ἀκροχορδόνας ἀποβάλλει ἐφ᾿ ἱκανὰς ἡμέρας πινόμενον, κοιλίαν τε ἵστησιν ἐπὶ τρίτον ἑψόμενον καὶ πινόμενον ἀπυρέτοις ἐν οἴνῳ, πυρέττουσι δὲ δι᾿ ὕδατος.","spans":[{"start":272,"end":283,"concept_id":"envenomation","polarity":"therapeutic"},{"start":291,"end":298,"concept_id":"convulsions","polarity":"therapeutic"},{"start":304,"end":308,"concept_id":"bruises","polarity":"therapeutic"},{"start":316,"end":325,"concept_id":"dysuria","polarity":"therapeutic"},{"start":330,"end":356,"concept_id":"abortifacient","polarity":"action"},{"start":362,"end":370,"concept_id":"warts","polarity":"therapeutic"},{"start":414,"end":432,"concept_id":"diarrhea","polarity":"therapeutic"}]}},"gloss":{"dsc:3.95":{"272":"bites of beasts, snakes, vipers, shrews","291":"spasms, strains (σπάσματα)","304":"ruptures, strains (ῥήγματα)","316":"strangury (στραγγουρία)","330":"expels ... the embryo","362":"pedunculated warts (ἀκροχορδόνες)","414":"binds / checks the bowels"}},"images":[]}