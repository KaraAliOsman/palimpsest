t":false,"epmc_pair":1,"lift":1.21,"evidence_tier":"sparse"},{"concept_id":"mouth_gums","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.5,"evidence_tier":"unstudied"},{"concept_id":"skin_blemishes","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.82,"evidence_tier":"unstudied"},{"concept_id":"urolithiasis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.74,"evidence_tier":"unstudied"},{"concept_id":"uterine_disorders","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":0.63,"evidence_tier":"sparse"}],"lead_score":null},"texts":{"dsc:2.131":{"ref":"De materia medica 2.131","headword":"σόγχου δύο ἐστὶν εἴδη","lang":"grc","source":"dioscorides","text":"σόγχου δύο ἐστὶν εἴδη· τὸ μὲν γάρ ἐστιν ἀγριώτερον καὶ ἀκανθωδέστερον τὸ δὲ τρυφερώτερον καὶ ἐδωδιμώτερον· καυλὸς δὲ γωνιοειδής, ὑπέρυθρος, κενός· φύλλα δὲ ἔχει ἐκ διαστημάτων ἐσχισμένα τὴν περιφέρειαν. δύναμις δὲ αὐτῶν ἐστι ψυκτική, μετρίως ὑποστύφουσα, ὅθεν στομάχῳ καυσουμένῳ καὶ φλεγμοναῖς καταπλασσόμενα ἁρμόζουσιν· ὁ δὲ χυλὸς καταρροφούμενος δηγμοὺς στομάχου παύει καὶ γάλα κατασπᾷ, προστεθεὶς δὲ ἐν ἐρίῳ δακτυλίου καὶ μήτρας φλεγμοναῖς βοηθεῖ. ἡ δὲ πόα καὶ ἡ ῥίζα καταπλασθεῖσα σκορπιοπλήκτοις ἀρήγει.","spans":[{"start":260,"end":272,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":283,"end":290,"concept_id":"inflammation","polarity":"therapeutic"},{"start":348,"end":362,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":375,"end":386,"concept_id":"lactation","polarity":"action"},{"start":425,"end":431,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":432,"end":439,"concept_id":"inflammation","polarity":"therapeutic"},{"start":485,"end":497,"concept_id":"envenomation","polarity":"therapeutic"}]},"cul:286-sow-thistle":{"ref":"Culpeper, Complete Herbal: Sow Thistle","headword":"Sow Thistle","lang":"en","source":"culpeper","text":"This and the former are under the influence of Venus. Sow Thistles are cooling, and somewhat binding, and are very fit to cool a hot stomach, and ease the pains thereof. The herb boiled in wine, is very helpful to stay the dissolution of the stomach, and the milk that is taken from the stalks when they are broken, given in drink, is beneficial to those that are short winded, and have a wheezing. Pliny saith, That it hath caused the gravel and stone to be voided by urine, and that the eating thereof helps a stinking breath. The decoction of the leaves and stalks causes abundance of milk in nurses, and their children to be well coloured. The juice or distilled water is good for all hot inflammations, wheals, and eruptions or heat in the skin, itching of the hæmorrhoids. The juice boiled or thoroughly heated in a little oil of bitter almonds in the peel of a pomegranate, and dropped into the ears, is a sure remedy for deafness, singings, &c. Three spoonfuls of the juice taken, warmed in white wine, and some wine put thereto, causes women in travail to have so easy and speedy a delivery, that they may be able to walk presently after. It is wonderful good for women to wash their faces with, to clear the skin, and give it a lustre.","spans":[{"start":122,"end":140,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":364,"end":376,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":389,"end":397,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":436,"end":442,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":447,"end":452,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":512,"end":527,"concept_id":"mouth_gums","polarity":"therapeutic"},{"start":568,"end":592,"concept_id":"lactation","polarity":"action"},{"start":693,"end":706,"concept_id":"inflammation","polarity":"therapeutic"},{"start":708,"end":714,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":720,"end":729,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":751,"end":758,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":766,"end":777,"concept_id":"hemorrhoids","polarity":"therapeutic"},{"start":893,"end":937,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":1054,"end":1061,"concept_id":"labor","polarity":"therapeutic"},{"start":1082,"end":1099,"concept_id":"labor","polarity":"therapeutic"},{"start":1208,"end":1222,"concept_id":"skin_blemishes","polarity":"therapeutic"}]}},"images":["gansedistel-wiener-dioskurides-315r"]}