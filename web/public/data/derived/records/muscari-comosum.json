e_tier":"unstudied"},{"concept_id":"ear_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.94,"evidence_tier":"unstudied"},{"concept_id":"edema_dropsy","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.79,"evidence_tier":"unstudied"},{"concept_id":"envenomation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"gout","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":2.8,"evidence_tier":"sparse"},{"concept_id":"inflammation","dsc":1,"cul":0,"persistent":false,"epmc_pair":2,"lift":2.34,"evidence_tier":"sparse"},{"concept_id":"pain","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.48,"evidence_tier":"unstudied"},{"concept_id":"sexual_function","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.95,"evidence_tier":"unstudied"},{"concept_id":"sore_throat","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.97,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:2.170":{"ref":"De materia medica 2.170","headword":"βολβὸς ἐδώδιμος","lang":"grc","source":"dioscorides","text":"βολβὸς ἐδώδιμος· εὐστόμαχος ὁ πυρρός, ἀπὸ Λιβύης κομιζόμενος, ὁ δὲ πικρὸς ναὶ σκιλλώδης εὐστομαχώτερος, πεπτικός. πάντες δὲ δριμεῖς καὶ θερμαντικοί, συνουσίαν παρορμῶντες, τραχύνοντες γλῶσσαν καὶ παρίσθμια, πολύτροφοι καὶ σαρκοποιητικοί, ἐμπνευματοῦντες· ποιοῦσι δὲ καταπλασσόμενοι πρὸς στρέμματα καὶ θλάσματα καὶ σκόλοπας καὶ πρὸς τὰς τῶν ἄρθρων ἀδύνας καὶ ποδάγρας σὺν μέλιτι καὶ καθ᾿ ἑαυτούς, καὶ τὰ ἐπὶ τῶν ὑδρωπικῶν οἰδήματα καὶ κυνόδηκτα ὁμοίως σὺν μέλιτι· ἐπέχουσι δὲ καὶ ἱδρῶτας. σὺν πεπέρει δὲ 2 λείῳ καταπλασθέντες στομάχου ὀδύνας παύουσι, καὶ πίτυρα καὶ ἀχῶρας ἀποσμήχουσι σὺν ὀπτῷ νίτρῳ· καθαίρουσι καὶ ὑπώπια καὶ ἰόνθους καθ᾿ ἑαυτοὺς ἢ σὺν ᾠοῦ λεκίθῳ, φακούς τε σὺν ὀξυμέλιτι· πρὸς δὲ ὤτων θλάσματα σὺν ἀλφίτῳ καὶ πρὸς θλάσεις ὀνύχων. ἀφαιροῦσι δὲ καὶ σύκας ὀπτηθέντες ἐν θερμοσποδιᾷ καὶ μετά μαινίδων κεφαλῶν κεκαυμένων ἐπιτεθέντες, καέντες δὲ καὶ μιγέντες ἁλκυονίῳ ἔφηλιν καὶ οὐλὰς μελαίνας ἀποκαθαίρουσιν, ἐν ἡλίῳ καταχριόμενοι. σὺν ὄξει δὲ ἑφθοὶ βιβρωσκόμενοι πρὸς ῥήγματα ποιοῦσι· φυλάσσεσθαι δὲ δεῖ τὸ πλῆθος αὐτῶν ἐν τῇ βρώσει διὰ τὸ ἅπτεσθαι τοῦ νευρώδους.","spans":[{"start":17,"end":25,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":88,"end":96,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":149,"end":156,"concept_id":"sexual_function","polarity":"action"},{"start":196,"end":203,"concept_id":"sore_throat","polarity":"therapeutic"},{"start":287,"end":293,"concept_id":"bruises","polarity":"therapeutic"},{"start":301,"end":306,"concept_id":"bruises","polarity":"therapeutic"},{"start":358,"end":364,"concept_id":"gout","polarity":"therapeutic"},{"start":411,"end":416,"concept_id":"edema_dropsy","polarity":"therapeutic"},{"start":421,"end":426,"concept_id":"inflammation","polarity":"therapeutic"},{"start":434,"end":442,"concept_id":"envenomation","polarity":"therapeutic"},{"start":534,"end":540,"concept_id":"pain","polarity":"therapeutic"},{"start":554,"end":569,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":615,"end":619,"concept_id":"bruises","polarity":"therapeutic"},{"start":626,"end":630,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":665,"end":671,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":698,"end":702,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":703,"end":708,"concept_id":"bruises","polarity":"therapeutic"},{"start":732,"end":737,"concept_id":"bruises","polarity":"therapeutic"},{"start":880,"end":884,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":891,"end":903,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":982,"end":986,"concept_id":"bruises","polarity":"therapeutic"}]}},"images":[]}