ca","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.25,"evidence_tier":"unstudied"},{"concept_id":"spleen_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":11,"lift":1.17,"evidence_tier":"studied"},{"concept_id":"warts","dsc":0,"cul":1,"persistent":false,"epmc_pair":10,"lift":2.86,"evidence_tier":"studied"}],"lead_score":null},"texts":{"cul:307-thyme":{"ref":"Culpeper, Complete Herbal: Thyme","headword":"Thyme","lang":"en","source":"culpeper","text":"It is a noble strengthener of the lungs, as notable a one as grows; neither is there scarce a better remedy growing for that disease in children which they commonly call the Chin-cough, than it is. It purges the body of phlegm, and is an excellent remedy for shortness of breath. It kills worms in the belly, and being a notable herb of Venus, provokes the terms, gives safe and speedy delivery to women in travail, and brings away the after birth. It is so harmless you need not fear the use of it. An ointment made of it takes away hot swellings and warts, helps the sciatica and dullness of sight, and takes away pains and hardness of the spleen. ’Tis excellent for those that are troubled with the gout. It eases pains in the loins and hips. The herb taken any way inwardly, comforts the stomach much, and expels wind.","spans":[{"start":174,"end":184,"concept_id":"cough","polarity":"therapeutic"},{"start":201,"end":226,"concept_id":"constipation","polarity":"action"},{"start":259,"end":278,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":289,"end":294,"concept_id":"helminthiasis","polarity":"therapeutic"},{"start":344,"end":362,"concept_id":"amenorrhea","polarity":"action"},{"start":370,"end":394,"concept_id":"labor","polarity":"therapeutic"},{"start":407,"end":414,"concept_id":"labor","polarity":"therapeutic"},{"start":436,"end":447,"concept_id":"labor","polarity":"therapeutic"},{"start":534,"end":547,"concept_id":"inflammation","polarity":"therapeutic"},{"start":552,"end":557,"concept_id":"warts","polarity":"therapeutic"},{"start":569,"end":577,"concept_id":"sciatica","polarity":"therapeutic"},{"start":582,"end":599,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":642,"end":648,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":702,"end":706,"concept_id":"gout","polarity":"therapeutic"},{"start":779,"end":799,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":810,"end":821,"concept_id":"flatulence","polarity":"action"}]}},"gloss":{"cul:307-thyme":{"174":"chin-cough: whooping cough (pertussis)","201":"purges choler, phlegm or melancholy downwards: cathartic","259":"shortness of breath: dyspnoea","289":"worms (intestinal)","344":"provokes / brings down the terms, courses: emmenagogue","370":"speedy / easy / safe delivery in childbirth","407":"travail: labour","436":"after-birth: placenta","534":"hot / red / painful swellings (phlegmone)","552":"warts","569":"sciatica","582":"dull / weak sight","642":"spleen: hardness, swelling, stoppings of the spleen","702":"gout","779":"strengthens / comforts the stomach (stomachic)","810":"expels / breaks wind (carminative)"}},"images":[]}