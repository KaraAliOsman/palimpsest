λύει κούφως. καὶ εἴ τις κοιλάνας αὐτὴν ὠμὴν ἐγχέας τε οἶνον καὶ ἐξαιθριάσας κεράσας τε δοίη πιεῖν, μαλάσσει κοιλίαν κούφως.","spans":[{"start":42,"end":47,"concept_id":"inflammation","polarity":"therapeutic"},{"start":55,"end":62,"concept_id":"abscess","polarity":"therapeutic"},{"start":173,"end":180,"concept_id":"inflammation","polarity":"therapeutic"},{"start":187,"end":193,"concept_id":"gout","polarity":"therapeutic"},{"start":230,"end":235,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":440,"end":450,"concept_id":"constipation","polarity":"action"},{"start":547,"end":563,"concept_id":"constipation","polarity":"action"}]}},"gloss":{"dsc:2.134":{"42":"swellings (οἰδήματα)","55":"abscesses (ἀποστήματα)","173":"inflammations (φλεγμοναί)","187":"gout (ποδάγρα)","230":"earache (ὠταλγία)","440":"loosens / moves the bowels (laxative)","547":"loosens ... the bowels"}},"images":[]}