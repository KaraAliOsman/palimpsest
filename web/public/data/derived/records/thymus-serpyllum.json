_pair":0,"lift":0.25,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"cul:308-wild-thyme-or-mother-of-thyme":{"ref":"Culpeper, Complete Herbal: Wild Thyme, Or Mother Of Thyme","headword":"Wild Thyme, Or Mother Of Thyme","lang":"en","source":"culpeper","text":"It is under the dominion of Venus, and under the sign Aries, and therefore chiefly appropriated to the head. It provokes urine and the terms, and eases the griping pain of the belly, cramps, ruptures, and inflamation of the liver. If you make a vinegar of the herb, as vinegar of roses is made (you may find out the way in my translation of the London Dispensatory) and anoint the head with it, it presently stops the pains thereof. It is excellently good to be given either in phrenzy or lethargy, although they are two contrary diseases: It helps spitting and voiding of blood, coughing, and vomiting; it comforts and strengthens the head, stomach, reins, and womb, expels wind, and breaks the stone.","spans":[{"start":112,"end":140,"concept_id":"amenorrhea","polarity":"action"},{"start":156,"end":163,"concept_id":"colic","polarity":"therapeutic"},{"start":164,"end":181,"concept_id":"colic","polarity":"therapeutic"},{"start":183,"end":189,"concept_id":"convulsions","polarity":"therapeutic"},{"start":205,"end":229,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":478,"end":485,"concept_id":"delirium","polarity":"therapeutic"},{"start":489,"end":497,"concept_id":"delirium","polarity":"therapeutic"},{"start":580,"end":588,"concept_id":"cough","polarity":"therapeutic"},{"start":594,"end":602,"concept_id":"nausea_vomiting","polarity":"therapeutic"},{"start":651,"end":656,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":662,"end":666,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":668,"end":679,"concept_id":"flatulence","polarity":"action"},{"start":696,"end":701,"concept_id":"urolithiasis","polarity":"therapeutic"}]}},"images":[]}