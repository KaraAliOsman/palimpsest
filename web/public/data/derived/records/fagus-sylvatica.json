{"slug":"fagus-sylvatica","plant":{"taxon":"Fagus sylvatica","family":"Fagaceae","rank":"species","gbif_key":2882316,"wikidata":"Q146149","iucn":"LC","gbif_occurrences":1609354,"common_name":"Beech","names":[{"source":"culpeper","name":"The Beech Tree","monograph_id":"cul:034-the-beech-tree","confidence":"high","note":"Standard identification."}],"n_compounds":9,"top_compounds":[{"name":"(+)-catechin","qid":"Q415007"},{"name":"(+)-taxifolin 3-O-beta-D-xylopyranoside","qid":"Q27145514"},{"name":"taxifolin-3-glucoside","qid":"Q27273370"},{"name":"(2S,3S)-(-)-Glucodistylin","qid":"Q72480382"},{"name":"(2S,3S)-2-(3,4-dihydroxyphenyl)-5,7-dihydroxy-3-[(2S,3R,4R,5S,6R)-3,4,5-trihydroxy-6-(hydroxymethyl)oxan-2-yl]oxy-2,3-dihydrochromen-4-one","qid":"Q105002709"},{"name":"(Z)-Isoconiferin","qid":"Q105132350"},{"name":"(Z)-Syringin","qid":"Q105222915"},{"name":"(Z)-Coniferin","qid":"Q105251838"}],"epmc_total":2768,"trials":0,"claims":[{"concept_id":"dermatitis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.06,"evidence_tier":"unstudied"},{"concept_id":"inflammation","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.01,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"cul:034-the-beech-tree":{"ref":"Culpeper, Complete Herbal: The Beech Tree","headword":"The Beech Tree","lang":"en","source":"culpeper","text":"It is a plant of Saturn, and therefore performs his qualities and proportion in these operations. The leaves of the Beech tree are cooling and binding, and therefore good to be applied to hot swellings to discuss them; the nuts do much nourish such beasts as feed thereon. The water that is found in the hollow places of decaying Beeches will cure both man and beast of any scurf, or running tetters, if they be washed therewith; you may boil the leaves into a poultice, or make an ointment of them when time of year serves.","spans":[{"start":188,"end":201,"concept_id":"inflammation","polarity":"therapeutic"},{"start":374,"end":379,"concept_id":"de