ς, οἱ δὲ ἐρυσίσκηπτρον, οἱ δὲ σφάγνον, Σύροι δὲ διάξυλον καλοῦσι. θάμνος ἐστὶ ξυλώδης, ἀκάνθαις πολλαῖς κεχρημένος, γεννώμενος ἐν Νισύρῳ καὶ Συρίᾳ καὶ τῇ Ῥοδίᾳ, ᾧ χρῶνται οἱ μυρεψοὶ εἰς τὰς τῶν μύρων στύψεις. ἔστι δὲ καλὸς ὁ βαρὺς καὶ μετὰ τὸ περιφλοισθῆναι ὑπέρυθρος ἢ πορφυρίζων, πυκνός, εὐώδης, πικρίζων ἐν τῇ γεύσει. ἔστι δέ τι καὶ ἕτερον εἶδος αὐτοῦ, λευκόν, ξυλῶδες, ἄνοσμον, ὃ δὴ καὶ χεῖρον καθέστηκε. 2 δύναμιν δὲ ἔχει θερμαντικὴν μετὰ στύψεως, ὅθεν πρός τε τὰς ἄφθας ἑψηθεὶς μετ᾿ οἴνου καὶ διακλυζόμενον ἁρμόζει καὶ πρὸς τὰς ἐν αἰδοίοις ἀκαθαρσίας καὶ νομὰς ἐγκλυζόμενος καὶ πρὸς τὰς ὀζαίνας, ἔμβρυά τε κατασπᾷ μειγνύμενος πεσσῷ. τὸ δὲ ἀφέψημα αὐτοῦ κοιλίαν ἵστησι καὶ αἵματος ἀναγωγὴν ποθὲν δυσουρίαν τε καὶ ἐμπνευμάτωσιν λύει.","spans":[{"start":478,"end":483,"concept_id":"mouth_gums","polarity":"therapeutic"},{"start":569,"end":574,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":601,"end":606,"concept_id":"common_cold","polarity":"therapeutic"},{"start":610,"end":627,"concept_id":"abortifacient","polarity":"action"},{"start":667,"end":681,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":675,"end":693,"concept_id":"hemorrhage","polarity":"therapeutic"},{"start":686,"end":700,"concept_id":"hemoptysis","polarity":"therapeutic"},{"start":709,"end":715,"concept_id":"dysuria","polarity":"therapeutic"},{"start":726,"end":737,"concept_id":"flatulence","polarity":"therapeutic"}]}},"images":[]}