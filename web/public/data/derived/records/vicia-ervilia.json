{"slug":"vicia-ervilia","plant":{"taxon":"Vicia ervilia","family":"Fabaceae","rank":"species","gbif_key":2974887,"wikidata":"Q163064","iucn":"LC","gbif_occurrences":10292,"common_name":"bitter vetch","names":[{"source":"dioscorides","name":"ὄροβος","monograph_id":"dsc:2.108","confidence":"high","note":"Narrow-leaved small plant with podded seed yielding orobinon flour; standard."}],"n_compounds":3,"top_compounds":[{"name":"zeaxanthin","qid":"Q169337"},{"name":"cryptoxanthin","qid":"Q392062"},{"name":"luteolin","qid":"Q415011"}],"epmc_total":52,"trials":0,"claims":[{"concept_id":"colic","dsc":2,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.96,"evidence_tier":"unstudied"},{"concept_id":"diuresis","dsc":2,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.87,"evidence_tier":"unstudied"},{"concept_id":"abscess","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.81,"evidence_tier":"unstudied"},{"concept_id":"constipation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.9,"evidence_tier":"unstudied"},{"concept_id":"dysentery","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.95,"evidence_tier":"unstudied"},{"concept_id":"dysuria","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.89,"evidence_tier":"unstudied"},{"concept_id":"envenomation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.97,"evidence_tier":"unstudied"},{"concept_id":"itch_scabies","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.91,"evidence_tier":"unstudied"},{"concept_id":"kidney_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":3,"lift":3.47,"evidence_tier":"sparse"},{"concept_id":"skin_blemishes","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.95,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.93,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:2.108":{"ref":"De materia medica 2.108","headword":"ὄροβός ἐστι θαμνίσκος","lang":"grc","source":"dioscorides","text":"ὄροβός ἐστι θαμνίσκος στενόφυλλος, λεπτός, ἔχων σπερμάτιον ἐν λοβοῖς, ἐξ οὖ γίνεται τὸ καλούμενον ὀρόβινον. ἄλευρον, ὅ καὶ πρὸς τὴν ἰατρικὴν ἁρμόζει χρῆσιν. ἐστι δὲ καρηβαρικός, κοιλίας ταρακτικός, εἰ βρωθείη, αἷμά τε διʼ οὔρων ἄγει. βοῦς δὲ λιπαίνει ἑφθὸς παρατιθέμενος. σκευάζεται δὲ τὸ ἐξ αὐτοῦ ἀρόβινον οὕτως· ἐκλέξας τοὺς εὐτρόφους καὶ λευκοὺς ῥαῖνε ὕδατι ἀναφυρῶν, ἐάσας τε ἐφ᾿ ἱκανὸν συμπιεῖν φρῦγε, ἄχρι οὗ ἂν περιρραγῇ ὁ φλοιός, εἶτα ἀλέσας καὶ διασήσας κοσκίνῳ λεπτῷ ἀπόθου. ἐστι δὲ εὐκοίλιον, οὐρητικόν, εὐχροίας ποιητικόν, πλεονασθὲν δὲ ἐν βρωτῷ ἢ ἐν ποτῷ μετὰ στρόφων αἶμα ἄγει διὰ κοιλίας καὶ κύστεως. καθαίρει δὲ ἕλκη σὺν μέλιτι καὶ φακοὺς καὶ σπίλους καὶ ἐφήλεις καὶ τὸ λοιπὸν σῶμα, νομάς τε ἵστησι καὶ σκληρώματαs καὶ γαγγραίνας, καὶ σκληρίας τὰς ἐν μαστοῖς μαλάσσει καὶ θηριώδη καὶ ἄνθρακας καὶ κηρία περιρρήττει. φυραθεὶς δὲ σὺν οἴνῳ κυνόδηκτα καὶ ἐχεόδηκτα καὶ ἀνθρωπόδηκτα θεραπεύει καταπλασσόμενος, σὺν ὄξει δὲ δυσουρίας καὶ στρόφους καὶ τεινεσμούς παύει· ἁρμόζει δὲ καὶ ἀτρόφοις ὅσον καρύου μέγεθος φρυκτὸν λημφθὲν σὺν μέλιτι. τὸ δὲ ἀφέψημα αὐτοῦ καταντλούμενον χιμέτλας καὶ κνησμοὺς τοὺς ἐν σώματι θεραπεύει.","spans":[{"start":165,"end":172,"concept_id":"headache","polarity":"adverse"},{"start":178,"end":192,"concept_id":"diarrhea","polarity":"adverse"},{"start":222,"end":232,"concept_id":"diuresis","polarity":"action"},{"start":493,"end":500,"concept_id":"constipation","polarity":"action"},{"start":504,"end":511,"concept_id":"diuresis","polarity":"action"},{"start":573,"end":580,"concept_id":"colic","polarity":"therapeutic"},{"start":607,"end":614,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":628,"end":632,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":648,"end":654,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":659,"end":666,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":671,"end":675,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":699,"end":704,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":735,"end":743,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":800,"end":808,"concept_id":"abscess","polarity":"therapeutic"},{"start":813,"end":818,"concept_id":"abscess","polarity":"therapeutic"},{"start":853,"end":861,"concept_id":"envenomation","polarity":"therapeutic"},{"start":867,"end":875,"concept_id":"envenomation","polarity":"therapeutic"},{"start":933,"end":939,"concept_id":"dysuria","polarity":"therapeutic"},{"start":947,"end":955,"concept_id":"colic","polarity":"therapeutic"},{"start":960,"end":967,"concept_id":"dysentery","polarity":"therapeutic"},{"start":1098,"end":1103,"concept_id":"itch_scabies","polarity":"therapeutic"}]}},"images":[]}