3,"evidence_tier":"unstudied"},{"concept_id":"amenorrhea","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.86,"evidence_tier":"unstudied"},{"concept_id":"delirium","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.76,"evidence_tier":"unstudied"},{"concept_id":"dyspepsia","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":2.24,"evidence_tier":"sparse"},{"concept_id":"ear_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.84,"evidence_tier":"unstudied"},{"concept_id":"envenomation","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.95,"evidence_tier":"unstudied"},{"concept_id":"epilepsy","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":1.69,"evidence_tier":"sparse"},{"concept_id":"eye_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.38,"evidence_tier":"unstudied"},{"concept_id":"flatulence","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.97,"evidence_tier":"unstudied"},{"concept_id":"headache","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.68,"evidence_tier":"unstudied"},{"concept_id":"helminthiasis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.76,"evidence_tier":"unstudied"},{"concept_id":"labor","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.69,"evidence_tier":"unstudied"},{"concept_id":"malaria","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.68,"evidence_tier":"unstudied"},{"concept_id":"memory","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.21,"evidence_tier":"unstudied"},{"concept_id":"paralysis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.54,"evidence_tier":"unstudied"},{"concept_id":"poisoning","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":1.91,"evidence_tier":"sparse"},{"concept_id":"uterine_disorders","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":1.39,"evidence_tier":"sparse"}],"lead_score":0.5653},"texts":{"dsc:3.98":{"ref":"De materia medica 3.98","headword":"χαμαίρωψ ἢ χαμαίδρυς ἢ λινόδρυς","lang":"grc","source":"dioscorides","text":"χαμαίρωψ ἢ χαμαίδρυς ἢ λινόδρυς· οἱ δὲ καὶ ταύτην Τεύκριον καλοῦσι διὰ τὸ σῴζειν ἐμφέρειαν ποσὴν πρὸς Τεύκριον φύεται ἐν τραχέσι καὶ πετρώδεσι χωρίοις. ἔστι δὲ θαμνίσκος σπιθαμιαῖος φύλλα ἔχων μικρά, τῷ σχήματι καὶ τῇ σχίσει δρυῒ ὅμοια, πικρά, ἄνθος ὑποπόρφυρον, μικρόν· συλλέγειν δὲ αὐτὴν δεῖ ἐγκύμονα τοῦ καρποῦ. δύναμιν δὲ ἔχει χλωρά τε καὶ ξηρὰ ἀφεψηθεῖσα σὺν ὕδατι καὶ ποτιζομένη βοηθεῖν σπάσμασι, βηχί, σπληνὶ ἐσκιρρωμένῳ, δυσουροῦσιν, ὑδρωπικοῖς ἐν ἀρχαῖς· ἄγει καὶ ἔμμηνα καὶ ἔμβρυα σπλῆνά τε τήκει σὺν ὄξει ποθεῖσα· πρὸς δὲ τὰ θηρία σὺν οἴνῳ πινομένη καὶ καταπλασσομένη ποιεῖ. λεία δὲ δύναται καὶ εἰς καταπότια ἀναπλάσσεσθαι πρὸς τὰ εἰρημένα, καθαίρει καὶ ἕλκη παλαιὰ σὺν μέλιτι· αἴρει δὲ ἀχλῦς τὰς ἐν ὀφθαλμοῖς σὺν ἐλαίῳ λεία ἐγχριομένη· καὶ ἀλειφομένη δέ ἐστι θερμαντική.","spans":[{"start":393,"end":400,"concept_id":"convulsions","polarity":"therapeutic"},{"start":403,"end":406,"concept_id":"cough","polarity":"therapeutic"},{"start":409,"end":415,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":429,"end":435,"concept_id":"dysuria","polarity":"therapeutic"},{"start":442,"end":447,"concept_id":"edema_dropsy","polarity":"therapeutic"},{"start":464,"end":490,"concept_id":"abortifacient","polarity":"action"},{"start":491,"end":497,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":665,"end":669,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":698,"end":702,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":711,"end":717,"concept_id":"eye_disease","polarity":"therapeutic"}]},"dsc:5.41":{"ref":"De materia medica 5.41","headword":"καὶ ὁ χαμαιδρυίτης","lang":"grc","source":"dioscorides","text":"καὶ ὁ χαμαιδρυίτης ὁμοίως τῷ ὑσσωπίτῃ σκευάζεται, θερμαντικὸς ὢν καὶ διαλυτικός, ἁρμόζων σπασμοῖς, ἰκτέροις, ὑστερῶν πνευματώσεσι, βραδυπεψίαις, ὕδρωπι ἀρχομένῳ. ἀμείνων δὲ παλαιούμενος γίνεται.","spans":[{"start":89,"end":97,"concept_id":"convulsions","polarity":"therapeutic"},{"start":99,"end":104,"concept_id":"jaundice","polarity":"therapeutic"},{"start":109,"end":116,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":117,"end":126,"concept_id":"flatulence","polarity":"therapeutic"},{"start":131,"end":139,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":145,"end":150,"concept_id":"edema_dropsy","polarity":"therapeutic"}]},"cul:138-germander":{"ref":"Culpeper, Complete Herbal: Germander","headword":"Germander","lang":"en","source":"culpeper","text":"It is a most prevalent herb of Mercury, and strengthens the brain and apprehension exceedingly when weak, and relieves them when drooping. This taken with honey (saith Dioscorides) is a remedy for coughs, hardness of the spleen and difficulty of urine, and helps those that are fallen into a dropsy, especially at the beginning of the disease, a decoction being made thereof when it is green, and drank. It also brings down women’s courses, and expels the dead child. It is most effectual against the poison of all serpents, being drank in wine, and the bruised herb outwardly applied; used with honey, it cleanses old and foul ulcers; and made into an oil, and the eyes anointed therewith, takes away the dimness and moistness. It is likewise good for the pains in the sides and cramps. The decoction thereof taken for four days together, drives away and cures both tertain and quartan agues. It is also good against all diseases of the brain, as continual head-ache, falling-sickness, melancholy, drowsiness and dullness of the spirits, convulsions and palsies. A dram of the seed taken in powder purges by urine, and is good against the yellow jaundice. The juice of the leaves dropped into the ears kills the worms in them. The tops thereof, when they are in flowers, steeped twenty-four hours in a draught of white wine, and drank, kills the worms in the belly.","spans":[{"start":197,"end":203,"concept_id":"cough","polarity":"therapeutic"},{"start":221,"end":227,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":232,"end":251,"concept_id":"dysuria","polarity":"therapeutic"},{"start":292,"end":298,"concept_id":"edema_dropsy","polarity":"therapeutic"},{"start":412,"end":439,"concept_id":"amenorrhea","polarity":"action"},{"start":456,"end":466,"concept_id":"labor","polarity":"therapeutic"},{"start":501,"end":507,"concept_id":"poisoning","polarity":"therapeutic"},{"start":515,"end":523,"concept_id":"envenomation","polarity":"therapeutic"},{"start":628,"end":634,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":780,"end":786,"concept_id":"convulsions","polarity":"therapeutic"},{"start":867,"end":874,"concept_id":"malaria","polarity":"therapeutic"},{"start":879,"end":886,"concept_id":"malaria","polarity":"therapeutic"},{"start":958,"end":967,"concept_id":"headache","polarity":"therapeutic"},{"start":969,"end":985,"concept_id":"epilepsy","polarity":"therapeutic"},{"start":999,"end":1009,"concept_id":"delirium","polarity":"therapeutic"},{"start":1014,"end":1037,"concept_id":"memory","polarity":"therapeutic"},{"start":1039,"end":1050,"concept_id":"convulsions","polarity":"therapeutic"},{"start":1055,"end":1062,"concept_id":"paralysis","polarity":"therapeutic"},{"start":1147,"end":1155,"concept_id":"jaundice","polarity":"therapeutic"},{"start":1189,"end":1218,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":1347,"end":1352,"concept_id":"helminthiasis","polarity":"therapeutic"}]}},"images":[]}