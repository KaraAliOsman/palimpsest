c_pair":1,"lift":0.48,"evidence_tier":"sparse"},{"concept_id":"dyspepsia","dsc":1,"cul":0,"persistent":false,"epmc_pair":4,"lift":1.97,"evidence_tier":"sparse"},{"concept_id":"dysuria","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":1.03,"evidence_tier":"sparse"},{"concept_id":"fever","dsc":0,"cul":1,"persistent":false,"epmc_pair":2,"lift":0.45,"evidence_tier":"sparse"},{"concept_id":"flatulence","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":2.26,"evidence_tier":"sparse"},{"concept_id":"helminthiasis","dsc":0,"cul":1,"persistent":false,"epmc_pair":7,"lift":3.42,"evidence_tier":"studied"},{"concept_id":"inflammation","dsc":1,"cul":0,"persistent":false,"epmc_pair":68,"lift":3.38,"evidence_tier":"studied"},{"concept_id":"jaundice","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":0.76,"evidence_tier":"sparse"},{"concept_id":"liver_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":12,"lift":1.36,"evidence_tier":"studied"},{"concept_id":"malaria","dsc":0,"cul":1,"persistent":false,"epmc_pair":2,"lift":0.85,"evidence_tier":"sparse"},{"concept_id":"mouth_gums","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":0.71,"evidence_tier":"sparse"},{"concept_id":"nausea_vomiting","dsc":1,"cul":0,"persistent":false,"epmc_pair":2,"lift":0.85,"evidence_tier":"sparse"},{"concept_id":"pain","dsc":1,"cul":0,"persistent":false,"epmc_pair":13,"lift":0.71,"evidence_tier":"studied"},{"concept_id":"spleen_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":5,"lift":1.09,"evidence_tier":"studied"}],"lead_score":null},"texts":{"dsc:3.64":{"ref":"De materia medica 3.64","headword":"σέλινον κηπαῖον","lang":"grc","source":"dioscorides","text":"σέλινον κηπαῖον· ἁρμόζει ἡ πόα πρὸς ἃ καὶ τὸ κόριον καὶ πρὸς ἀφθαλμῶν φλεγμονὰς μετʼ ἄρτου ἢ πάλης ἀλφίτου καταπλασσόμενον καὶ καῦσον στομάχου παρηγορεῖ μασιούς τε χονδριῶντας ἀνίησι, κινεῖ τε οὗρα ὠμόν τε καὶ ἐφθὸν βρωθέν· καὶ τὸ ἀφέψημα δὲ αὐτοῦ καὶ τῶν ῥιζῶν πινόμενον ἀντιπάσχει θανασίμοις φαρμάκοις καὶ ἐμέτους κινεῖ κοιλίαν τε ἐπέχει. τὸ δὲ σπέρμα ἐστὶν οὐρητικώτερον, βοηθοῦν καὶ θηριοδήκτοις καὶ τοῖς λιθάργυρον πεπωκόσι πνευμάτων τέ ἐστι διαλυτικόν· μείγνυται δὲ καὶ ἀνωδύνοις καὶ θηριακαῖς καὶ βηχικαῖς χρησίμως. καὶ τὸ ἐλεοσέλινον δὲ τὸ γεννώμενον ἐν τοῖς ἐφύδροις τόποις, μεῖζον ὂν τοῦ ἡμέρου] σελίνου, τὰ αὐτὰ δύναται, ὁσαπερ καὶ τὸ κηπευτόν.","spans":[{"start":61,"end":75,"concept_id":"conjunctivitis","polarity":"therapeutic"},{"start":70,"end":77,"concept_id":"inflammation","polarity":"therapeutic"},{"start":184,"end":197,"concept_id":"diuresis","polarity":"action"},{"start":272,"end":280,"concept_id":"poisoning","polarity":"therapeutic"},{"start":283,"end":290,"concept_id":"poisoning","polarity":"therapeutic"},{"start":308,"end":319,"concept_id":"nausea_vomiting","polarity":"action"},{"start":322,"end":339,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":360,"end":367,"concept_id":"diuresis","polarity":"action"},{"start":387,"end":396,"concept_id":"envenomation","polarity":"therapeutic"},{"start":420,"end":425,"concept_id":"poisoning","polarity":"therapeutic"},{"start":476,"end":482,"concept_id":"pain","polarity":"therapeutic"},{"start":490,"end":496,"concept_id":"envenomation","polarity":"therapeutic"},{"start":504,"end":507,"concept_id":"cough","polarity":"therapeutic"}]},"dsc:5.64":{"ref":"De materia medica 5.64","headword":"σελινίτης","lang":"grc","source":"dioscorides","text":"σελινίτης· σελίνου σπέρματος ὡρίμου νέου σεσησμένου ⋖ ο΄ ἐνδήσας εἰς ὀθόνιον βάλε εἰς κεράμιον γλεύκους ὁμοίως. ποιεῖ δὲ ὄρεξιν, καὶ στομαχικοῖς δὲ ἁρμόζει καὶ δυσουροῦσιν· ἐστι δὲ καὶ εὔπνους.","spans":[{"start":121,"end":125,"concept_id":"appetite_loss","polarity":"therapeutic"},{"start":133,"end":141,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":160,"end":166,"concept_id":"dysuria","polarity":"therapeutic"}]},"cul:282-smallage":{"ref":"Culpeper, Complete Herbal: Smallage","headword":"Smallage","lang":"en","source":"culpeper","text":"It is an herb of Mercury. Smallage is hotter, drier, and much more medicinal than parsley, for it much more opens obstructions of the liver and spleen, rarefies thick phlegm, and cleanses it and the blood withal. It provokes urine and women’s courses, and is singularly good against the yellow jaundice, tertian and quartan agues, if the juice thereof be taken, but especially made up into a syrup. The juice also put to honey of roses, and barley-water, is very good to gargle the mouth and throat of those that have sores and ulcers in them, and will quickly heal them. The same lotion also cleanses and heals all other foul ulcers and cankers elsewhere, if they be washed therewith. The seed is especially used to break and expel wind, to kill worms, and to help a stinking breath. The root is effectual to all the purposes aforesaid, and is held to be stronger in operation than the herb, but especially to open obstructions, and to rid away any ague, if the juice thereof be taken in wine, or the decoction thereof in wine used.","spans":[{"start":108,"end":139,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":144,"end":150,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":216,"end":250,"concept_id":"amenorrhea","polarity":"action"},{"start":294,"end":302,"concept_id":"jaundice","polarity":"therapeutic"},{"start":304,"end":311,"concept_id":"malaria","polarity":"therapeutic"},{"start":316,"end":323,"concept_id":"malaria","polarity":"therapeutic"},{"start":518,"end":523,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":528,"end":534,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":627,"end":633,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":638,"end":645,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":717,"end":737,"concept_id":"flatulence","polarity":"action"},{"start":747,"end":752,"concept_id":"helminthiasis","polarity":"therapeutic"},{"start":768,"end":783,"concept_id":"mouth_gums","polarity":"therapeutic"},{"start":950,"end":954,"concept_id":"fever","polarity":"therapeutic"}]}},"images":["selinon-kepaion-306r-dioscoride-vienne"]}