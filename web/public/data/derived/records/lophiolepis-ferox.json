{"slug":"lophiolepis-ferox","plant":{"taxon":"Lophiolepis ferox","family":"Asteraceae","rank":"species","gbif_key":12218806,"wikidata":"Q123095679","iucn":null,"gbif_occurrences":3112,"common_name":"white thorn (a thistle)","names":[{"source":"dioscorides","name":"ἄκανθα λευκή","monograph_id":"dsc:3.12","confidence":"low","note":"Sea-urchin-like spiny head, purple flowers; Berendes Cnicus ferox (= Cirsium/Lophiolepis ferox), others Cnicus acarna; uncertain."}],"n_compounds":0,"top_compounds":[],"epmc_total":0,"trials":0,"claims":[{"concept_id":"envenomation","dsc":2,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"convulsions","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"diarrhea","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"diuresis","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"dyspepsia","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"hemoptysis","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"inflammation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"toothache","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:3.12":{"ref":"De materia medica 3.12","headword":"ἄκανθα λευκή","lang":"grc","source":"dioscorides","text":"ἄκανθα λευκή· φύεται ἐν ὄρεσι καὶ ὑλώδεσι τόποις φύλλα ἔχουσα χαμαιλέοντι ἐμφερῆ λευκῷ, στενώτερα δὲ καὶ λευκότερα, ὑποδασέα καὶ ἀκανθώδη, καυλὸν ὑπὲρ δύο πήχεις, δακτύλου τοῦ μεγάλου ἢ καὶ μεῖζον πάχος, ὑπόλευκον, κενόν· ἐπʼ ἄκρου δὲ αὐτοῦ κεφαλὴ πρόσεστιν ἀκανθώδης, ἐχίνῳ θαλασσίῳ ἐμφερής, πλὴν ἐλάσσων καὶ ὑπομήκης, ἄνθη πορφυρᾶ, ἐν οἷς τὸ σπέρμα ὡς κνῆκος, στρογγυλώτερον δέ. 2 ταύτης ἡ ῥίζα πινομένη ποιεῖ πρὸς αἱμοπτυῖκούς, στομαχικούς, κοιλιακοὺς οὖρά τε κινεῖ καταπλάσσεταί τε πρὸς οἰδήματα· καὶ τὸ ἀφέψημα δὲ αὐτῆς πρὸς ὀδονταλγίας ποιεῖ διακλυζόμενον, τὸ δὲ σπέρμα πινόμενον παιδίοις σπωμένοις βοηθεῖ καὶ ἑρπετοδήκτοις. φασὶ δʼ ὅτι περίαπτον ἐξ αὐτοῦ θηρία διώκει.","spans":[{"start":417,"end":423,"concept_id":"hemoptysis","polarity":"therapeutic"},{"start":431,"end":439,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":444,"end":451,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":455,"end":468,"concept_id":"diuresis","polarity":"action"},{"start":491,"end":496,"concept_id":"inflammation","polarity":"therapeutic"},{"start":530,"end":538,"concept_id":"toothache","polarity":"therapeutic"},{"start":595,"end":601,"concept_id":"convulsions","polarity":"therapeutic"},{"start":616,"end":626,"concept_id":"envenomation","polarity":"therapeutic"},{"start":662,"end":672,"concept_id":"envenomation","polarity":"action"}]}},"images":[]}