{"slug":"sisymbrium-polyceratium","plant":{"taxon":"Sisymbrium polyceratium","family":"Brassicaceae","rank":"species","gbif_key":3046899,"wikidata":"Q15549260","iucn":null,"gbif_occurrences":1912,"common_name":"many-podded hedge mustard","names":[{"source":"dioscorides","name":"ἐρύσιμον","monograph_id":"dsc:2.158","confidence":"medium","note":"Berendes: Sisymbrium polyceratium or S. irio; urban weed with horn-like pods, yellow flowers."}],"n_compounds":0,"top_compounds":[],"epmc_total":0,"trials":0,"claims":[{"concept_id":"abscess","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"cancer","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"cough","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"inflammation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"jaundice","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"pleurisy_pneumonia","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"poisoning","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"sciatica","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:2.158":{"ref":"De materia medica 2.158","headword":"ἐρύσιμον","lang":"grc","source":"dioscorides","text":"ἐρύσιμον· φύεται μὲν περὶ τὰς πόλεις καὶ οἰκόπεδα καὶ ἐν κήποις· φύλλα δὲ ὅμοια εὐζώμῳ ἀγρίῳ ἔχει, καυλία ἱμαντώδη, ἄνθη μηλίζοντα· ἐπ᾿ ἄκρων δὲ λοβοὶ κερατοειδεῖς, ἰσχνοί, ὡς τήλιδος, ἐν οἷς σπερμάτια μικρά, καρδάμῳ παραπλήσια, πυρώδη κατὰ τὴν γεῦσιν, ποιοῦντα πρὸς θώρακος ῥευματισμόν, ἐμπύους, βῆχας, ἴκτερον, ἰσχιάδα ἐκλειχόμενα σὺν μέλιτι· πένεται καὶ πρὸς τὰ θανάσιμα φάρμακα. καταπλασσόμενον δὲ μεθ᾿ ὕδατος ἢ μέλιτος ὠφελεῖ καρκινώματα κρυπτά, σκληρίας, παρωτίδας, διδύμων καὶ μαστῶν φλεγμονάς, λεπτύνει τε καθ᾿ ὅλου καὶ θερμαίνει. ἐπιεικέστερον δὲ γίνεται εἰς τὰ ἐκλείγματα, ἀποβραχὲν ὕδατι καὶ φωχθὲν ἢ ἐνδεθὲν εἰς ὀθόνιον καὶ ὀπτηθὲν στέατος περιπλασθέντος.","spans":[{"start":288,"end":295,"concept_id":"pleurisy_pneumonia","polarity":"therapeutic"},{"start":297,"end":300,"concept_id":"cough","polarity":"therapeutic"},{"start":304,"end":309,"concept_id":"jaundice","polarity":"therapeutic"},{"start":313,"end":319,"concept_id":"sciatica","polarity":"therapeutic"},{"start":365,"end":372,"concept_id":"poisoning","polarity":"therapeutic"},{"start":431,"end":439,"concept_id":"cancer","polarity":"therapeutic"},{"start":461,"end":468,"concept_id":"abscess","polarity":"therapeutic"},{"start":491,"end":498,"concept_id":"inflammation","polarity":"therapeutic"}]}},"images":[]}