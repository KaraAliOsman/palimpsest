47,"evidence_tier":"studied"},{"concept_id":"scaly_skin","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.17,"evidence_tier":"unstudied"},{"concept_id":"sciatica","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.32,"evidence_tier":"unstudied"},{"concept_id":"scrofula","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.34,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.37,"evidence_tier":"unstudied"},{"concept_id":"spleen_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":0.21,"evidence_tier":"sparse"}],"lead_score":null},"texts":{"dsc:2.109":{"ref":"De materia medica 2.109","headword":"θέρμος ὁ ἥμερος","lang":"grc","source":"dioscorides","text":"θέρμος ὁ ἥμερος γνώριμος, οὖ τὸ ἄλευρον σὺν μέλιτι ἐκλειχόμενον ἢ μετὰ ἄξους πινόμενον ἔλμινθας φθείρει. καὶ αὐτοὶ δὲ ἀποβραχέντες καὶ ἔμπικροι ἐσθιόμενοι τὸ αὐτὸ δρῶσι, καὶ τὸ ἀφέψημα ⟨δὲ〉 αὐτῶν τὸ αὐτὸ ποιεῖ μετὰ πηγάνου ποθὲν καὶ πεπέρεως, καὶ σπληνικούς ὠφελεῖ, ἐπάντλημά τε γαγγραίνης, θηριωμάτων, ψώρας ἀρχομένης, ἀλφῶν, σπίλων, ἐξανθημάτων, ἀχώρων· τὸ δʼ αὐτὸ καὶ καταμηνίων καὶ ἐμβρύων ἐπισπαστικὸν μετὰ θμύρνης καὶ μέλιτος ἐν προσθέτῳ. καθαίρει δὲ τὸ ἄλευρον χρῶτα καὶ πελιώματα, καὶ φλεγμονὰς πραύνει σὺν ὕδατι καὶ ἀλφίτῳ, σὺν ὄξει δὲ ἰσχιάδας παρηγορεῖ καὶ φύματα. χοιράδας δὲ μεταβάλλει ἑψηθεὶς ἐν ὄξει καὶ καταπλασθεὶς καὶ ἄνθρακας περιρρήσσει. μεθʼ ὕδατος δὲ ὀμβρίου ἑψηθέντες οἱ θέρμοι ἄχρι χυλώσεως πρόσωπον σμήχουσι, μετὰ δὲ χαμαιλέοντος ῥίζης τοῦ μέλανος ἑψηθέντες προβάτων ψώρας ἰῶνται ἐκλελουμένων τῳ ἀφεψήματι χλιαρῷ. ἡ δὲ ῥίζα ἑψηθεῖσα σὺν ὕδατι καὶ ποθεῖσα οὔρησιν κινεῖ, οἱ δὲ ἀπογλυκανθέντες λεῖοι σὺν ὄξει ποθέντες στομάχου ἄσην πραύνουσι καὶ ἀνορεξίαν ἰῶνται. γίνεται δὲ καὶ ἄγριος θέρμος, ἐμφερὴς τῷ ἡμέρῳ κατὰ πάντα, μικρότερος δέ, ποιῶν ὅσα καὶ ὁ ἥμερος.","spans":[{"start":87,"end":93,"concept_id":"helminthiasis","polarity":"therapeutic"},{"start":247,"end":257,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":279,"end":287,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":291,"end":297,"concept_id":"cancer","polarity":"therapeutic"},{"start":303,"end":308,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":320,"end":325,"concept_id":"scaly_skin","polarity":"therapeutic"},{"start":327,"end":333,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":335,"end":342,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":348,"end":352,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":371,"end":406,"concept_id":"amenorrhea","polarity":"action"},{"start":478,"end":484,"concept_id":"bruises","polarity":"therapeutic"},{"start":493,"end":500,"concept_id":"inflammation","polarity":"therapeutic"},{"start":545,"end":551,"concept_id":"sciatica","polarity":"therapeutic"},{"start":568,"end":574,"concept_id":"abscess","polarity":"therapeutic"},{"start":576,"end":582,"concept_id":"scrofula","polarity":"therapeutic"},{"start":636,"end":644,"concept_id":"abscess","polarity":"therapeutic"},{"start":715,"end":728,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":792,"end":797,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":880,"end":887,"concept_id":"diuresis","polarity":"action"},{"start":969,"end":975,"concept_id":"appetite_loss","polarity":"therapeutic"}]}},"gloss":{"dsc:2.109":{"87":"intestinal worms (ἕλμινθες)","247":"the spleen / spleen patients (σπληνικοί)","279":"gangrene (γάγγραινα)","291":"malignant ulcers (θηριώματα)","303":"itch, scabies (ψώρα)","320":"alphos (white scaly patches)","327":"spots (σπίλοι)","335":"eruptions (ἐξανθήματα)","348":"scurf of the scalp (ἀχῶρες)","371":"brings on the menses (emmenagogue)","478":"livid bruises (πελιώματα)","493":"inflammations (φλεγμοναί)","545":"sciatica (ἰσχιάς)","568":"tumours, inflamed swellings (φύματα)","576":"scrofulous glands (χοιράδες)","636":"carbuncles (ἄνθρακες)","715":"cleanses / brightens the face","792":"itch, scabies (ψώρα)","880":"urination (οὔρησις, ἐξουρεῖν)","969":"loss of appetite (ἀνορεξία, ἀνόρεκτοι)"}},"images":[]}