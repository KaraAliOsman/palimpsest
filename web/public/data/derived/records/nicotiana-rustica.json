rsistent":false,"epmc_pair":0,"lift":0.91,"evidence_tier":"unstudied"},{"concept_id":"gout","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":1.69,"evidence_tier":"sparse"},{"concept_id":"headache","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.39,"evidence_tier":"unstudied"},{"concept_id":"heart","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.07,"evidence_tier":"unstudied"},{"concept_id":"helminthiasis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.48,"evidence_tier":"unstudied"},{"concept_id":"itch_scabies","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.69,"evidence_tier":"unstudied"},{"concept_id":"kidney_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.17,"evidence_tier":"unstudied"},{"concept_id":"lice","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":2.3,"evidence_tier":"sparse"},{"concept_id":"mouth_gums","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":1.48,"evidence_tier":"sparse"},{"concept_id":"pain","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.08,"evidence_tier":"unstudied"},{"concept_id":"poisoning","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":1.03,"evidence_tier":"sparse"},{"concept_id":"sciatica","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":2.04,"evidence_tier":"sparse"},{"concept_id":"scrofula","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.7,"evidence_tier":"unstudied"},{"concept_id":"toothache","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.58,"evidence_tier":"unstudied"},{"concept_id":"urolithiasis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.73,"evidence_tier":"unstudied"},{"concept_id":"uterine_disorders","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.21,"evidence_tier":"unstudied"},{"concept_id":"wounds","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":0.59,"evidence_tier":"sparse"}],"lead_score":null},"texts":{"cul:294-english-tobacco":{"ref":"Culpeper, Complete Herbal: English Tobacco","headword":"English Tobacco","lang":"en","source":"culpeper","text":"It is a martial plant. It is found by good experience to be available to expectorate tough phlegm from the stomach, chest, and lungs. The juice thereof made into a syrup, or the distilled water of the herb drank with some sugar, or without, if you will, or the smoak taken by a pipe, as is usual, but fainting, helps to expel worms in the stomach and belly, and to ease the pains in the head, or megrim, and the griping pains in the bowels. It is profitable for those that are troubled with the stone in the kidneys, both to ease the pains by provoking urine, and also to expel gravel and the stone engendered therein, and hath been found very effectual to expel windiness, and other humours, which cause the strangling of the mother. The seed hereof is very effectual to expel the tooth ache, and the ashes of the burnt herb to cleanse the gums, and make the teeth white. The herb bruised and applied to the place grieved with the king’s evil, helps it in nine or ten days effectually. Monardus saith, it is a counter poison against the biting of any venomous creature, the herb also being outwardly applied to the hurt place. The distilled water is often given with some sugar before the fit of an ague, to lessen it, and take it away in three or four times using. If the distilled fæces of the herb, having been bruised before the distillation, and not distilled dry, be set in warm dung for fourteen days, and afterwards be hung in a bag in a wine cellar, the liquor that distills therefrom is singularly good to use in cramps, aches, the gout and sciatica, and to heal itches, scabs, and running ulcers, cankers, and all foul sores whatsoever. The juice is also good for all the said griefs, and likewise to kill lice in children’s heads. The green herb bruised and applied to any green wounds, cures any fresh wound or cut whatsoever: and the juice put into old sores, both cleanses and heals them. There is also made hereof a singularly good salve to help imposthumes, hard tumours, and other swellings by blows and falls.","spans":[{"start":73,"end":84,"concept_id":"cough","polarity":"action"},{"start":301,"end":309,"concept_id":"heart","polarity":"therapeutic"},{"start":326,"end":331,"concept_id":"helminthiasis","polarity":"therapeutic"},{"start":374,"end":391,"concept_id":"headache","polarity":"therapeutic"},{"start":396,"end":402,"concept_id":"headache","polarity":"therapeutic"},{"start":412,"end":419,"concept_id":"colic","polarity":"therapeutic"},{"start":420,"end":439,"concept_id":"colic","polarity":"therapeutic"},{"start":495,"end":500,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":508,"end":515,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":543,"end":558,"concept_id":"diuresis","polarity":"action"},{"start":578,"end":584,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":593,"end":598,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":657,"end":672,"concept_id":"flatulence","polarity":"action"},{"start":723,"end":733,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":782,"end":792,"concept_id":"toothache","polarity":"therapeutic"},{"start":841,"end":845,"concept_id":"mouth_gums","polarity":"therapeutic"},{"start":932,"end":943,"concept_id":"scrofula","polarity":"therapeutic"},{"start":1011,"end":1025,"concept_id":"poisoning","polarity":"therapeutic"},{"start":1038,"end":1047,"concept_id":"envenomation","polarity":"therapeutic"},{"start":1052,"end":1060,"concept_id":"envenomation","polarity":"therapeutic"},{"start":1200,"end":1204,"concept_id":"fever","polarity":"therapeutic"},{"start":1524,"end":1530,"concept_id":"convulsions","polarity":"therapeutic"},{"start":1532,"end":1537,"concept_id":"pain","polarity":"therapeutic"},{"start":1543,"end":1547,"concept_id":"gout","polarity":"therapeutic"},{"start":1552,"end":1560,"concept_id":"sciatica","polarity":"therapeutic"},{"start":1574,"end":1580,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":1582,"end":1587,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":1601,"end":1607,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":1609,"end":1616,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":1631,"end":1636,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":1718,"end":1722,"concept_id":"lice","polarity":"therapeutic"},{"start":1792,"end":1798,"concept_id":"wounds","polarity":"therapeutic"},{"start":1816,"end":1821,"concept_id":"wounds","polarity":"therapeutic"},{"start":1868,"end":1873,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":1963,"end":1974,"concept_id":"abscess","polarity":"therapeutic"},{"start":1976,"end":1988,"concept_id":"cancer","polarity":"therapeutic"},{"start":2013,"end":2028,"concept_id":"bruises","polarity":"therapeutic"}]}},"gloss":{"cul:294-english-tobacco":{"73":"expectorates tough phlegm: expectorant","301":"faintings, fainting spirits","326":"worms (intestinal)","374":"pains in the head","396":"megrim: migraine","412":"gripings: colicky abdominal pains","420":"pains in the belly / bowels","495":"the stone (urinary calculus)","508":"kidneys","543":"provokes urine: diuretic","578":"gravel: small urinary concretions","593":"the stone (urinary calculus)","657":"expels / breaks wind (carminative)","723":"the mother: the womb (fits, rising, suffocation, pains of the mother)","782":"tooth-ache","841":"gums (sore, spongy, bleeding)","932":"king's evil: scrofula","1011":"counter-poison","1038":"biting / stinging of (serpents, scorpions, beasts)","1052":"venomous beasts / creatures","1200":"agues: intermittent fevers","1524":"cramp, cramps","1532":"aches (unlocalised)","1543":"gout","1552":"sciatica","1574":"itch, itches, itching","1582":"scabs: scabies / scabby skin","1601":"ulcers (old, foul, running, fretting)","1609":"canker: spreading / eating ulcer","1631":"sores, running sores","1718":"lice","1792":"wounds (green, fresh, inward, old); wound-herb","1816":"wounds (green, fresh, inward, old); wound-herb","1868":"sores, running sores","1963":"imposthume: abscess","1976":"hard swellings / tumours / knots (scirrhus)","2013":"swellings / marks by blows or falls"}},"images":[]}