0.97,"evidence_tier":"unstudied"},{"concept_id":"epilepsy","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.97,"evidence_tier":"unstudied"},{"concept_id":"gout","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"kidney_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.94,"evidence_tier":"unstudied"},{"concept_id":"labor","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.98,"evidence_tier":"unstudied"},{"concept_id":"poisoning","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.98,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"urolithiasis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"uterine_disorders","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.95,"evidence_tier":"unstudied"},{"concept_id":"wounds","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.95,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"cul:195-masterwort":{"ref":"Culpeper, Complete Herbal: Masterwort","headword":"Masterwort","lang":"en","source":"culpeper","text":"It is an herb of Mars. The root of Masterwort is hotter than pepper, and very available in cold griefs and diseases both of the stomach and body, dissolving very powerfully upwards and downwards. It is also used in a decoction with wine against all cold rheums, distillations upon the lungs, or shortness of breath, to be taken morning and evening. It also provokes urine, and helps to break the stone, and expel the gravel from the kidneys; provokes women’s courses, and expels the dead birth. It is singularly good for strangling of the mother, and other such like feminine diseases. It is effectual also against the dropsy, cramps, and falling sickness; for the decoction in wine being gargled in the mouth, draws down much water and phlegm, from the brain, purging and easing it of what oppresses it. It is of a rare quality against all sorts of cold poison, to be taken as there is cause; it provokes sweat. But lest the taste hereof, or of the seed (which works to the like effect, though not so powerfully) should be too offensive, the best way is to take the water distilled both from the herb and root. The juice hereof dropped, or tents dipped therein, and applied either to green wounds or filthy rotten ulcers, and those that come by envenomed weapons, doth soon cleanse and heal them. The same is also very good to help the gout coming of a cold cause.","spans":[{"start":107,"end":135,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":254,"end":260,"concept_id":"common_cold","polarity":"therapeutic"},{"start":262,"end":275,"concept_id":"common_cold","polarity":"therapeutic"},{"start":295,"end":314,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":357,"end":371,"concept_id":"diuresis","polarity":"action"},{"start":396,"end":401,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":417,"end":423,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":433,"end":440,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":442,"end":466,"concept_id":"amenorrhea","polarity":"action"},{"start":483,"end":493,"concept_id":"labor","polarity":"therapeutic"},{"start":535,"end":545,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":619,"end":625,"concept_id":"edema_dropsy","polarity":"therapeutic"},{"start":627,"end":633,"concept_id":"convulsions","polarity":"therapeutic"},{"start":639,"end":655,"concept_id":"epilepsy","polarity":"therapeutic"},{"start":855,"end":861,"concept_id":"poisoning","polarity":"therapeutic"},{"start":1191,"end":1197,"concept_id":"wounds","polarity":"therapeutic"},{"start":1215,"end":1221,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":1337,"end":1341,"concept_id":"gout","polarity":"therapeutic"}]}},"gloss":{"cul:195-masterwort":{"107":"pains / gnawing / heat of the stomach","254":"rheum, thin rheums: catarrhal discharge","262":"distillation / defluxion of rheum from the head: catarrh","295":"shortness of breath: dyspnoea","357":"provokes urine: diuretic","396":"the stone (urinary calculus)","417":"gravel: small urinary concretions","433":"kidneys","442":"provokes / brings down the terms, courses: emmenagogue","483":"expels the dead child / dead birth","535":"the mother: the womb (fits, rising, suffocation, pains of the mother)","619":"dropsy, dropsies","627":"cramp, cramps","639":"falling sickness: epilepsy","855":"resists / expels poison","1191":"wounds (green, fresh, inward, old); wound-herb","1215":"ulcers (old, foul, running, fretting)","1337":"gout"}},"images":[]}