,{"concept_id":"itch_scabies","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":2.38,"evidence_tier":"sparse"},{"concept_id":"kidney_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.27,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.83,"evidence_tier":"unstudied"},{"concept_id":"wounds","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.3,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:3.33":{"ref":"De materia medica 3.33","headword":"ἐλελίσφακον","lang":"grc","source":"dioscorides","text":"ἐλελίσφακον· οἱ δὲ ἐλαφοβόσκον, οἱ δὲ σφάγνον. θάμνος ἐστὶν ἐπιμήκης, πολύκλωνος, ῥάβδους τετραγώνους καὶ ὑπολεύκους ἔχων, φύλλα δὲ μηλέᾳ κυδωνίᾳ ἐοικότα, ἐπιμηκέστερα δὲ καὶ μικρότερα καὶ τραχέα λεληθότως ὥσπερ τὰ ἀνάτριπτα τῶν ἱματίων, δασέα, ὑπόλευκα, σφοδρῶς εὐώδη, ἔμβρωμα· καπτὸν δὲ ἐπʼ ἄκρων τῶν καυλῶν ὥσπερ ὁρμίνου ἀγρίου ἔχει. φύεται δὲ ἐν τραχέσι χωρίοις . δύναμιν δὲ ἔχει τὸ ἀφέψημα τῶν φύλλων καὶ τῶν κλάδων οὖρα ἄγειν πινόμενον καὶ ἔμμηνα καὶ ἔμβρυα κατασπᾶν καὶ τρυγόνος πληγαῖς ἀρήγειν μελαίνει δὲ καὶ τρίχας καὶ τραυματικὴ καὶ ἴσχαιμος καὶ ἀποκαθαρτικὴ τῶν θηριωδῶν ἑλκῶν ἐστι. παύει δὲ σὺν οἴνῳ τὸ ἀφέψημα τῶν φύλλων καὶ τῶν κλάδων αὐτῆς προσκλυζόμενον κνησμούς τοὺς περὶ τὰ αἰδοῖα.","spans":[{"start":421,"end":430,"concept_id":"diuresis","polarity":"action"},{"start":426,"end":463,"concept_id":"abortifacient","polarity":"action"},{"start":446,"end":472,"concept_id":"amenorrhea","polarity":"action"},{"start":477,"end":490,"concept_id":"envenomation","polarity":"therapeutic"},{"start":529,"end":535,"concept_id":"wounds","polarity":"therapeutic"},{"start":544,"end":550,"concept_id":"hemorrhage","polarity":"therapeutic"},{"start":583,"end":588,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":671,"end":676,"concept_id":"itch_scabies","polarity":"therapeutic"}]},"dsc:5.61":{"ref":"De materia medica 5.61","headword":"ἐλελισφακίτης ὁμοίως","lang":"grc","source":"dioscorides","text":"ἐλελισφακίτης ὁμοίως· ἐλελισφάκου ⋖ ο´ εἰς γλεύκους ἀμφορέα, ὅ ἐστι κεράμιον, κάθες. ποιεῖ δὲ πρὸς νεφρῶν πόνους καὶ κύστεως καὶ πλευρῶν, αἵματος ἀναγωγάς, βηχί, ῥήγμασι, σπάσμασι, θλάσμασιν, ἐμμήνοις ἐστεγνωμένοις.","spans":[{"start":99,"end":105,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":117,"end":124,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":138,"end":152,"concept_id":"hemoptysis","polarity":"therapeutic"},{"start":156,"end":159,"concept_id":"cough","polarity":"therapeutic"},{"start":162,"end":166,"concept_id":"bruises","polarity":"therapeutic"},{"start":171,"end":178,"concept_id":"convulsions","polarity":"therapeutic"},{"start":181,"end":186,"concept_id":"bruises","polarity":"therapeutic"}]}},"gloss":{"dsc:3.33":{"421":"moves the urine","426":"expels ... the embryo","446":"brings on the menses (emmenagogue)","477":"stings / bites of scorpions, spiders, sting-rays, wasps, bees","529":"wounds (τραύματα)","544":"styptic (ἴσχαιμος)","583":"ulcers (ἕλκη, ἑλκώσεις)","671":"itching (κνησμός)"},"dsc:5.61":{"99":"kidneys / nephritics (νεφριτικοί)","117":"bladder (κύστις)","138":"bringing up / spitting of blood","156":"cough (βήξ, βήσσοντες)","162":"ruptures, strains (ῥήγματα)","171":"spasms, strains (σπάσματα)","181":"contusions (θλάσματα)"}},"images":[]}