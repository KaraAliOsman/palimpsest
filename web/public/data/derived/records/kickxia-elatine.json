ς καὶ ἐργασίμοις τόποις. δύναμιν δὲ ἔχει τά φύλλα καταπλασσόμενα σὺν ἀλφίτοις φλεγμαίνοντας καὶ ῥευματιζομένους ὀφθαλμοὺς ὠφελεῖν· ἑψηθεῖσα δὲ καὶ ῥοφουμένη δυσεντερίας ἵστησιν.","spans":[{"start":279,"end":287,"concept_id":"inflammation","polarity":"therapeutic"},{"start":297,"end":319,"concept_id":"conjunctivitis","polarity":"therapeutic"},{"start":358,"end":366,"concept_id":"dysentery","polarity":"therapeutic"}]}},"images":[]}