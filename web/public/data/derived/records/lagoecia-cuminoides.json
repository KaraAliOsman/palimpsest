δατι, σὺν ὄξει δὲ λυγμούς παύει, πρὸς δὲ τὰ ἰοβόλα καὶ πλάδον στομάχου σὺν οἴνῳ· αἴρει δὲ καὶ ὑπώπια μασηθὲν καὶ καταπλασθὲν σύν μέλιτι καὶ σταφίδι, φλεγμονάς τε διδύμων ἰᾶται μετὰ τῶν αὐτῶν καταπλασσόμενον.","spans":[{"start":355,"end":363,"concept_id":"colic","polarity":"therapeutic"},{"start":368,"end":379,"concept_id":"flatulence","polarity":"therapeutic"},{"start":406,"end":410,"concept_id":"hiccup","polarity":"therapeutic"},{"start":432,"end":437,"concept_id":"envenomation","polarity":"therapeutic"},{"start":482,"end":486,"concept_id":"bruises","polarity":"therapeutic"},{"start":537,"end":544,"concept_id":"inflammation","polarity":"therapeutic"}]}},"images":[]}