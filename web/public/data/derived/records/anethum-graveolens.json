tier":"sparse"},{"concept_id":"fever","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":0.41,"evidence_tier":"sparse"},{"concept_id":"hemorrhoids","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.81,"evidence_tier":"unstudied"},{"concept_id":"insomnia","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":0.35,"evidence_tier":"sparse"},{"concept_id":"joint_pain","dsc":1,"cul":0,"persistent":false,"epmc_pair":3,"lift":0.69,"evidence_tier":"sparse"},{"concept_id":"lactation","dsc":1,"cul":0,"persistent":false,"epmc_pair":2,"lift":1.7,"evidence_tier":"sparse"},{"concept_id":"malaria","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.25,"evidence_tier":"unstudied"},{"concept_id":"sexual_function","dsc":1,"cul":0,"persistent":false,"epmc_pair":2,"lift":2.35,"evidence_tier":"sparse"},{"concept_id":"skin_ulcers","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.58,"evidence_tier":"unstudied"}],"lead_score":0.5486},"texts":{"dsc:1.51":{"ref":"De materia medica 1.51","headword":"ἀνηθίνου σκευασία","lang":"grc","source":"dioscorides","text":"ἀνηθίνου σκευασία· ἐλαίου λίτρας ὀκτὼ οὐγγίας ἐννέα, ἀνήθου ἄνθους λίτρας ἕνδεκα οὐγγίας ὀκτὼ ἐναπόβρεχε τῷ ἐλαίῳ ἡμέραν μίαν, εἶτα ἐκπίεζε ταῖς χερσὶ καὶ ἀποτίθεσο. ἐὰν δὲ θέλῃς δίβροχον ποιῆσαι, πρόσφατον ἀνήθου ἄνθος ὡσαύτως ἀπόβρεχε. δύναται δὲ μαλάσσειν τὰ περὶ μήτραν καὶ ἀναστομοῦν, ἁρμόζον πρὸς τὰ περιοδικὰ ῥίγη, θερμαῖνον καὶ κόπους λύον καὶ ἀλγήματα ἄρθρων ὠφελοῦν.","spans":[{"start":267,"end":273,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":306,"end":312,"concept_id":"malaria","polarity":"therapeutic"},{"start":316,"end":320,"concept_id":"fever","polarity":"therapeutic"},{"start":352,"end":365,"concept_id":"joint_pain","polarity":"therapeutic"}]},"dsc:3.58":{"ref":"De materia medica 3.58","headword":"ἀνήθου ξηροῦ τῆς","lang":"grc","source":"dioscorides","text":"ἀνήθου ξηροῦ τῆς κόμης καὶ τοῦ καρποῦ τὸ ἀφέψημα πινόμενον γάλα κατασπᾷ, στρόφους τε καὶ ἐμπνευματώσεις παύει, κοιλίαν τε καὶ τοὺς ἐπιπολαίους ἐμέτους ἵστησιν, οὖρά τε κινεῖ καὶ λυγμοὺς παρηγορεῖ, ἀμβλύνει τε τὰς ὄψεις καὶ γονὴν σβέννυσι συνεχῶς πινόμενον. χρήσιμον δὲ τὸ ἀφέψημα αὐτοῦ καὶ γυναιξὶν ὑστερικαῖς εἰς ἐγκάθισμα· τὸ δὲ σπέρμα καὲν καὶ καταπλασθὲν κονδυλώματα αἴρει.","spans":[{"start":59,"end":70,"concept_id":"lactation","polarity":"action"},{"start":73,"end":81,"concept_id":"colic","polarity":"therapeutic"},{"start":89,"end":100,"concept_id":"flatulence","polarity":"therapeutic"},{"start":143,"end":155,"concept_id":"nausea_vomiting","polarity":"therapeutic"},{"start":160,"end":173,"concept_id":"diuresis","polarity":"action"},{"start":178,"end":182,"concept_id":"hiccup","polarity":"therapeutic"},{"start":223,"end":228,"concept_id":"sexual_function","polarity":"action"},{"start":299,"end":306,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":359,"end":367,"concept_id":"hemorrhoids","polarity":"therapeutic"}]},"cul:102-dill":{"ref":"Culpeper, Complete Herbal: Dill","headword":"Dill","lang":"en","source":"culpeper","text":"Mercury has the dominion of this plant, and therefore to be sure it strengthens the brain. The Dill being boiled and drank, is good to ease swellings and pains; it also stays the belly and stomach from casting. The decoction therefore helps women that are troubled with the pains and windiness of the mother, if they sit therein. It stays the hiccough, being boiled in wine, and but smelled unto being tied in a cloth. The seed is of more use than the leaves, and more effectual to digest raw and vicious humours, and is used in medicines that serve to expel wind, and the pains proceeding therefrom. The seed, being roasted or fried, and used in oils or plasters, dissolve the imposthumes in the fundament; and dries up all moist ulcers, especially in the fundament; an oil made of Dill is effectual to warm or dissolve humours and imposthumes, and the pains, and to procure rest. The decoction of Dill, be it herb or seed (only if you boil the seed you must bruise it) in white wine, being drank, it is a gallant expeller of wind, and provoker of the terms.","spans":[{"start":154,"end":159,"concept_id":"pain","polarity":"therapeutic"},{"start":202,"end":209,"concept_id":"nausea_vomiting","polarity":"therapeutic"},{"start":297,"end":307,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":343,"end":351,"concept_id":"hiccup","polarity":"therapeutic"},{"start":553,"end":563,"concept_id":"flatulence","polarity":"action"},{"start":678,"end":689,"concept_id":"abscess","polarity":"therapeutic"},{"start":731,"end":737,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":833,"end":844,"concept_id":"abscess","polarity":"therapeutic"},{"start":854,"end":859,"concept_id":"pain","polarity":"therapeutic"},{"start":868,"end":880,"concept_id":"insomnia","polarity":"action"},{"start":1015,"end":1031,"concept_id":"flatulence","polarity":"action"},{"start":1037,"end":1058,"concept_id":"amenorrhea","polarity":"action"}]}},"gloss":{"dsc:1.51":{"267":"the womb (ὑστέρα, μήτρα)","306":"periodic fevers (περίοδοι)","316":"rigors (ῥίγη)","352":"pains / swellings of the joints"},"dsc:3.58":{"59":"draws down / produces / dries up milk","73":"gripes (στρόφοι)","89":"flatulence (ἐμπνευμάτωσις)","143":"vomiting ... checks","160":"moves the urine","178":"hiccup (λυγμός)","223":"semen (γονή)","299":"hysterical suffocation (πνὶξ ὑστερική)","359":"anal condylomata (κονδυλώματα)"},"cul:102-dill":{"154":"pains (unlocalised): analgesic","202":"casting: vomiting","297":"the mother: the womb (fits, rising, suffocation, pains of the mother)","343":"hiccough: hiccup","553":"expels / breaks wind (carminative)","678":"imposthume: abscess","731":"ulcers (old, foul, running, fretting)","833":"imposthume: abscess","854":"pains (unlocalised): analgesic","868":"procures rest and sleep: soporific","1015":"expels / breaks wind (carminative)","1037":"provokes / brings down the terms, courses: emmenagogue"}},"images":["wiener-dioskurides-anethon"]}