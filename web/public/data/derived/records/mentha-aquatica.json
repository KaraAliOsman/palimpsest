ὲ πρὸς στραγγουρίας καὶ λιθιάσεις σὺν οἴνῳ πινόμενον τὸ σπέρμα καὶ στρόφους καὶ λυγμούς παύει. τὰ δὲ φύλλα καταπλάσσεται πρὸς κεφαλαλγίαν ἐπὶ τῶν κροτάφων καὶ τοῦ μετώπου πρός τε σφηκῶν πληγὰς καὶ μελισσῶν· ἵστησι δὲ καὶ ἐμέτους ποθέν.","spans":[{"start":181,"end":190,"concept_id":"dysuria","polarity":"therapeutic"},{"start":198,"end":204,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":241,"end":249,"concept_id":"colic","polarity":"therapeutic"},{"start":254,"end":258,"concept_id":"hiccup","polarity":"therapeutic"},{"start":300,"end":311,"concept_id":"headache","polarity":"therapeutic"},{"start":353,"end":364,"concept_id":"envenomation","polarity":"therapeutic"},{"start":381,"end":402,"concept_id":"nausea_vomiting","polarity":"therapeutic"}]}},"images":[]}