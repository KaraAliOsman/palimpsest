{"slug":"ribes-uva-crispa","plant":{"taxon":"Ribes uva-crispa","family":"Grossulariaceae","rank":"species","gbif_key":2986185,"wikidata":"Q41503","iucn":null,"gbif_occurrences":234671,"common_name":"Gooseberry","names":[{"source":"culpeper","name":"Gooseberry Bush","monograph_id":"cul:143-gooseberry-bush","confidence":"high","note":"Standard identification."}],"n_compounds":67,"top_compounds":[{"name":"(E)-p-coumaric acid","qid":"Q99374"},{"name":"kaempferol","qid":"Q393336"},{"name":"quercetin","qid":"Q409478"},{"name":"luteolin","qid":"Q415011"},{"name":"(E)-chlorogenic acid","qid":"Q421964"},{"name":"apigenin","qid":"Q424567"},{"name":"myricetin","qid":"Q951449"},{"name":"matairesinol","qid":"Q4284467"}],"epmc_total":39,"trials":0,"claims":[{"concept_id":"appetite_loss","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.86,"evidence_tier":"unstudied"},{"concept_id":"dyspepsia","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.85,"evidence_tier":"unstudied"},{"concept_id":"erysipelas","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.97,"evidence_tier":"unstudied"},{"concept_id":"helminthiasis","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":2.56,"evidence_tier":"sparse"},{"concept_id":"inflammation","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.33,"evidence_tier":"unstudied"},{"concept_id":"kidney_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.57,"evidence_tier":"unstudied"},{"concept_id":"urolithiasis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.94,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"cul:143-gooseberry-bush":{"ref":"Culpeper, Complete Herbal: Gooseberry Bush","headword":"Gooseberry Bush","lang":"en","source":"culpeper","text":"They are under the dominion of Venus. The berries, while they are unripe, being scalded or baked, are good to stir up a fainting or decayed appetite, especially such whose stomachs are afflicted by choleric humours: They are excellently good to stay longings of women with child. You may keep them preserved with sugar all the year long. The decoction of the leaves of the tree cools hot dwellings and inflammations; as also St. Anthony’s fire. The ripe Gooseberries being eaten, are an excellent remedy to allay the violent heat both of the stomach and liver. The young and tender leaves break the stone, and expel gravel both from the kidneys and bladder. All the evil they do to the body of man is, they are supposed to breed crudities, and by crudities, worms.","spans":[{"start":140,"end":148,"concept_id":"appetite_loss","polarity":"therapeutic"},{"start":402,"end":415,"concept_id":"inflammation","polarity":"therapeutic"},{"start":429,"end":443,"concept_id":"erysipelas","polarity":"therapeutic"},{"start":525,"end":549,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":599,"end":604,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":616,"end":622,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":637,"end":644,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":649,"end":656,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":758,"end":763,"concept_id":"helminthiasis","polarity":"therapeutic"}]}},"gloss":{"cul:143-gooseberry-bush":{"140":"appetite (provokes / restores)","402":"inflammations","429":"St. Anthony's fire: erysipelas","525":"pains / gnawing / heat of the stomach","599":"the stone (urinary calculus)","616":"gravel: small urinary concretions","637":"kidneys","649":"bladder","758":"worms (intestinal)"}},"images":[]}