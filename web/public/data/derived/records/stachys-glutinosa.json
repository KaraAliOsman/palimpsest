 ἣν καὶ πράσιον ἔνιοι καλοῦσιν. ἀρίστη δὲ ἡ Κιλίκιος καὶ ἡ ἐν Κῷ καὶ ἡ ἐν Πίῳ καὶ Σμύρνη καὶ Κρήτη. θερμαντικαὶ δὲ πᾶσαι καὶ οὐρητικαὶ καὶ εὐκοίλιοι πινομένου τοῦ ἀφεψήματος· ὑποβιβάζουσι γὰρ τὰ χολώδη· εὔθετοι καὶ σπληνικοῖς ποτιζόμεναι μετʼ ὄξους καὶ τοῖς ἰξίαν πεπωκόσι μετʼ οἴνου· καὶ ἔμμηνα δὲ ἄγουσι, βηξί τε καὶ περιπνευμονίαις σὺν μέλιτι ἐν ἐκλεικτῷ δίδοται. ἐστι δὲ τὸ πότημα ἐπιεικές, ὅθεν τοῖς ἀσώδεσι καὶ κακοστομάχοις καὶ ὀξυρεγμιῶσι δίδοται καὶ ἐφ᾿ ὧν ἄλυσις καὶ ναυτία καὶ θέρμη ὑποχονδρίων παρακολουθεῖ, διαφορεῖ δὲ καὶ οἰδήματα καταπλασθεῖσα μετʼ ἀλφίτων.","spans":[{"start":321,"end":328,"concept_id":"diuresis","polarity":"action"},{"start":335,"end":342,"concept_id":"constipation","polarity":"action"},{"start":411,"end":421,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":460,"end":465,"concept_id":"poisoning","polarity":"therapeutic"},{"start":485,"end":501,"concept_id":"amenorrhea","polarity":"action"},{"start":515,"end":524,"concept_id":"pleurisy_pneumonia","polarity":"therapeutic"},{"start":613,"end":623,"concept_id":"dyspepsia","polarity":"adverse"},{"start":673,"end":679,"concept_id":"nausea_vomiting","polarity":"therapeutic"},{"start":732,"end":737,"concept_id":"inflammation","polarity":"therapeutic"}]}},"gloss":{"dsc:3.30":{"321":"diuretic (οὐρητικός, διουρητικός)","335":"loosening the bowels (εὔκοιλιος)","411":"the spleen / spleen patients (σπληνικοί)","460":"those who have drunk (a poison) (πεπωκότες)","485":"brings on the menses (emmenagogue)","515":"peripneumonia (περιπνευμονία)","613":"bad for the stomach (κακοστόμαχος)","673":"nausea (ναυτία)","732":"swellings (οἰδήματα)"}},"images":[]}