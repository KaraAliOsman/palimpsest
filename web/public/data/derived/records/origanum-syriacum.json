eumonia","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":1.51,"evidence_tier":"sparse"},{"concept_id":"sore_throat","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":2.72,"evidence_tier":"sparse"},{"concept_id":"spleen_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.51,"evidence_tier":"unstudied"},{"concept_id":"toothache","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.8,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:3.25":{"ref":"De materia medica 3.25","headword":"ὔσσωπος","lang":"grc","source":"dioscorides","text":"ὔσσωπος· πόα γνώριμος, δισσή· ἡ μὲν γάρ τίς ἐστιν ὀρεινὴ ἡ δὲ κηπευτή· ἀρίστη δὲ ἡ ἐν Κιλικίᾳ γεννωμένη. δύναμιν δὲ ἔχει θερμαντικήν· ἀφεψηθεῖσα δὲ μετὰ σύκων καὶ ὔδατοε καὶ μέλιτος καὶ πηγάνου καὶ πινομένη ἀρήγει περιπνευμονικοῖς, ἀσθματικοῖς, βηχὶ χρονίᾳ, κατάρρῳ, ὀρθοπνοίᾳ· κτείνει δὲ καὶ ἑλμεις, σὺς μέλιτι δὲ ἐκλειχθεῖσα τὸ αὐτὸ ποιεῖ. ἄγει δὲ καὶ πάχος κατὰ κοιλίαν τὸ ἀφέψημα αὐτῆς σὺν ὀξυμέλιτι πινόμενον καὶ βιβρώσκεται δὲ μετὰ χλωρῶν σύκων λείων πρὸς ὑπαγωγὴν κοιλίας, σφοδρότερον δὲ καθαίρει μιγέντος αὐτῷ καρδάμου ἢ ἴριδος ἡ ἐρυσίμου· περιποιεῖ δὲ καὶ εὔχροιαν. καταπλάσσεται δὲ μετὰ σύκου καὶ νίτρου πρὸς σπλῆνα καὶ ὕδρωπα, σὺν οἴνῳ δὲ πρὸς φλεγμονάς· διαφορεῖ δὲ καὶ ὑπώπια σὺν ὕδατι ζεστῷ καταπλασθεῖσα. συνάγχης δὲ ἀναγαργάρισμα μετὰ σύκων ἀφεψήματος ἄριστον, ὀδόντος τε πόνον πραΰνει σὺν ὄξει ἑψηθεῖσα καὶ διακλυζομένη· λύει δὲ καὶ τὰς περὶ ὦτα ἐμπνευματώσεις ὑπατμισθεῖσα.","spans":[{"start":214,"end":223,"concept_id":"pleurisy_pneumonia","polarity":"therapeutic"},{"start":232,"end":236,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":245,"end":248,"concept_id":"cough","polarity":"therapeutic"},{"start":258,"end":265,"concept_id":"common_cold","polarity":"therapeutic"},{"start":267,"end":273,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":293,"end":299,"concept_id":"helminthiasis","polarity":"therapeutic"},{"start":360,"end":372,"concept_id":"constipation","polarity":"action"},{"start":471,"end":501,"concept_id":"constipation","polarity":"action"},{"start":619,"end":625,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":630,"end":635,"concept_id":"edema_dropsy","polarity":"therapeutic"},{"start":655,"end":662,"concept_id":"inflammation","polarity":"therapeutic"},{"start":682,"end":686,"concept_id":"bruises","polarity":"therapeutic"},{"start":720,"end":726,"concept_id":"sore_throat","polarity":"therapeutic"},{"start":777,"end":791,"concept_id":"toothache","polarity":"therapeutic"},{"start":859,"end":862,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":863,"end":874,"concept_id":"flatulence","polarity":"therapeutic"}]}},"images":[]}