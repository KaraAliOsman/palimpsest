r":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"convulsions","dsc":1,"cul":1,"persistent":true,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"cough","dsc":1,"cul":1,"persistent":true,"epmc_pair":0,"lift":0.98,"evidence_tier":"unstudied"},{"concept_id":"delirium","dsc":1,"cul":1,"persistent":true,"epmc_pair":0,"lift":0.97,"evidence_tier":"unstudied"},{"concept_id":"ear_disease","dsc":1,"cul":1,"persistent":true,"epmc_pair":0,"lift":0.98,"evidence_tier":"unstudied"},{"concept_id":"epilepsy","dsc":1,"cul":1,"persistent":true,"epmc_pair":0,"lift":0.94,"evidence_tier":"unstudied"},{"concept_id":"kidney_disease","dsc":1,"cul":1,"persistent":true,"epmc_pair":0,"lift":0.89,"evidence_tier":"unstudied"},{"concept_id":"labor","dsc":1,"cul":1,"persistent":true,"epmc_pair":0,"lift":0.96,"evidence_tier":"unstudied"},{"concept_id":"paralysis","dsc":1,"cul":1,"persistent":true,"epmc_pair":0,"lift":0.94,"evidence_tier":"unstudied"},{"concept_id":"sciatica","dsc":1,"cul":1,"persistent":true,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"spleen_disease","dsc":1,"cul":1,"persistent":true,"epmc_pair":0,"lift":0.93,"evidence_tier":"unstudied"},{"concept_id":"colic","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"envenomation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"flatulence","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"toothache","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.98,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:3.78":{"ref":"De materia medica 3.78","headword":"πευκέκδανον","lang":"grc","source":"dioscorides","text":"πευκέκδανον· καυλὸν ἀνίησιν ἰσχνόν, μαράθῳ ὅμοιον κόμην δὲ ἔχει περὶ τὴν ῥίζαν ἱκανὴν καὶ πυκνήν, ἄνθος μήλινον, ῥίζαν μέλαιναν, βαρύοσμον, ἁδράν, μεστὴν ὀποῦ. φύεται δὲ ἐν ὄρεσι συσκίοις. ὀπίζεται δὲ τῆς ῥίζης ἁπαλῆς ἀποτεμνομένης μαχαιρίῳ, καὶ τὸ ἀπορρέον εὐθέως ἐν σκιᾷ τίθεται· ὑπὸ γὰρ τοῦ ἡλίου ἀνίεται. ἐν δὲ τῷ συλλέγεσθαι κεφαλαλγίαν ποιεῖ καὶ σκοτώματα, ἐὰν μή τις προδιαχρίσῃ ἑαυτοῦ τὰς ῥῖνας ῥοδίνῳ καὶ τὴν κεφαλὴν προκαταβρέξῃ· ἄχρηστος δὲ γίνεται ὀπισθεῖσα ἡ ῥίζα. ὀπίζονται δὲ καὶ οἱ καυλοί, καὶ χυλίζεται ἡ ῥίζα ὡς μανδραγόρας, ἧττον δὲ ἐνεργεῖ τοῦ ὀποῦ ὁ χυλὸς καὶ τάχιον ἐκπνεῖ. ἐνίοτε δὲ εὑρίσκεται προ πεπηγὸς δάκρυον, ὅμοιον λιβανωτῷ, τοῖς καυλοῖς καὶ ταῖς ῥίζαις προσπεπλασμένον. τοῦ δὲ ὀποῦ διαφέρει ὁ ἐν Σαρδονίᾳ καὶ Σαμαθρᾴκῃ γεννώμενος, βαρύοσμος, ἔγκιρρος, θερμαίνων τὴν γεῦσιν. ἁρμόζει δὲ σὺν ὄξει καὶ ῥοδίνῳ καταχριόμενος ληθαργικοῖς, φρενιτικοῖς, σκοτωματικοῖς, ἐπιληπτικοῖς, κεφαλαλγοῦσι χρονίως, παραλυτικοῖς, ἰσχιαδικοῖς, σπωμένοις καὶ καθόλου τοῖς περὶ νεῦρα πάθεσι συγχριόμενος μετ᾿ ἐλαίου καὶ ὄξους. ἐστι δὲ καὶ ὀσφραντὸς πνιγὸς ὑστερικῆς καὶ τῶν καταφερομένων ἀνακλητικός. διώκει δὲ θηρία θυμιώμενος· ἁρμόζει δὲ καὶ πρὸς ὠταλγίας ἐνσταζόμενος σὺν ῥοδίνῳ καὶ πρὸς μυλαλγίας ἐντιθέμενος βρώμασι· ποιεῖ δὲ καὶ πρὸς βῆχας μετ᾿ ᾠοῦ λαμβανόμενος, δυσπνοίαις τε καὶ στρόφοις καὶ πνευματικαῖς διαθέσεσιν ἀρμόζει, κοιλίαν τε ἠπίως μαλάσσει καὶ σπλῆνα τήκει καὶ δυστοκίαις ἐξόχως ἀρήγει, πρός τε πόνους καὶ διατάσεις κύστεως καὶ νεφρῶν πινόμενος ποιεῖ· ἀναστομοῖ δὲ καὶ ὑστέραν. χρησίμη δὲ καὶ ἡ ῥίζα πρὸς τὰ αὐτὰ ἔλασσον ἐνεργοῦσα· πίνεται δὲ αὐτῆς τὸ ἀφέψημ· καθαίρει δὲ λεία ξηρὰ τὰ ῥυπαρὰ ἕλκη καὶ λεπίδας ἀπ᾿ ὀστέων ἀφίστησι καὶ ἀπουλοῖ τὰ παλαιά· μείγνυται δὲ καὶ κηρώμασι καὶ μαλάγμασι θερμαντικοῖς. ἐκλέγου δὲ τὴν πρόσφατον, ἄβρωτον, στερεάν, πλήρη ὀσμῆς. λύεται δὲ ὁ ὀπὸς εἰς τὰ ποτήματα ἀμυγδάλοις πικροῖς ἢ πηγάνῳ ἢ ἀνήθῳ ἢ ἄρτῳ θερμῷ.","spans":[{"start":330,"end":341,"concept_id":"headache","polarity":"therapeutic"},{"start":352,"end":358,"concept_id":"vertigo","polarity":"therapeutic"},{"start":850,"end":856,"concept_id":"delirium","polarity":"therapeutic"},{"start":863,"end":869,"concept_id":"delirium","polarity":"therapeutic"},{"start":876,"end":882,"concept_id":"vertigo","polarity":"therapeutic"},{"start":891,"end":898,"concept_id":"epilepsy","polarity":"therapeutic"},{"start":905,"end":917,"concept_id":"headache","polarity":"therapeutic"},{"start":927,"end":936,"concept_id":"paralysis","polarity":"therapeutic"},{"start":941,"end":947,"concept_id":"sciatica","polarity":"therapeutic"},{"start":954,"end":960,"concept_id":"convulsions","polarity":"therapeutic"},{"start":1064,"end":1071,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":1109,"end":1123,"concept_id":"envenomation","polarity":"action"},{"start":1157,"end":1162,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":1248,"end":1251,"concept_id":"cough","polarity":"therapeutic"},{"start":1277,"end":1283,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":1295,"end":1303,"concept_id":"colic","polarity":"therapeutic"},{"start":1341,"end":1362,"concept_id":"constipation","polarity":"action"},{"start":1371,"end":1377,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":1388,"end":1394,"concept_id":"labor","polarity":"therapeutic"},{"start":1443,"end":1450,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":1455,"end":1461,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":1496,"end":1503,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":1619,"end":1623,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":1660,"end":1665,"concept_id":"wounds","polarity":"action"}]},"cul:122-sow-fennel-or-hogs-fennel":{"ref":"Culpeper, Complete Herbal: Sow-Fennel, Or Hog’s-Fennel","headword":"Sow-Fennel, Or Hog’s-Fennel","lang":"en","source":"culpeper","text":"This is also an herb of Mercury. The juice of Sow-Fennel (saith Dioscorides, and Galen,) used with vinegar and rose water, or the juice with a little Euphorbium put to the nose, helps those that are troubled with the lethargy, frenzy, giddiness of the head, the falling sickness, long and inveterate head-aches, the palsy, sciatica, and the cramp, and generally all the diseases of the sinews, used with oil and vinegar. The juice dissolved in wine, or put into an egg, is good for a cough, or shortness of breath, and for those that are troubled with wind in the body. It purges the belly gently, expels the hardness of the spleen, gives ease to women that have sore travail in child-birth, and eases the pains of the reins and bladder, and also the womb. A little of the juice dissolved in wine, and dropped into the ears, eases much of the pains in them, and put into a hollow tooth, eases the pain thereof. The root is less effectual to all the aforesaid disorders; yet the powder of the root cleanses foul ulcers, being put into them, and takes out splinters of broken bones, or other things in the flesh, and heals them up perfectly: as also, dries up old and inveterate running sores, and is of admirable virtue in all green wounds.","spans":[{"start":217,"end":225,"concept_id":"delirium","polarity":"therapeutic"},{"start":227,"end":233,"concept_id":"delirium","polarity":"therapeutic"},{"start":235,"end":244,"concept_id":"vertigo","polarity":"therapeutic"},{"start":262,"end":278,"concept_id":"epilepsy","polarity":"therapeutic"},{"start":300,"end":310,"concept_id":"headache","polarity":"therapeutic"},{"start":316,"end":321,"concept_id":"paralysis","polarity":"therapeutic"},{"start":323,"end":331,"concept_id":"sciatica","polarity":"therapeutic"},{"start":341,"end":346,"concept_id":"convulsions","polarity":"therapeutic"},{"start":484,"end":489,"concept_id":"cough","polarity":"therapeutic"},{"start":494,"end":513,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":538,"end":556,"concept_id":"flatulence","polarity":"therapeutic"},{"start":573,"end":589,"concept_id":"constipation","polarity":"action"},{"start":625,"end":631,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":668,"end":675,"concept_id":"labor","polarity":"therapeutic"},{"start":679,"end":690,"concept_id":"labor","polarity":"therapeutic"},{"start":719,"end":724,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":729,"end":736,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":751,"end":755,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":810,"end":848,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":873,"end":885,"concept_id":"toothache","polarity":"therapeutic"},{"start":1011,"end":1017,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":1054,"end":1063,"concept_id":"wounds","polarity":"therapeutic"},{"start":1185,"end":1190,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":1232,"end":1238,"concept_id":"wounds","polarity":"therapeutic"}]}},"gloss":{"dsc:3.78":{"330":"headache (κεφαλαλγία, κεφαλαλγοῦντες)","352":"dizziness (σκοτωματικοί)","850":"lethargy (λήθαργος)","863":"phrenitis (φρενῖτις)","876":"dizziness (σκοτωματικοί)","891":"epileptics (ἐπιλη(μ)πτικοί)","905":"headache (κεφαλαλγία, κεφαλαλγοῦντες)","927":"paralytics (παραλυτικοί)","941":"sciatica (ἰσχιάς)","954":"those convulsed (σπώμενοι)","1064":"hysterical suffocation (πνὶξ ὑστερική)","1109":"drives away snakes / beasts (repellent)","1157":"earache (ὠταλγία)","1248":"cough (βήξ, βήσσοντες)","1277":"dyspnoea (δύσπνοια)","1295":"gripes (στρόφοι)","1341":"loosens / moves the bowels (laxative)","1371":"the spleen / spleen patients (σπληνικοί)","1388":"difficult labour (δυστοκία)","1443":"bladder (κύστις)","1455":"kidneys / nephritics (νεφριτικοί)","1496":"the womb (ὑστέρα, μήτρα)","1619":"ulcers (ἕλκη, ἑλκώσεις)","1660":"cicatrising (ἀπουλοῖ)"},"cul:122-sow-fennel-or-hogs-fennel":{"217":"lethargy: morbid drowsiness, coma","227":"frenzy: delirium, raving","235":"giddiness","262":"falling sickness: epilepsy","300":"head-ache","316":"palsy","323":"sciatica","341":"cramp, cramps","484":"cough, coughs","494":"shortness of breath: dyspnoea","538":"troubled with wind: flatulence","573":"purges / opens / loosens the belly: laxative, purgative","6