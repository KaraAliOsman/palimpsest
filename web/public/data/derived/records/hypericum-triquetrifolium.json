{"slug":"hypericum-triquetrifolium","plant":{"taxon":"Hypericum triquetrifolium","family":"Hypericaceae","rank":"species","gbif_key":3715163,"wikidata":"Q310680","iucn":null,"gbif_occurrences":4484,"common_name":"wavy-leaved St John's wort","names":[{"source":"dioscorides","name":"ὑπερικόν","monograph_id":"dsc:3.154","confidence":"medium","note":"Rue-like leaves, resin-scented black seed; Berendes H. crispum (=triquetrifolium); H. perforatum also proposed."}],"n_compounds":26,"top_compounds":[{"name":"nonane","qid":"Q150694"},{"name":"undecane","qid":"Q150731"},{"name":"beta-pinene","qid":"Q300928"},{"name":"rutin","qid":"Q407857"},{"name":"quercetin","qid":"Q409478"},{"name":"sabinene","qid":"Q421278"},{"name":"caryophyllene","qid":"Q421614"},{"name":"(E)-chlorogenic acid","qid":"Q421964"}],"epmc_total":38,"trials":0,"claims":[{"concept_id":"amenorrhea","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.92,"evidence_tier":"unstudied"},{"concept_id":"burns","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.86,"evidence_tier":"unstudied"},{"concept_id":"diuresis","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.9,"evidence_tier":"unstudied"},{"concept_id":"malaria","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.81,"evidence_tier":"unstudied"},{"concept_id":"sciatica","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.93,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:3.154":{"ref":"De materia medica 3.154","headword":"ὑπερικόν","lang":"grc","source":"dioscorides","text":"ὑπερικόν· οἱ δὲ ἀνδρόσαιμον, οἱ δὲ κόριον, οἱ δὲ χαμαίπιτυν διὰ τὸ τὴν περὶ τὸ σπέρμα ὀσμὴν ἐοικέναι ῥητίνη πιτυίνῃ. φύλλα ἔχει πηγάνῳ ὅμοια· θάμνος φρυγανοειδής, σπιθαμιαῖος, ὑπέρυθρος, ἄνθος ἔχων λευκοΐῳ ὅμοιον, λοβὸν δὲ ὑπόδασυν, προμήκη ἐν τῳ περιφερεῖ, μέγεθος κριθῆς, ἐν ᾧ σπέρμα μέλαν ῥητίνης ὄζον. φύεται δὲ ἐν ἐργασίμοις καὶ τραχέσι χωρίοις. δύναμιν δὲ ἔχει διουρητικὴν καὶ ἐμμήνων ἀγωγὸν προστιθέμενον, τεταρταϊκούς τε ἀπαλλάσσει μετʼ οἴνου πινόμενον. θεραπεύει δὲ καὶ ἰσχιάδας ἐπὶ ἡμέρας τεσσαράκοντα τὸ σπέρμα πινόμενον, τὰ δὲ φύλλα σὸν τῳ σπέρματι καταπλασθέντα ἰᾶται κατακαύματα.","spans":[{"start":367,"end":376,"concept_id":"diuresis","polarity":"action"},{"start":383,"end":397,"concept_id":"amenorrhea","polarity":"action"},{"start":413,"end":421,"concept_id":"malaria","polarity":"therapeutic"},{"start":479,"end":485,"concept_id":"sciatica","polarity":"therapeutic"},{"start":581,"end":589,"concept_id":"burns","polarity":"therapeutic"}]}},"images":[]}