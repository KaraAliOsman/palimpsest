{"slug":"polygonatum-odoratum","plant":{"taxon":"Polygonatum odoratum","family":"Asparagaceae","rank":"species","gbif_key":2770228,"wikidata":"Q157430","iucn":null,"gbif_occurrences":169079,"common_name":"Solomon's seal","names":[{"source":"dioscorides","name":"πολυγόνατον","monograph_id":"dsc:4.6","confidence":"medium","note":"Mountain plant with bay-like leaves; Solomon's seal (named from it)."}],"n_compounds":28,"top_compounds":[{"name":"hesperidin","qid":"Q385937"},{"name":"tectoridin","qid":"Q10860610"},{"name":"2-azetidinecarboxylic acid","qid":"Q27117374"},{"name":"(3R)-5,7-dihydroxy-3-[(4-methoxyphenyl)methyl]-6,8-dimethyl-2,3-dihydro-1-benzopyran-4-one","qid":"Q104393836"},{"name":"(3S)-5,7-dihydroxy-3-[(4-hydroxyphenyl)methyl]-6-methyl-2,3-dihydrochromen-4-one","qid":"Q104934892"},{"name":"Polygonatumoside D","qid":"Q104945353"},{"name":"Polygonatumoside E","qid":"Q104945354"},{"name":"(3R)-5,7-dihydroxy-3-[(2-hydroxy-4-methoxyphenyl)methyl]-8-methoxy-6-methyl-2,3-dihydrochromen-4-one","qid":"Q104997824"}],"epmc_total":199,"trials":0,"claims":[{"concept_id":"skin_blemishes","dsc":1,"cul":0,"persistent":false,"epmc_pair":3,"lift":5.88,"evidence_tier":"sparse"},{"concept_id":"wounds","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.23,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:4.6":{"ref":"De materia medica 4.6","headword":"πολυγόνατον","lang":"grc","source":"dioscorides","text":"πολυγόνατον· φύεται ἐν ὄρεσι. θάμνος μείζων πήχεως, φύλλα ἔχων ὅμοια δάφνῃ. πλατύτερα δὲ καὶ λειότερα, γευσαμένῳ ὅμοιόν τι μήλῳ κυδωνίῳ ἢ ῥοᾷ μετὰ στύψεως προσβάλλει· καθ᾿ ἑκάστην δὲ ἔκφυσιν τῶν φύλλων ἄνθη λευκά, τῷ πλήθει ὑπερέχοντα τοῦ ἀριθμοῦ τῶν φύλλων ἀπὸ τῆς ῥίζης ἡνωμένα· ῥίζαν δὲ λευκήν, μαλακήν, μακράν, πολυγόνατον, δασεῖαν, βαρύοσμον, πάχος ἔχουσαν δακτύλου, ποιοῦσαν πρὸς τραύματα καταπλασσομένην} αἴρει δὲ καὶ σπίλους τούς ἐν προσώπῳ.","spans":[{"start":386,"end":392,"concept_id":"wounds","polarity":"therapeutic"},{"start":425,"end":432,"concept_id":"skin_blemishes","polarity":"therapeutic"}]}},"images":["cod-wien-polygonaton"]}