{"slug":"oxalis-acetosella","plant":{"taxon":"Oxalis acetosella","family":"Oxalidaceae","rank":"species","gbif_key":8211958,"wikidata":"Q158576","iucn":null,"gbif_occurrences":757194,"common_name":"wood-sorrel","names":[{"source":"culpeper","name":"Wood Sorrel","monograph_id":"cul:285-wood-sorrel","confidence":"high","note":"Trefoil leaves notched at the ends: wood sorrel."}],"n_compounds":0,"top_compounds":[],"epmc_total":40,"trials":0,"claims":[{"concept_id":"appetite_loss","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.86,"evidence_tier":"unstudied"},{"concept_id":"dyspepsia","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.84,"evidence_tier":"unstudied"},{"concept_id":"fever","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.65,"evidence_tier":"unstudied"},{"concept_id":"hemorrhage","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.49,"evidence_tier":"unstudied"},{"concept_id":"inflammation","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.33,"evidence_tier":"unstudied"},{"concept_id":"itch_scabies","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.93,"evidence_tier":"unstudied"},{"concept_id":"mouth_gums","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.86,"evidence_tier":"unstudied"},{"concept_id":"nausea_vomiting","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.8,"evidence_tier":"unstudied"},{"concept_id":"plague","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.78,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.94,"evidence_tier":"unstudied"},{"concept_id":"wounds","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.6,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"cul:285-wood-sorrel":{"ref":"Culpeper, Complete Herbal: Wood Sorrel","headword":"Wood Sorrel","lang":"en","source":"culpeper","text":"Venus owns it. Wood Sorrel serves to all the purposes that the other Sorrels do, and is more effectual in hindering putrefaction of blood, and ulcers in the mouth and body, and to quench thirst, to strengthen a weak stomach, to procure an appetite, to stay vomiting, and very excellent in any contagious sickness or pestilential fevers. The syrup made of the juice, is effectual in all the cases aforesaid, and so is the distilled water of the herb. Sponges or linen cloths wet in the juice and applied outwardly to any hot swelling or inflammations, doth much cool and help them. The same juice taken and gargled in the mouth, and after it is spit forth, taken afresh, doth wonderfully help a foul stinking canker or ulcer therein. It is singularly good to heal wounds, or to stay the bleeding of thrusts or scabs in the body.","spans":[{"start":143,"end":162,"concept_id":"mouth_gums","polarity":"therapeutic"},{"start":198,"end":223,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":239,"end":247,"concept_id":"appetite_loss","polarity":"therapeutic"},{"start":257,"end":265,"concept_id":"nausea_vomiting","polarity":"therapeutic"},{"start":316,"end":328,"concept_id":"plague","polarity":"therapeutic"},{"start":329,"end":335,"concept_id":"fever","polarity":"therapeutic"},{"start":520,"end":532,"concept_id":"inflammation","polarity":"therapeutic"},{"start":536,"end":549,"concept_id":"inflammation","polarity":"therapeutic"},{"start":708,"end":714,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":718,"end":723,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":763,"end":769,"concept_id":"wounds","polarity":"therapeutic"},{"start":786,"end":794,"concept_id":"hemorrhage","polarity":"therapeutic"},{"start":809,"end":814,"concept_id":"itch_scabies","polarity":"therapeutic"}]}},"gloss":{"cul:285-wood-sorrel":{"143":"sores / ulcers / cankers in the mouth","198":"strengthens / comforts the stomach (stomachic)","239":"appetite (provokes / restores)","257":"stays vomiting / vomits","316":"pestilence, pestilential fevers / sores","329":"fevers","520":"hot / red / painful swellings (phlegmone)","536":"inflammations","708":"canker: spreading / eating ulcer","718":"ulcers (old, foul, running, fretting)","763":"wounds (green, fresh, inward, old); wound-herb","786":"bleeding (inward / outward / of wounds)","809":"scabs: scabies / scabby skin"}},"images":[]}