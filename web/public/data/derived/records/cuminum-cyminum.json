{"slug":"cuminum-cyminum","plant":{"taxon":"Cuminum cyminum","family":"Apiaceae","rank":"species","gbif_key":3034775,"wikidata":"Q132624","iucn":null,"gbif_occurrences":797,"common_name":"cumin","names":[{"source":"dioscorides","name":"κύμινον τὸ ἥμερον","monograph_id":"dsc:3.59","confidence":"high","note":"Cultivated kyminon (Ethiopian 'royal' cumin); Berendes Cuminum cyminum."}],"n_compounds":61,"top_compounds":[{"name":"(±)-3-carene","qid":"Q19414"},{"name":"(E)-p-coumaric acid","qid":"Q99374"},{"name":"acetylcholine","qid":"Q180623"},{"name":"uracil","qid":"Q182990"},{"name":"choline","qid":"Q193166"},{"name":"oleic acid","qid":"Q207688"},{"name":"carvacrol","qid":"Q225543"},{"name":"trans-anethol","qid":"Q255564"}],"epmc_total":574,"trials":34,"claims":[{"concept_id":"asthma_dyspnea","dsc":1,"cul":0,"persistent":false,"epmc_pair":3,"lift":0.77,"evidence_tier":"sparse"},{"concept_id":"colic","dsc":1,"cul":0,"persistent":false,"epmc_pair":3,"lift":4.73,"evidence_tier":"sparse"},{"concept_id":"dyspepsia","dsc":1,"cul":0,"persistent":false,"epmc_pair":5,"lift":2.99,"evidence_tier":"studied"},{"concept_id":"envenomation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.72,"evidence_tier":"unstudied"},{"concept_id":"flatulence","dsc":1,"cul":0,"persistent":false,"epmc_pair":5,"lift":8.83,"evidence_tier":"studied"},{"concept_id":"hemorrhage","dsc":1,"cul":0,"persistent":false,"epmc_pair":2,"lift":0.32,"evidence_tier":"sparse"},{"concept_id":"inflammation","dsc":1,"cul":0,"persistent":false,"epmc_pair":38,"lift":2.51,"evidence_tier":"studied"},{"concept_id":"menorrhagia","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.78,"evidence_tier":"unstudied"},{"concept_id":"nosebleed","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.79,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:3.59":{"ref":"De materia medica 3.59","headword":"κύμινον τὸ ἥμερον","lang":"grc","source":"dioscorides","text":"κύμινον τὸ ἥμερον· εὐστόμαχον, καὶ τούτου μᾶλλον τὸ Αἰθιοπικόν, ὅπερ Ἱπποκράτης (V L) βασιλικὸν ἐκάλεσεν. δευτερεύει δὲ τὸ Αίγύπτιον, εἶτα τὸ λοιπόν. φύεται δὲ ἐν Γαλατίᾳ καὶ Σπανίᾳ καὶ ἐν Κιλικίᾳ καὶ ἐν ἄλλοις πλείστοις τόποις. δύναμιν δὲ ἔχει θερμαντικήν, ξηραντικήν, στυπτικήν, ἁρμόζουσαν πρὸς στρόφους καὶ ἐμπνευματώσεις ἐγκλυζόμενον ἑφθὸν σὺν ἐλαίῳ καὶ καταπλασσόμενον σύν ὠμῇ λύσει. δίδοται δὲ καὶ ὀρθοπνοῖκοῖς σὺν ὀξυκράτῳ, θηριοδήκτοις δὲ σύν οἴνῳ, διδύμων τε φλεγμοναῖς ἀρήγει σὺν σταφίδι καὶ ἀλεύρῳ ἐρεγμίνῳ ἢ κηρωτῇ ἐπιτεθέν ἐπέχει δὲ καὶ ῥοῦν γυναικεῖον καὶ τὰς ἐκ μυκτήρων αἱμορραγίας σύν ὄξει λεῖον προσενεχθέν τρέπει δὲ καὶ χρῶτα ἐπὶ τὸ ὠχρότερον πινόμενόν τε καὶ ἐγχριόμενον.","spans":[{"start":19,"end":27,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":297,"end":305,"concept_id":"colic","polarity":"therapeutic"},{"start":310,"end":321,"concept_id":"flatulence","polarity":"therapeutic"},{"start":404,"end":410,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":431,"end":440,"concept_id":"envenomation","polarity":"therapeutic"},{"start":468,"end":475,"concept_id":"inflammation","polarity":"therapeutic"},{"start":550,"end":563,"concept_id":"menorrhagia","polarity":"therapeutic"},{"start":577,"end":589,"concept_id":"nosebleed","polarity":"therapeutic"},{"start":586,"end":594,"concept_id":"hemorrhage","polarity":"therapeutic"}]}},"gloss":{"dsc:3.59":{"19":"good for the stomach (εὐστόμαχος)","297":"gripes (στρόφοι)","310":"flatulence (ἐμπνευμάτωσις)","404":"orthopnoea (ὀρθόπνοια)","431":"bitten by wild beasts (θηριόδηκτοι)","468":"inflammations (φλεγμοναί)","550":"the female (red) flux (ῥοῦς γυναικεῖος)","577":"bleeding from the nostrils","586":"haemorrhage (αἱμορραγία)"}},"images":["kuminon-hemeron-179v-dioscoride-vienne"]}