id":"paralysis","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":0.3,"evidence_tier":"sparse"},{"concept_id":"sore_throat","dsc":0,"cul":1,"persistent":false,"epmc_pair":2,"lift":2.51,"evidence_tier":"sparse"},{"concept_id":"spleen_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.1,"evidence_tier":"unstudied"},{"concept_id":"stroke","dsc":0,"cul":1,"persistent":false,"epmc_pair":5,"lift":0.62,"evidence_tier":"studied"},{"concept_id":"toothache","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.3,"evidence_tier":"unstudied"},{"concept_id":"vertigo","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":1.11,"evidence_tier":"sparse"}],"lead_score":null},"texts":{"cul:173-lavender":{"ref":"Culpeper, Complete Herbal: Lavender","headword":"Lavender","lang":"en","source":"culpeper","text":"Mercury owns the herb; and it carries his effects very potently. Lavender is of a special good use for all the griefs and pains of the head and brain that proceed of a cold cause, as the apoplexy, falling-sickness, the dropsy, or sluggish malady, cramps, convulsions, palsies, and often faintings. It strengthens the stomach, and frees the liver and spleen from obstructions, provokes women’s courses, and expels the dead child and after-birth. The flowers of Lavender steeped in wine, helps them to make water that are stopped, or are troubled with the wind or cholic, if the place be bathed therewith. A decoction made with the flowers of Lavender, Hore-hound, Fennel and Asparagus root, and a little Cinnamon, is very profitably used to help the falling-sickness, and the giddiness or turning of the brain: to gargle the mouth with the decoction thereof is good against the tooth-ache. Two spoonfuls of the distilled water of the flowers taken, helps them that have lost their voice, as also the tremblings and passions of the heart, and faintings and swooning, not only being drank, but applied to the temples, or nostrils to be smelled unto; but it is not safe to use it where the body is replete with blood and humours, because of the hot and subtile spirits wherewith it is possessed. The chymical oil drawn from Lavender, usually called Oil of Spike, is of so fierce and piercing a quality, that it is cautiously to be used, some few drops being sufficient, to be given with other things, either for inward or outward griefs.","spans":[{"start":122,"end":139,"concept_id":"headache","polarity":"therapeutic"},{"start":187,"end":195,"concept_id":"stroke","polarity":"therapeutic"},{"start":197,"end":213,"concept_id":"epilepsy","polarity":"therapeutic"},{"start":219,"end":225,"concept_id":"edema_dropsy","polarity":"therapeutic"},{"start":247,"end":253,"concept_id":"convulsions","polarity":"therapeutic"},{"start":255,"end":266,"concept_id":"convulsions","polarity":"therapeutic"},{"start":268,"end":275,"concept_id":"paralysis","polarity":"therapeutic"},{"start":287,"end":296,"concept_id":"heart","polarity":"therapeutic"},{"start":301,"end":324,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":350,"end":356,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":376,"end":400,"concept_id":"amenorrhea","polarity":"action"},{"start":417,"end":427,"concept_id":"labor","polarity":"therapeutic"},{"start":432,"end":443,"concept_id":"labor","polarity":"therapeutic"},{"start":500,"end":527,"concept_id":"diuresis","polarity":"therapeutic"},{"start":536,"end":558,"concept_id":"flatulence","polarity":"therapeutic"},{"start":562,"end":568,"concept_id":"colic","polarity":"therapeutic"},{"start":749,"end":765,"concept_id":"epilepsy","polarity":"therapeutic"},{"start":775,"end":784,"concept_id":"vertigo","polarity":"therapeutic"},{"start":788,"end":808,"concept_id":"vertigo","polarity":"therapeutic"},{"start":877,"end":887,"concept_id":"toothache","polarity":"therapeutic"},{"start":969,"end":985,"concept_id":"sore_throat","polarity":"therapeutic"},{"start":999,"end":1035,"concept_id":"heart","polarity":"therapeutic"},{"start":1041,"end