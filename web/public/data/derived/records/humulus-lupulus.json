 By all these testimonies beer appears to be better than ale. Mars owns the plant, and then Dr. Reason will tell you how it performs these actions.","spans":[{"start":70,"end":100,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":105,"end":111,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":138,"end":154,"concept_id":"constipation","polarity":"action"},{"start":171,"end":176,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":182,"end":188,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":194,"end":207,"concept_id":"diuresis","polarity":"action"},{"start":346,"end":360,"concept_id":"syphilis","polarity":"therapeutic"},{"start":381,"end":386,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":388,"end":392,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":404,"end":417,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":443,"end":450,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":452,"end":461,"concept_id":"tinea","polarity":"therapeutic"},{"start":477,"end":482,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":488,"end":495,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":504,"end":516,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":586,"end":592,"concept_id":"poisoning","polarity":"therapeutic"},{"start":674,"end":679,"concept_id":"helminthiasis","polarity":"therapeutic"},{"start":693,"end":720,"concept_id":"amenorrhea","polarity":"action"},{"start":726,"end":738,"concept_id":"diuresis","polarity":"action"},{"start":794,"end":802,"concept_id":"jaundice","polarity":"therapeutic"},{"start":814,"end":823,"concept_id":"headache","polarity":"therapeutic"},{"start":860,"end":877,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":931,"end":936,"concept_id":"fever","polarity":"therapeutic"}]}},"images":[]}