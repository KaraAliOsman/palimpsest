_id":"uterine_disorders","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.41,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:3.152":{"ref":"De materia medica 3.152","headword":"ἄλισμα","lang":"grc","source":"dioscorides","text":"ἄλισμα· οἱ δὲ δαμασώνιον καλοῦσιν, οἱ δὲ λύρον. φύλλα μὲν ἔχει ἀρνογλώσσῳ ὅμοια, στενώτερα δὲ καὶ ἐπὶ γῆν κλώμενα· καυλὸς δὲ λεπτός, ἀπλοῦς, ὑπὲρ πῆχυν, ἔχων κεφάλιν θυρσοειδές, ἄνθη λευκά λεπτά, ὕπωχρα, ῥίζαι ὡς μέλανος ἐλλεβόρου λεπταί, εὐώδεις, δριμεῖαι, ὑπολίπαροι. ὑδρηλὰ φιλεῖ χωρία. 2 ἁρμόζει δὲ ἡ ῥίζα πινομένη σὺν οἴνῳ δραχμῆς μιᾶς ἤ δυεῖν ὁλκὴ πρὸς λαγωὸν θαλάσσιον καὶ φρῦνον καὶ ὄπιον· παύει καὶ στρόφους καὶ δυσεντερίαν καθʼ ἑαυτὴν καὶ σύν ἴσῳ δαύκῳ πινομένη, ἁρμόζει καὶ σπάσμασι καὶ πρὸς τὰ ὑστερικὰ πάθη. ἡ δὲ πόα ἵστησι κοιλίαν καὶ ἔμμηνα κινεῖ καὶ οἰδήματα καταπλασθεῖσα πραΰνει.","spans":[{"start":354,"end":363,"concept_id":"poisoning","polarity":"therapeutic"},{"start":408,"end":416,"concept_id":"colic","polarity":"therapeutic"},{"start":421,"end":429,"concept_id":"dysentery","polarity":"therapeutic"},{"start":485,"end":492,"concept_id":"convulsions","polarity":"therapeutic"},{"start":506,"end":513,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":530,"end":542,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":537,"end":559,"concept_id":"constipation","polarity":"action"},{"start":549,"end":561,"concept_id":"amenorrhea","polarity":"action"},{"start":566,"end":571,"concept_id":"inflammation","polarity":"therapeutic"}]}},"images":[]}