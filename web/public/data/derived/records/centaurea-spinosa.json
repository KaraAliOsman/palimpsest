{"slug":"centaurea-spinosa","plant":{"taxon":"Centaurea spinosa","family":"Asteraceae","rank":"species","gbif_key":3128393,"wikidata":"Q786801","iucn":null,"gbif_occurrences":667,"common_name":"spiny knapweed","names":[{"source":"dioscorides","name":"ἱππόφαιστον","monograph_id":"dsc:4.160","confidence":"low","note":"Prostrate fullers' thistle, no stem or flower; Fraas: Centaurea spinosa; Sprengel: Cirsium stellatum."}],"n_compounds":37,"top_compounds":[{"name":"nepetin","qid":"Q3347189"},{"name":"cnicin","qid":"Q5137363"},{"name":"retusin","qid":"Q7317390"},{"name":"cirsimaritin","qid":"Q27155276"},{"name":"Salvigenin","qid":"Q63398893"},{"name":"Demethoxysudachitin","qid":"Q83068866"},{"name":"[(3aR,4S,6Z,10Z,11aR)-7-hydroxy-10-(hydroxymethyl)-6-methyl-3-methylidene-2-oxo-3a,4,5,8,9,11a-hexahydrocyclodeca[b]furan-4-yl] (3R)-4-acetyloxy-3-hydroxy-2-methylidenebutanoate","qid":"Q105111239"},{"name":"[(3aR,4S,6E,10Z,11aR)-7-hydroxy-10-(hydroxymethyl)-6-methyl-3-methylidene-2-oxo-3a,4,5,8,9,11a-hexahydrocyclodeca[b]furan-4-yl] (3R)-4-acetyloxy-3-hydroxy-2-methylidenebutanoate","qid":"Q105111240"}],"epmc_total":1,"trials":0,"claims":[{"concept_id":"asthma_dyspnea","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"epilepsy","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:4.160":{"ref":"De materia medica 4.160","headword":"ἱππόφαιστον","lang":"grc","source":"dioscorides","text":"ἱππόφαιστον· φύεται μὲν ἐν τοῖς αὐτοῖς τόποις, ἐν οἷς καὶ τὸ ἱπποφαές, καὶ αὐτὸ γναφικῆς ἀκάνθης εἶδος ὑπάρχον. ἐστι δὲ χαμαιπετές, κεφάλια μόνον ἔχον χαῦνα καὶ φυλλάρια μικρά, — οὔτε δὲ ἄνθος οὔτε καυλὸν φέρει — ῥίζαν παχεῖαν, μαλακήν. ταύτης τὰ φύλλα καὶ τὴν κεφαλὴν καὶ τὴν ῥίζαν χυλίσας ξήραινε καὶ δίδου ὁλκὴν τριωβόλου μετὰ μελικράτου, ἐφ ὧν βούλει ὕδωρ καὶ φλέγμα ἄγειν· ἰδίως δὲ ἡ διʼ αὐτοῦ κάθαρσις ὀρθοπνοίαις καὶ ἐπιλημψίαις καὶ τοῖς περὶ νεῦραπάθεσιν ἁρμόζει.","spans":[{"start":408,"end":414,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":424,"end":431,"concept_id":"epilepsy","polarity":"therapeutic"}]}},"images":[]}