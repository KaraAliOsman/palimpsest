,"evidence_tier":"unstudied"},{"concept_id":"gout","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":2.37,"evidence_tier":"sparse"},{"concept_id":"nausea_vomiting","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.65,"evidence_tier":"unstudied"},{"concept_id":"scaly_skin","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.73,"evidence_tier":"unstudied"},{"concept_id":"spleen_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":1.51,"evidence_tier":"sparse"}],"lead_score":null},"texts":{"dsc:1.34":{"ref":"De materia medica 1.34","headword":"ἐοικότως δὲ καὶ","lang":"grc","source":"dioscorides","text":"ἐοικότως δὲ καὶ τὸ βαλάνινον ἐργάζεται. δύναμιν δὲ ἔχει καθαρτικὴν σπίλων, φακῶν, ἰόνθων, οὐλῶν μελανίας, κοιλίας τε μαλακτικήν. ἔστι δὲ κακοστόμαχον· ἁρμόζει δὲ καὶ ὠταλγίαις καὶ ἤχοις καὶ συριγμοῖς μετὰ χηνείου στέατος ἐγχεόμενον. ὁμοίως δὲ σκευάζεται τοῖς προειρημένοις τό τε σησάμινον ἐκ τοῦ σησάμου καὶ τὸ καρύινον ἐκ τῶν βασιλικῶν καρύων συντιθέμενον. δύναμιν δὲ ἔχουσι τὴν αὐτὴν τῷ βαλανίνῳ.","spans":[{"start":67,"end":73,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":82,"end":86,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":106,"end":121,"concept_id":"constipation","polarity":"action"},{"start":137,"end":147,"concept_id":"dyspepsia","polarity":"adverse"},{"start":166,"end":171,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":180,"end":185,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":190,"end":196,"concept_id":"ear_disease","polarity":"therapeutic"}]},"dsc:4.157":{"ref":"De materia medica 4.157","headword":"βάλανος μυρεψική","lang":"grc","source":"dioscorides","text":"βάλανος μυρεψική· καρπός ἐστι δένδρου μυρίκη ἐοικότος, ὅμοιος τῳ λεγομένῳ Ποντικῷ καρύᾳ, οὖ τὸ ἐντὸς θλιβόμενον ὥσπερ τὰ πικρὰ ἀμύγδαλα ἐξίησιν ὑγρόν, ᾧ εἰς τὰ πολυτελῆ μύρα ἀντὶ ἐλαίου χρῶνται. γεννᾶται δὲ ἐν Αἰθιοπίᾳ καὶ Αἰγόπτῳ καὶ Ἀραβίᾳ καὶ ἐν τῇ κατὰ Ἰουδαίαν Πέτρᾳ. διαφέρει δὲ αὐτῆς ἡ νέα καὶ πλήρης καὶ λευκὴ καὶ εὐλέπιστος, ἥτις μετʼ ὀξυκράτου ποθεῖσα λεία ὅσον ὁλκὴ δραχμῆς μιᾶς 2 σπλῆνα τήκει· καὶ καταπλάσσεται δὲ ἐπʼ αὐτῶν μετά αἰρίνου ἀλεύρου καὶ μελικράτου καὶ ἐπὶ ποδαγρικῶν, σὺν ὄξει δὲ ἀποσμᾷ ψώραν, λέπραν, ἀλφούς, οὐλὰς μελαίνας, σὺν οὔρῳ δὲ αἴρει φακούς, ἰόνθους, ἐφήλεις, ἐξανθήματα τὰ ἐν προσώπῳ, ἐμέτους τε κινεῖ καὶ κοιλίαν λύει μετὰ ὑδρομέλιτος. κακοστόμαχος δέ ἐστιν ἱκανῶς, καὶ τὸ ἐξ αὐτῆς δὲ ἔλαιον ποθὲν τὴν κοιλίαν ὑπάγει. στυπτικώτερος δʼ ἐστὶν ὁ φλοιὸς αὐτῆς· τὸ δὲ ἐκθλιβείσης αὐτῆς πίεσμα μείγνυται σμήγμασι τοῖς πρὸς τραχύτητας καὶ, κνησμούς ἁρμόζουσιν.","spans":[{"start":392,"end":398,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":481,"end":487,"concept_id":"gout","polarity":"therapeutic"},{"start":512,"end":517,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":519,"end":523,"concept_id":"scaly_skin","polarity":"therapeutic"},{"start":527,"end":533,"concept_id":"scaly_skin","polarity":"therapeutic"},{"start":535,"end":547,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":569,"end":575,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":577,"end":581,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":586,"end":590,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":595,"end":602,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":621,"end":635,"concept_id":"nausea_vomiting","polarity":"action"},{"start":632,"end":649,"concept_id":"constipation","polarity":"action"},{"start":673,"end":683,"concept_id":"dyspepsia","polarity":"adverse"},{"start":739,"end":751,"concept_id":"constipation","polarity":"action"},{"start":870,"end":875,"concept_id":"itch_scabies","polarity":"therapeutic"}]}},"images":[]}