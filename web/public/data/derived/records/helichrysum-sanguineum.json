l},"texts":{"dsc:3.44":{"ref":"De materia medica 3.44","headword":"βάκχαρις","lang":"grc","source":"dioscorides","text":"βάκχαρις· βοτάνη ἐστὶν εὐώδης, στεφανωματική, ἦς τὰ φύλλα τραχέα, μέγεθος ἔχοντα μεταξύ ἴου καὶ φλόμου· καυλὸς δὲ γωνιώδης, πήχεως τὸ ὕψος, ὑπότραχυς, ἔχων παραφυάδας, ἄνθη δὲ ἐμπόφρυρα, ὑπόλευκα εὐώδη, ῥίζαι δὲ ὅμοιαι ταῖς τοῦ μέλανος ἐλλεβόρου, ἐοικυῖαι τῇ ὀσμῇ κινναμώμῳ. φιλεῖ δὲ τραχέα χωρία καὶ ἄνικμα. ταύτης ἡ ῥίζα ἐψηθεῖσα ἐν ὕδατι βοηθεῖ σπάσμασι, πτώμασι, δήγμασι, δυσπνοίαις, βηχὶ χρονίᾳ, δυσουρίᾳ· ἄγει δὲ καὶ ἔμμηνα καὶ θηριοδήκτοις χρησίμως σὺν οἴνῳ δίδοται. προστεθεῖσα δὲ μία τῶν ῥιζῶν ἀπαλῶν ἕλκει ἔμβρυα, ταῖς τε λοχοῖς εἰς ἐγκάθισμα τὸ ἀφέψημα αὐτῆς ἁρμόζει καὶ εἰς διαπάσματα χρησιμεύει ἱκανὴν ἔχουσα τὴν εὐωδίαν. τὰ δὲ φύλλα στυπτικὰ ὄντα καταπλασσόμενα ὠφελεῖ κεφαλαλγίαν καὶ ὀφθαλμῶν φλεγμονάς καὶ αἰγίλωπα ἀρχόμενον καὶ μαστούς ἐκ τοκετῶν φλεγμαίνοντας καὶ ἐρυσιπέλατα· ἐστι δὲ καὶ ὑπνοποιοὸς ἡ ὀσμή.","spans":[{"start":348,"end":355,"concept_id":"convulsions","polarity":"therapeutic"},{"start":358,"end":363,"concept_id":"bruises","polarity":"therapeutic"},{"start":376,"end":382,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":388,"end":391,"concept_id":"cough","polarity":"therapeutic"},{"start":401,"end":407,"concept_id":"dysuria","polarity":"therapeutic"},{"start":411,"end":429,"concept_id":"amenorrhea","polarity":"action"},{"start":434,"end":443,"concept_id":"envenomation","polarity":"therapeutic"},{"start":683,"end":694,"concept_id":"headache","polarity":"therapeutic"},{"start":699,"end":713,"concept_id":"conjunctivitis","polarity":"therapeutic"},{"start":708,"end":715,"concept_id":"inflammation","polarity":"therapeutic"},{"start":745,"end":761,"concept_id":"lactation","polarity":"therapeutic"},{"start":764,"end":772,"concept_id":"inflammation","polarity":"therapeutic"},{"start":782,"end":790,"concept_id":"erysipelas","polarity":"therapeutic"},{"start":807,"end":814,"concept_id":"insomnia","polarity":"action"}]}},"