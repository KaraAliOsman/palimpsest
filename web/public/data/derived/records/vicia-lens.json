{"slug":"vicia-lens","plant":{"taxon":"Vicia lens","family":"Fabaceae","rank":"species","gbif_key":3973001,"wikidata":"Q111391147","iucn":null,"gbif_occurrences":65711,"common_name":"lentil","names":[{"source":"dioscorides","name":"φακός","monograph_id":"dsc:2.107","confidence":"high","note":"Lentil; standard."}],"n_compounds":0,"top_compounds":[],"epmc_total":3,"trials":0,"claims":[{"concept_id":"diarrhea","dsc":3,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.98,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":2,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"conjunctivitis","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"constipation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"dermatitis","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.98,"evidence_tier":"unstudied"},{"concept_id":"erysipelas","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"eye_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.94,"evidence_tier":"unstudied"},{"concept_id":"gout","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"hemorrhoids","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"inflammation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.87,"evidence_tier":"unstudied"},{"concept_id":"lactation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"scrofula","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:2.107":{"ref":"De materia medica 2.107","headword":"φακὸς βιβρωσκόμενος συνεχῶς","lang":"grc","source":"dioscorides","text":"φακὸς βιβρωσκόμενος συνεχῶς ἀμβλυωπός, δύσπεπτος, κακοστόμαχος, πνευματωτικὸς στομάχου καὶ ἐντέρων, κοιλίας τε σταλτικὸς σύν τῷ λέπει ἑψόμενος· διαφέρει δὲ αὐτοῦ ὁ ἑψανὸς καὶ μηδὲν ἀνιεὶς ἐν τῇ βροχῇ μέλαν. δύναμιν δὲ ἔχει στυπτικήν, ὅθεν κοιλίαν ἵστησι προαπολεπισθεὶς καὶ ἑψηθεὶς ἐπιμελῶς, τοῦ πρώτου ἐν τῳ ἀφέψεσθαι ὕδατος ἀποχεομένου· λυτικὸν γὰρ κοιλίας τὸ ἀφέψημα αὐτοῦ. ἐστι δὲ δυσόνειρος, ἄθετος πρὸς τὰ νευρώδη καὶ πνεύμονα καὶ κεφαλήν. βέλτιον δὲ τὸ ἴδιον 2 ἔργον ἀποτελεῖ πρὸς τὰ ῥεύματα τῆς κοιλίας, μιγείσης αὐτῷ σέριδος ἢ κιχορίου ἢ ἀρνογλώσσου ἢ ἀνδράχνης ἢ σεύτλου μέλανος ἢ μύρτων ἢ σιδίων ἢ οὔων ξηρῶν ἢ μεσπίλων ἢ κυδωνίων ἢ ἀπίων ἢ φοινίκων Θηβαικῶν ἢ κηκίδων ὁλοκλήρων, αἵτινες μετὰ τὴν ἓψησιν ῥίπτονται, ἢ ῥοὸς τοῦ ἐπὶ τὰ ὄψα· δεῖ δὲ τὸ ὄξος ἐπιμελῶς συγκαθεψεῖν αὐτῷ, εἰ δὲ μή γε, ταράττει τὴν κοιλίαν καὶ ἀνατροπὴν δὲ στομάχου περιπτισθέντες τριάκοντα φακοὶ καὶ καταποθέντες ὠφελοῦσι. παρηγορεῖ δὲ καὶ ποδάγρας σύν ἀλφίτῳ ἑφθὸς καταπλασθείς, μετὰ μέλιτος δὲ κόλπους κολλᾷ, ἐσχάρας περιρρήττει, ἕλκη τε ἀνακαθαίρει, σὺν ὄξει δὲ ἑψηθεὶς σκληρώματα καὶ χοιράδας διαχεῖ. 3 σύν μελιλώτῳ δὲ ἢ κυδωνίῳ ὀφθαλμῶν φλεγμονάς καὶ δακτυλίου θεραπεύει ῥοδίνου μειγνυμένου, ἐπὶ δὲ τῶν μειζόνων περὶ δακτύλιον φλεγμονῶν καὶ κόλπων μεγάλων σύν σιδίοις ἢ ῥόδοις ξηροῖς ἡψημένοις μειγνυμένου καὶ μέλιτος, πρὸς νομὰς δὲ γαγγραινικάς ὁμοίως ἢ καὶ θαλάσσης μειγνυμένης, πρὸς δὲ φλυκταίνας καὶ ἕρπητας καὶ ἐρυσιπέλατα καὶ χιμέτλας, ὡς προείρηται, πρὸς δὲ χονδριῶντας μαστοὺς καὶ σπαργήσεις ἑψόμενος ἐν θαλάσσῃ ἁρμόζει καταπλασθείς.","spans":[{"start":28,"end":35,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":39,"end":48,"concept_id":"dyspepsia","polarity":"adverse"},{"start":50,"end":60,"concept_id":"dyspepsia","polarity":"adverse"},{"start":64,"end":75,"concept_id":"flatulence","polarity":"adverse"},{"start":100,"end":120,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":239,"end":253,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":339,"end":358,"concept_id":"constipation","polarity":"action"},{"start":385,"end":3