ift":0.95,"evidence_tier":"unstudied"},{"concept_id":"rabies","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"syphilis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.98,"evidence_tier":"unstudied"},{"concept_id":"tinea","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.96,"evidence_tier":"unstudied"},{"concept_id":"vertigo","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.98,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"cul:063-carduus-benedictus":{"ref":"Culpeper, Complete Herbal: Carduus Benedictus","headword":"Carduus Benedictus","lang":"en","source":"culpeper","text":"It is an herb of Mars, and under the sign of Aries. Now, in handling this herb, I shall give you a rational pattern of all the rest; and if you please to view them throughout the book, you shall, to your content, find it true. It helps swimming and giddiness of the head, or the disease called vertigo, because Aries is in the house of Mars. It is an excellent remedy against the yellow jaundice and other infirmities of the gall, because Mars governs choler. It strengthens the attractive faculty in man, and clarifies the blood, because the one is ruled by Mars. The continual drinking the decoction of it, helps red faces, tetters, and ring-worms, because Mars causes them. It helps the plague, sores, boils, and itch, the bitings of mad dogs and venomous beasts, all which infirmities are under Mars; thus you see what it doth by sympathy. By antipathy to other planets it cures the French pox. By antipathy to Venus, who governs it, it strengthens the memory, and cures deafness by antipathy to Saturn, who has his fall in Aries, which rules the head. It cures quartan agues, and other diseases of melancholy, and adust choler, by sympathy to Saturn, Mars being exalted in Capricorn. Also provokes urine, the stopping of which is usually caused by Mars or the Moon.","spans":[{"start":236,"end":270,"concept_id":"vertigo","polarity":"therapeutic"},{"start":294,"end":301,"concept_id":"vertigo","polarity":"therapeutic"},{"start":387,"end":395,"concept_id":"jaundice","polarity":"therapeutic"},{"start":626,"end":633,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":639,"end":649,"concept_id":"tinea","polarity":"therapeutic"},{"start":690,"end":696,"concept_id":"plague","polarity":"therapeutic"},{"start":698,"end":703,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":705,"end":710,"concept_id":"abscess","polarity":"therapeutic"},{"start":716,"end":720,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":737,"end":745,"concept_id":"rabies","polarity":"therapeutic"},{"start":750,"end":758,"concept_id":"envenomation","polarity":"therapeutic"},{"start":894,"end":897,"concept_id":"syphilis","polarity":"therapeutic"},{"start":957,"end":963,"concept_id":"memory","polarity":"therapeutic"},{"start":975,"end":983,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":1066,"end":1073,"concept_id":"malaria","polarity":"therapeutic"},{"start":1091,"end":1113,"concept_id":"melancholy","polarity":"therapeutic"},{"start":1194,"end":1208,"concept_id":"diuresis","polarity":"action"}]}},"gloss":{"cul:063-carduus-benedictus":{"236":"swimming in the head; turning of the brain; dizziness","294":"vertigo","387":"yellow jaundice, black jaundice","626":"tetters: vesicular or scaly eruptions (eczema, herpes)","639":"ringworm","690":"plague","698":"sores, running sores","705":"boils","716":"itch, itches, itching","737":"biting of a mad dog: rabies","750":"venomous beasts / creatures","894":"the (French) pox: syphilis","957":"memory","975":"deafness","1066":"quartan ague (fever every fourth day)","1091":"diseases of melancholy; pensiveness; heaviness of spirit","1194":"provokes urine: diuretic"}},"images":[]}