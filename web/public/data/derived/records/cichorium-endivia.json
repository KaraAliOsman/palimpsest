:0,"lift":0.27,"evidence_tier":"unstudied"},{"concept_id":"liver_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":3,"lift":1.87,"evidence_tier":"sparse"},{"concept_id":"plague","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.54,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.84,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:2.132":{"ref":"De materia medica 2.132","headword":"σέρις ἀγρία καὶ","lang":"grc","source":"dioscorides","text":"σέρις ἀγρία καὶ ἥμερος, ὧν ἡ μὲν ἀγρία πικρὶς ἢ καλεῖται, ἥτις ἐστὶ καὶ πλατυφυλλοτέρα καὶ εὐστομαχμωτέρα τῆς κηπευτῆς. καὶ τῆς κηπευτῆς δὲ διττὸν εῖδος· ἡ μὲν γάρ τίς ἐστι θριδακωδεστέρα καὶ πλατύφυλλος ἡ δὲ στενόφυλλος καὶ ἔμπικρος. πᾶσαι δὲ στυπτικαὶ καὶ ψυκτικαὶ καὶ εὐστόμαχοι. ἱστᾶσι δὲ καὶ κοιλίαν ἑφθαὶ μετ᾿ ὄξους λαμβανόμεναι, καὶ μάλιστα αἱ ἄγριαι εὐστομαχώτεραι· βρωθεῖσαι γὰρ ἀτονοῦντα στόμαχον παρηγοροῦσι καὶ καυσούμενον καὶ καταπλασσόμεναι σὺν ἀλφίτῳ καὶ καθʼ ἑαυτάς, καὶ καρδιακοῖς εἰσι κατάπλασμα χρήσιμοι δὲ καὶ ποδάγραις καὶ ὀχθαλμῶν φλεγμοναῖς βοηθοῦσιν. ἡ δὲ πόα καὶ ἡ ῥίζα καταπλασθεῖσα σκορπιοπλήκτοις ἀρήγει καὶ ἐρυσιπέλασι σὺν ἀλφίτῳ. σὺν ψιμυθίῳ δὲ καὶ ὄξει ὁ χυλὸς αὐτῶν ἐπίχριστος τῶν ψύξεως δεομένων.","spans":[{"start":91,"end":99,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":271,"end":279,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":283,"end":302,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":358,"end":366,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":487,"end":494,"concept_id":"heart","polarity":"therapeutic"},{"start":530,"end":536,"concept_id":"gout","polarity":"therapeutic"},{"start":553,"end":560,"concept_id":"inflammation","polarity":"therapeutic"},{"start":609,"end":621,"concept_id":"envenomation","polarity":"therapeutic"},{"start":636,"end":644,"concept_id":"erysipelas","polarity":"therapeutic"}]},"cul:114-endive":{"ref":"Culpeper, Complete Herbal: Endive","headword":"Endive","lang":"en","source":"culpeper","text":"It is a fine cooling, cleansing, jovial plant. The decoction of the leaves, or the juice, or the distilled water of Endive, serve well to cool the excessive heat of the liver and stomach, and in the hot fits of agues, and all other inflammations in any part of the body; it cools the heat and sharpness of the urine, and excoriation in the urinary parts. The seeds are of the same property, or rather more powerful, and besides are available for fainting, swoonings, and passions of the heart. Outwardly applied, they serve to temper the sharp humours of fretting ulcers, hot tumours, swellings, and pestilential sores; and wonderfully help not only the redness and inflammations of the eyes, but the dimness of the sight also; they are also used to allay the pains of the gout. You cannot use it amiss; a syrup of it is a fine cooling medicine for fevers.","spans":[{"start":157,"end":174,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":199,"end":207,"concept_id":"fever","polarity":"therapeutic"},{"start":211,"end":216,"concept_id":"fever","polarity":"therapeutic"},{"start":232,"end":245,"concept_id":"inflammation","polarity":"therapeutic"},{"start":293,"end":315,"concept_id":"dysuria","polarity":"therapeutic"},{"start":321,"end":347,"concept_id":"dysuria","polarity":"therapeutic"},{"start":446,"end":454,"concept_id":"heart","polarity":"therapeutic"},{"start":456,"end":465,"concept_id":"heart","polarity":"therapeutic"},{"start":471,"end":492,"concept_id":"heart","polarity":"therapeutic"},{"start":564,"end":570,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":572,"end":583,"concept_id":"inflammation","polarity":"therapeutic"},{"start":600,"end":612,"concept_id":"plague","polarity":"therapeutic"},{"start":613,"end":618,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":701,"end":721,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":773,"end":777,"concept_id":"gout","polarity":"therapeutic"},{"start":849,"end":855,"concept_id":"fever","polarity":"therapeutic"}]}},"gloss":{"dsc:2.132":{"91":"good for the stomach (εὐστόμαχος)","271":"good for the stomach (εὐστόμαχος)","283":"checks ... the bowels","358":"good for the stomach (εὐστόμαχος)","487":"the cardiac affection (καρδιακοί)","530":"gout (ποδάγρα)","553":"inflammations (φλεγμοναί)","609":"scorpion-stung (σκορπιόπληκτοι)","636":"erysipelas"},"cul:114-endive":{"157":"obstructions / heat of the liver","199":"hot fits of agues","211":"agues: intermittent fevers","232":"inflammations","293":"heat / sharpness of urine; difficulty of making water","321":"excoriation of the urinary passages","446":"faintings, fainting spirits","456":"swoonings: syncope","471":"passions of the heart: palpitations","564":"ulcers (old, foul, running, fretting)","572":"hot / red / painful swellings (phlegmone)","600":"pestilence, pestilential fevers / sores","613":"sores, running sores","654":"redness / inflammations / heat of the eyes","701":"dimness of sight","773":"gout","849":"fevers"}},"images":[]}