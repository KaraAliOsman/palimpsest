.84,"evidence_tier":"unstudied"},{"concept_id":"urolithiasis","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.96,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:1.92":{"ref":"De materia medica 1.92","headword":"παλίουρος γνώριμος θάμνος","lang":"grc","source":"dioscorides","text":"παλίουρος γνώριμος θάμνος ἀκανθώδης, στερεός, οὖ τὸ σπέρμα λιπαρὸν καὶ γλινῶδες εὐρίσκεται· ὅπερ πινόμενον βηξὶν ἀρήγει καὶ τούς ἐν κύστει λίθους θρύπτει καὶ πρὸς ἑρπετῶν δήγματα ποιεῖ, τὰ δὲ φύλλα καὶ ἠ ῥίζα στυπτικά, ὧν τὸ ἀφέψημα ποθὲν κοιλίαν ἵστησιν, οὖρά τε ἄγει καὶ θανασίμοις καὶ θηριοδήκτοις βοηθεῖ, διαφορεῖ δὲ πάντα τὰ πρόσφατα φύματα καὶ οἰδήματα ἡ ῥίζα λεία ἐπιπλασθεῖσα.","spans":[{"start":132,"end":138,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":139,"end":151,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":163,"end":175,"concept_id":"envenomation","polarity":"therapeutic"},{"start":239,"end":254,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":256,"end":268,"concept_id":"diuresis","polarity":"action"},{"start":273,"end":280,"concept_id":"poisoning","polarity":"therapeutic"},{"start":288,"end":297,"concept_id":"envenomation","polarity":"therapeutic"},{"start":339,"end":345,"concept_id":"abscess","polarity":"therapeutic"},{"start":350,"end":355,"concept_id":"inflammation","polarity":"therapeutic"}]}},"gloss":{"dsc:1.92":{"132":"bladder (κύστις)","139":"breaks up stones (λίθους θρύπτει)","163":"bites of beasts, snakes, vipers, shrews","239":"binds / checks the bowels","256":"moves the urine","273":"deadly poisons (τὰ θανάσιμα)","288":"bitten by wild beasts (θηριόδηκτοι)","339":"tumours, inflamed swellings (φύματα)","350":"swellings (οἰδήματα)"}},"images":[]}