l":0,"persistent":false,"epmc_pair":0,"lift":0.6,"evidence_tier":"unstudied"},{"concept_id":"labor","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.49,"evidence_tier":"unstudied"},{"concept_id":"scrofula","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.77,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":2.39,"evidence_tier":"sparse"},{"concept_id":"spleen_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":4,"lift":2.99,"evidence_tier":"sparse"},{"concept_id":"urolithiasis","dsc":1,"cul":0,"persistent":false,"epmc_pair":3,"lift":5.58,"evidence_tier":"sparse"}],"lead_score":null},"texts":{"dsc:4.134":{"ref":"De materia medica 4.134","headword":"ἀδίαντον","lang":"grc","source":"dioscorides","text":"ἀδίαντον· οἱ δὲ πολύτριχον· φυλλάρια ἔχει ὅμοια κοριάνδρῳ, ἐπεσχισμένα ἐπʼ ἄκρου, τὰ δὲ ῥαβδία, ἐφʼ ὧν ἐκπέφυκε, μέλανα ἰσχυρῶς, λεπτά, σπιθαμιαῖα· οὔτε δὲ καυλίον οὔτε ἄνθος οὔτε καρπὸν φέρει· ῥίζα ἄχρηστος. δύναται δὲ τὸ ἀφέψημα τῆς πόας βοηθεῖν πινόμενον ἀσθματικοῖς, ἰκτερικοῖς, σπληνικοῖς, δυσουροῦσι· θρύπτει δὲ καὶ λίθους καὶ κοιλίαν ἵστησι καὶ θηριοδήκτοις βοηθεῖ καὶ στομάχου ῥεύματι σὺν οἴνῳ ποθέν· κινεῖ δὲ καὶ ἔμμηνα καὶ λοχεῖα, ἵστησι καὶ αἵματος ἀναγωγήν. καταπλάττεται δὲ καὶ πρὸς θηριώδη ἔλκη καὶ ἀλωπεκίας δασύνει, χοιράδας σκορπίζει, ἀποσμᾷ πίτυρα καὶ ἀχῶρας σὺν κονίᾳ. σὺν λαδάνῳ δὲ καὶ μυρσινίνῳ καὶ σουσίνῳ ἢ καὶ ὑσσώπῳ καὶ οἴνῳ τρίχας ῥεούσας παρακρατεῖ, καὶ τὸ ἀφέψημα δὲ αὐτοῦ σὺν οἴνῳ καὶ κονίᾳ σμηχόμενον. ποιεῖ δὲ καὶ τούς ἀλεκτρυόνας καὶ τούς ὄρτυγας μαχίμους εἶναι μειγνύμενον τῇ τροφῇ· φυτεύεται δὲ ἐπʼ ὠφελείᾳ προβάτων ἐν ταῖς μάνδραις. φύεται δὲ ἐν παλισκίοις τόποις καὶ τοίχοις ἐνίκμοις καὶ περὶ τάς κρήνας.","spans":[{"start":258,"end":262,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":271,"end":276,"concept_id":"jaundice","polarity":"therapeutic"},{"start":283,"end":293,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":295,"end":301,"concept_id":"dysuria","polarity":"therapeutic"},{"start":307,"end":325,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":333,"end":347,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":352,"end":361,"concept_id":"envenomation","polarity":"therapeutic"},{"start":376,"end":391,"concept_id":"dyspepsia","polarity":"therapeutic"},{"start":409,"end":428,"concept_id":"amenorrhea","polarity":"action"},{"start":433,"end":438,"concept_id":"labor","polarity":"therapeutic"},{"start":441,"end":459,"concept_id":"hemorrhage","polarity":"therapeutic"},{"start":452,"end":466,"concept_id":"hemoptysis","polarity":"therapeutic"},{"start":504,"end":508,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":513,"end":520,"concept_id":"alopecia","polarity":"therapeutic"},{"start":532,"end":538,"concept_id":"scrofula","polarity":"therapeutic"},{"start":552,"end":565,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":570,"end":574,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":650,"end":662,"concept_id":"alopecia","polarity":"therapeutic"}]}},"gloss":{"dsc:4.134":{"258":"asthma (ἆσθμα, ἀσθματικοί)","271":"jaundice (ἴκτερος, ἰκτερικοί)","283":"the spleen / spleen patients (σπληνικοί)","295":"dysuria (δυσουρία, δυσουροῦντες)","307":"breaks up stones (λίθους θρύπτει)","333":"binds / checks the bowels","352":"bitten by wild beasts (θηριόδηκτοι)","376":"stomach painful / burning / fluxing / relaxed","409":"brings on ... the menses","433":"lochia (λοχεῖα)","441":"staunches blood","452":"bringing up / spitting of blood","504":"ulcers (ἕλκη, ἑλκώσεις)","513":"alopecia (ἀλωπεκία)","532":"scrofulous glands (χοιράδες)","552":"dandruff (πίτυρα, with ἀχῶρες)","570":"scurf of the scalp (ἀχῶρες)","650":"falling hair; hair growth"}},"images":[]}