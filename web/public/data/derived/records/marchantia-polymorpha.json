{"slug":"marchantia-polymorpha","plant":{"taxon":"Marchantia polymorpha","family":"Marchantiaceae","rank":"species","gbif_key":2688570,"wikidata":"Q992846","iucn":null,"gbif_occurrences":77745,"common_name":"common liverwort","names":[{"source":"dioscorides","name":"λειχὴν ὁ ἐπὶ τῶν πετρῶν","monograph_id":"dsc:4.53","confidence":"medium","note":"Moss-like growth on wet rocks, used for lichen (skin); liverwort (Berendes)."},{"source":"culpeper","name":"Liverwort","monograph_id":"cul:181-liverwort","confidence":"medium","note":"Flat thallus on damp shady ground with small stalked star-like heads (receptacles) fits Marchantia."}],"n_compounds":103,"top_compounds":[{"name":"beta-sitosterol","qid":"Q121802"},{"name":"tryptophan","qid":"Q181003"},{"name":"adenosine","qid":"Q190012"},{"name":"oleic acid","qid":"Q207688"},{"name":"stearic acid","qid":"Q209685"},{"name":"palmitic acid","qid":"Q209727"},{"name":"alpha-linolenic acid","qid":"Q256502"},{"name":"abscisic acid","qid":"Q332211"}],"epmc_total":1190,"trials":0,"claims":[{"concept_id":"dermatitis","dsc":2,"cul":1,"persistent":true,"epmc_pair":0,"lift":0.12,"evidence_tier":"unstudied"},{"concept_id":"inflammation","dsc":1,"cul":1,"persistent":true,"epmc_pair":4,"lift":0.14,"evidence_tier":"sparse"},{"concept_id":"jaundice","dsc":1,"cul":1,"persistent":true,"epmc_pair":0,"lift":0.18,"evidence_tier":"unstudied"},{"concept_id":"liver_disease","dsc":0,"cul":2,"persistent":false,"epmc_pair":2,"lift":0.18,"evidence_tier":"sparse"},{"concept_id":"dyspepsia","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.15,"evidence_tier":"unstudied"},{"concept_id":"hemorrhage","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.03,"evidence_tier":"unstudied"},{"concept_id":"itch_scabies","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.31,"evidence_tier":"unstudied"},{"concept_id":"kidney_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.04,"evidence_tier":"unstudied"},{"concept_id":"leukorrhea","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.58,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.36,"evidence_tier":"unstudied"},{"concept_id":"tinea","dsc":0,"cul":1,"persistent":false,"epmc_pair":13,"lift":3.38,"evidence_tier":"studied"}],"lead_score":0.5793},"texts":{"dsc:4.53":{"ref":"De materia medica 4.53","headword":"λειχὴν ὁ ἐπὶ τῶν πετρῶν","lang":"grc","source":"dioscorides","text":"λειχὴν ὁ ἐπὶ τῶν πετρῶν· βρύον ἐστὶ προσεχόμενον ταῖς ἐνδρόσοις πέτραις. τοῦτο καταπλασθὲν αἱμορραγίαν ἵστησι καὶ φλεγμονὰς παραιτεῖται καὶ λειχῆνας θεραπεύει· ὠφελεῖ καὶ ἰκτερικούς μετὰ μέλιτος διαχριομένου στόματος καὶ γλώσσης καὶ ῥευματισμούς παραιτεῖται.","spans":[{"start":0,"end":6,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":91,"end":99,"concept_id":"hemorrhage","polarity":"therapeutic"},{"start":114,"end":121,"concept_id":"inflammation","polarity":"therapeutic"},{"start":140,"end":146,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":171,"end":176,"concept_id":"jaundice","polarity":"therapeutic"}]},"cul:181-liverwort":{"ref":"Culpeper, Complete Herbal: Liverwort","headword":"Liverwort","lang":"en","source":"culpeper","text":"It is under the dominion of Jupiter, and under the sign Cancer. It is a singularly good herb for all the diseases of the liver, both to cool and cleanse it, and helps the inflammations in any part, and the yellow jaundice likewise. Being bruised and boiled in small beer, and drank, it cools the heat of the liver and kidneys, and helps the running of the reins in men, and the whites in women; it is a singular remedy to stay the spreading of tetters, ringworms, and other fretting and running sores and scabs, and is an excellent remedy for such whose livers are corrupted by surfeits, which cause their bodies to break out, for it fortifies the liver exceedingly, and makes it impregnable.","spans":[{"start":105,"end":126,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":171,"end":184,"concept_id":"inflammation","polarity":"therapeutic"},{"start":213,"end":221,"concept_id":"jaundice","polarity":"therapeutic"},{"start":296,"end":313,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":318,"end":325,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":378,"end":384,"concept_id":"leukorrhea","polarity":"therapeutic"},{"start":444,"end":451,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":453,"end":462,"concept_id":"tinea","polarity":"therapeutic"},{"start":495,"end":500,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":505,"end":510,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":578,"end":586,"concept_id":"dyspepsia","polarity":"therapeutic"}]}},"gloss":{"dsc:4.53":{"0":"lichen, tetter (λειχήν)","91":"haemorrhage (αἱμορραγία)","114":"inflammations (φλεγμοναί)","140":"lichen, tetter (λειχήν)","171":"jaundice (ἴκτερος, ἰκτερικοί)"},"cul:181-liverwort":{"105":"obstructions / heat of the liver","171":"inflammations","213":"yellow jaundice, black jaundice","296":"obstructions / heat of the liver","318":"kidneys","378":"the whites: leucorrhoea","444":"tetters: vesicular or scaly eruptions (eczema, herpes)","453":"ringworm","495":"sores, running sores","505":"scabs: scabies / scabby skin","578":"surfeit: indigestion / sickness from over-eating"}},"images":[]}