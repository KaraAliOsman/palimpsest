ναπλάσσοντες τροχίσκους. γίνεται δὲ καὶ ἄγριον εὔζωμον, μάλιστα δὲ ἐν τῇ κατὰ τὴν ἑσπέραν Ἰβηρίᾳ, οὗ τῷ σπέρματι καὶ ἀντὶ σινἡπεως οἱ τῇδε ἄνθρωποι χρῶνται. ἔστι δὲ οὐρητικώτερον καὶ δριμύτερον πολλῷ τοῦ ἡμέρου.","spans":[{"start":22,"end":29,"concept_id":"sexual_function","polarity":"action"},{"start":79,"end":86,"concept_id":"diuresis","polarity":"action"},{"start":114,"end":121,"concept_id":"constipation","polarity":"action"},{"start":427,"end":434,"concept_id":"diuresis","polarity":"action"}]}},"gloss":{"dsc:2.140":{"22":"sexual intercourse (συνουσία)","79":"diuretic (οὐρητικός, διουρητικός)","114":"loosening the bowels (εὔκοιλιος)","427":"diuretic (οὐρητικός, διουρητικός)"}},"images":["euzomon-118r-dioscoride-vienne"]}