":1,"cul":0,"persistent":false,"epmc_pair":1,"lift":0.28,"evidence_tier":"sparse"},{"concept_id":"envenomation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.27,"evidence_tier":"unstudied"},{"concept_id":"kidney_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":5,"lift":0.14,"evidence_tier":"studied"},{"concept_id":"pain","dsc":0,"cul":1,"persistent":false,"epmc_pair":10,"lift":0.11,"evidence_tier":"studied"},{"concept_id":"pleurisy_pneumonia","dsc":1,"cul":0,"persistent":false,"epmc_pair":3,"lift":0.14,"evidence_tier":"sparse"},{"concept_id":"sexual_function","dsc":1,"cul":0,"persistent":false,"epmc_pair":6,"lift":1.26,"evidence_tier":"studied"},{"concept_id":"uterine_disorders","dsc":0,"cul":1,"persistent":false,"epmc_pair":5,"lift":0.17,"evidence_tier":"studied"}],"lead_score":0.5564},"texts":{"dsc:3.52":{"ref":"De materia medica 3.52","headword":"σταφυλῖνος ἄγριος","lang":"grc","source":"dioscorides","text":"σταφυλῖνος ἄγριος· οἱ δὲ κέρας καλοῦσι. φύλλα μὲν ἔχει ὅμοια γιγγιδίῳ, πλατύτερα δὲ καὶ ὑπόπικρα, καυλὸν δὲ ὄρθιον, τραχύν, σκιάδιον ἔχοντα ἀνήθῳ παραπλήσιον, ἐφʼ οὖ ἄνθη λευκά, ἐν μέσῳ δὲ μικρόν τι προρφυροειδὲς οἱονεὶ κροκύδιον· ῥίζα δὲ δακτύλου πάχος σπιθαμιαία, εὐώδης, ἐδωδίμη ἑφθή. τούτου ὁ καρπὸς ποθεὶς ἦ καὶ προστεθεὶς ἔμμηνα κινεῖ, ἁρμόζει καὶ δυσουροῦσι καὶ ὑδρωπικοῖς καὶ πλευριτικοῖς ἐν ποτήματι καὶ πρὸς θηρίων δὲ δήγματα καὶ πληγάς· τούς δὲ προλαβόντας φασὶ μὴ ἀδικεῖσθαι ὑπὸ τῶν ἑρπετῶν· συνεργεῖ δὲ καὶ συλλήψει. ἡ δὲ ῥίζα καὶ αὐτὴ οὐρητικὴ οὖσα συνουσίαν τε παρορμᾷ καὶ ἔμβρυα ἐκβάλλει προστιθεμένη. τὰ δὲ φύλλα λεῖα μετὰ μέλιτος ἐπιτιθέμενα τὰ φαγεδαινικὰ ἕλκη ἀνακαθαίρει. ὁ δὲ κηπευτὸς σταφυλῖνος ἐδωδιμώτερος ὢν ἁρμόζει πρὸς τὰ αὐτά, καταδεέστερον ἐνεργῶν.","spans":[{"start":328,"end":340,"concept_id":"amenorrhea","polarity":"action"},{"start":354,"end":360,"concept_id":"dysuria","polarity":"therapeutic"},{"start":369,"end":374,"concept_id":"edema_dropsy","polarity":"therapeutic"},{"start":384,"end":391,"concept_id":"pleurisy_pneumonia","polarity":"therapeutic"},{"start":418,"end":432,"concept_id":"envenomation","polarity":"therapeutic"},{"start":520,"end":526,"concept_id":"infertility","polarity":"therapeutic"},{"start":549,"end":556,"concept_id":"diuresis","polarity":"action"},{"start":563,"end":570,"concept_id":"sexual_function","polarity":"action"},{"start":588,"end":603,"concept_id":"abortifacient","polarity":"action"},{"start":663,"end":671,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":675,"end":679,"concept_id":"skin_ulcers","polarity":"therapeutic"}]},"cul:064-carrots":{"ref":"Culpeper, Complete Herbal: Carrots","headword":"Carrots","lang":"en","source":"culpeper","text":"Wild Carrots belong to Mercury, and therefore break wind, and remove stitches in the sides, provoke urine and women’s courses, and helps to break and expel the stone; the seed also of the same works the like effect, and is good for the dropsy, and those whose bellies are swelling with wind; helps the cholic, the stone in the kidneys, and rising of the mother; being taken in wine, or boiled in wine and taken, it helps conception. The leaves being applied with honey to running sores or ulcers, do cleanse them. I suppose the seeds of them perform this better than the roots; and though Galen commended garden Carrots highly to break wind, yet experience teaches they breed it first, and we may thank nature for expelling it, not they; the seeds of them expel wind indeed, and so mend what the root marrs.","spans":[{"start":46,"end":56,"concept_id":"flatulence","polarity":"action"},{"start":69,"end":77,"concept_id":"pain","polarity":"therapeutic"},{"start":92,"end":125,"concept_id":"amenorrhea","polarity":"action"},{"start":160,"end":165,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":236,"end":242,"concept_id":"edema_dropsy","polarity":"therapeutic"},{"start":302,"end":308,"concept_id":"colic","polarity":"therapeutic"},{"start":314,"end":319,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":327,"end":334,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":350,"end":360,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":415,"end":431,"concept_id":"infertility","polarity":"therapeutic"},{"start":480,"end":485,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":489,"end":495,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":630,"end":640,"concept_id":"flatulence","polarity":"action"},{"start":756,"end":766,"concept_id":"flatulence","polarity":"action"}]}},"images":["gemeine-mohre-wiener-dioskurides"]}