l":0,"persistent":false,"epmc_pair":8,"lift":9.04,"evidence_tier":"studied"},{"concept_id":"spleen_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.18,"evidence_tier":"unstudied"},{"concept_id":"uterine_disorders","dsc":1,"cul":0,"persistent":false,"epmc_pair":14,"lift":4.24,"evidence_tier":"studied"},{"concept_id":"wounds","dsc":1,"cul":0,"persistent":false,"epmc_pair":2,"lift":0.69,"evidence_tier":"sparse"}],"lead_score":null},"texts":{"dsc:1.103":{"ref":"De materia medica 1.103","headword":"ἄγνος ᾔ λύγος","lang":"grc","source":"dioscorides","text":"ἄγνος ᾔ λύγος θάμνος ἐστὶ δενδρώδης, παρὰ ποταμοῖς τραχέσι τε τόποις καὶ χαράδραις φυόμενος, ῥάβδους ἔχων δυσθραύστους, φύλλα δὲ ὡσπερεὶ ἐλαίας, ἁπαλώτερα δέ. τὸ δ᾿ ἄνθος ἡ μέν τις λευκὸν σὺν τῳ ὑποπορφυρίζοντι ἡ δὲ πορφυροῦν φέρει, σπέρμα δὲ ὡς πέπερι. δύναμιν δὲ ἔχει θερμαντικήν, μαλακτικήν. ὁ δὲ καρπὸς αὐτῆς πινόμενος βοηθεῖ θηριοδήκτοις, σπληνικοῖς, ὑδρωπικοῖς. κατασπᾷ δὲ καὶ γάλα, καὶ ἔμμηνα ἄγει πινόμενος ὅσον δραχμῆς 2 μιᾶς πλῆθος σὺν οἴνῳ, ἐκλύει δὲ καὶ γονήν, ἅπτεται δὲ καὶ κεφαλῆς κάρον ἐπιφέρων. τὸ δὲ ἀφέψημα αὐτῆς τῆς πόας καὶ τοῦ καρποῦ εἰς ἐγκαθίσματα ταῖς περὶ ὑστέραν διαθέσεσι καὶ φλεγμοναῖς ἀρήγει. ποθὲν δὲ μετὰ γλήχωνος καὶ ὑποθυμιαθὲν τὸ σπέρμα καὶ προστεθὲν κάθαρσιν κινεῖ, λύει δὲ καὶ κεφαλαλγίας καταπλασσόμενον, καὶ ἐπὶ ληθαργικῶν τε καὶ φρενιτικῶν ἐμβρέχεται σὺν ὄξει καὶ ἐλαίῳ. 3 καὶ τὰ φύλλα ὑποθυμιώμενά τε καὶ ὑποστρωννύμενα θηρία διὼκει, καὶ καταπλαττόμενα ἐπὶ τῶν θηριοδήκτων βοηθεῖ, σκληρίας τε διδύμων μετὰ βουτύρου καὶ φύλλων ἀμπέλου μαλάττει, ῥαγάδας τε τὰς ἐν δακτυλίῳ σὺν ὕδατι ἐπιπλασθὲν τὸ σπέρμα πραύνει, σὺν δὲ τοῖς φύλλοις στρέμματά τε καὶ τραύματα ἰᾶται. δοκεῖ δὲ καὶ κωλυτήριον εἶναι ἐν ὁδοιπορίαις παρατριμμάτων, εἴ τις ῥάβδον αὐτῆς παρὰ χεῖρα κρατοίη. νόμασται δὲ ἄγνος διὰ τὸ τὰς ἐν τοῖς Θεσμοφορίοις ἁγνευούσας γυναῖκας εἰς ὑπόστρωμα χρῆσθαι αὐτῇ· λύγος δὲ διὰ τὸ περὶ τὰς ῥάβδους αὐτῆς εὔτονον.","spans":[{"start":330,"end":339,"concept_id":"envenomation","polarity":"therapeutic"},{"start":344,"end":354,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":356,"end":361,"concept_id":"edema_dropsy","polarity":"therapeutic"},{"start":368,"end":399,"concept_id":"amenorrhea","polarity":"action"},{"start":383,"end":404,"concept_id":"lactation","polarity":"action"},{"start":466,"end":471,"concept_id":"sexual_function","polarity":"action"},{"start":582,"end":589,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":604,"end":611,"concept_id":"inflammation","polarity":"therapeutic"},{"start":714,"end":725,"concept_id":"headache","polarity":"therapeutic"},{"start":751,"end":757,"concept_id":"delirium","polarity":"therapeutic"},{"start":769,"end":775,"concept_id":"delirium","polarity":"therapeutic"},{"start":861,"end":871,"concept_id":"envenomation","polarity":"action"},{"start":902,"end":911,"concept_id":"envenomation","polarity":"therapeutic"},{"start":1000,"end":1011,"concept_id":"hemorrhoids","polarity":"therapeutic"},{"start":1072,"end":1078,"concept_id":"bruises","polarity":"therapeutic"},{"start":1089,"end":1095,"concept_id":"wounds","polarity":"therapeutic"},{"start":1150,"end":1159,"concept_id":"dermatitis","polarity":"therapeutic"}]}},"images":["agnos-36v-dioscoride-vienne"]}