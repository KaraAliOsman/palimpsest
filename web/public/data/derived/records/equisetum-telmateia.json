cept_id":"skin_ulcers","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.95,"evidence_tier":"unstudied"},{"concept_id":"urolithiasis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.95,"evidence_tier":"unstudied"},{"concept_id":"wounds","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.64,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"cul:162-horsetail":{"ref":"Culpeper, Complete Herbal: Horsetail","headword":"Horsetail","lang":"en","source":"culpeper","text":"The herb belongs to Saturn, yet is very harmless, and excellently good for the things following: Horsetail, the smoother rather than the rough, and the leaves rather than the bare, is most physical. It is very powerful to staunch bleeding either inward or outward, the juice or the decoction thereof being drank, or the juice, decoction, or distilled water applied outwardly. It also stays all sorts of lasks and fluxes in man or woman, and bloody urine; and heals also not only the inward ulcers, and the excoriation of the entrails, bladder, &c. but all other sorts of foul, moist and running ulcers, and soon solders together the tops of green wounds. It cures all ruptures in children. The decoction thereof in wine being drank, provokes urine, and helps the stone and stranguary; and the distilled water thereof drank two or three times in a day, and a small quantity at a time, also eases the bowels, and is effectual against a cough that comes by distillations from the head. The juice or distilled water being warmed, and hot inflammations, pustules or red wheals, and other breakings-out in the skin, being bathed therewith, doth help them, and doth no less the swelling heat and inflammation of the lower parts in men and women.","spans":[{"start":230,"end":238,"concept_id":"hemorrhage","polarity":"therapeutic"},{"start":403,"end":408,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":441,"end":453,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":535,"end":542,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":595,"end":601,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":612,"end":619,"concept_id":"wounds","polarity":"therapeutic"},{"start":647,"end":653,"concept_id":"wounds","polarity":"therapeutic"},{"start":733,"end":747,"concept_id":"diuresis","polarity":"action"},{"start":763,"end":768,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":773,"end":783,"concept_id":"dysuria","polarity":"therapeutic"},{"start":934,"end":939,"concept_id":"cough","polarity":"therapeutic"},{"start":954,"end":967,"concept_id":"common_cold","polarity":"therapeutic"},{"start":1034,"end":1047,"concept_id":"inflammation","polarity":"therapeutic"},{"start":1049,"end":1057,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":1065,"end":1071,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":1083,"end":1096,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":1189,"end":1201,"concept_id":"inflammation","polarity":"therapeutic"}]}},"images":[]}