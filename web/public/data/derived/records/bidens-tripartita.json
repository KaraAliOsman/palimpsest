ept_id":"spleen_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":1.92,"evidence_tier":"sparse"}],"lead_score":null},"texts":{"cul:006-water-agrimony":{"ref":"Culpeper, Complete Herbal: Water Agrimony","headword":"Water Agrimony","lang":"en","source":"culpeper","text":"It is a plant of Jupiter, as well as the other Agrimony, only this belongs to the celestial sign Cancer. It heals and dries, cuts and cleanses thick and tough humours of the breast, and for this I hold it inferior to but few herbs that grow. It helps the cachexia or evil disposition of the body, the dropsy and yellow-jaundice. It opens obstructions of the liver, mollifies the hardness of the spleen, being applied outwardly. It breaks imposthumes away inwardly: It is an excellent remedy for the third day ague. It provokes urine and the terms; it kills worms, and cleanses the body of sharp humours, which are the cause of itch and scabs; the herb being burnt, the smoke thereof drives away flies, wasps, &c. It strengthens the lungs exceedingly. Country people give it to their cattle when they are troubled with the cough, or broken-winded.","spans":[{"start":301,"end":307,"concept_id":"edema_dropsy","polarity":"therapeutic"},{"start":319,"end":327,"concept_id":"jaundice","polarity":"therapeutic"},{"start":332,"end":363,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":395,"end":401,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":438,"end":449,"concept_id":"abscess","polarity":"therapeutic"},{"start":499,"end":513,"concept_id":"malaria","polarity":"therapeutic"},{"start":518,"end":546,"concept_id":"amenorrhea","polarity":"action"},{"start":557,"end":562,"concept_id":"helminthiasis","polarity":"therapeutic"},{"start":627,"end":631,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":636,"end":641,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":702,"end":707,"concept_id":"envenomation","polarity":"therapeutic"},{"start":822,"end":827,"concept_id":"cough","polarity":"therapeutic"}]}},"gloss":{"cul:006-water-agrimony":{"301":"dropsy, dropsies","319":"yellow jaundice, black jaundice","332":"opens obstructions of / strengthens the liver","395":"spleen: hardness, swelling, stoppings of the spleen","438":"imposthume: abscess","499":"third-day ague: tertian","518":"provokes / brings down the terms, courses: emmenagogue","557":"worms (intestinal)","627":"itch, itches, itching","636":"scabs: scabies / scabby skin","702":"serpents, vipers, adders, scorpions, wasps","822":"cough, coughs"}},"images":[]}