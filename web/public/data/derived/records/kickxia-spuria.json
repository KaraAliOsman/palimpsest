sentery","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"hemorrhage","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.91,"evidence_tier":"unstudied"},{"concept_id":"nosebleed","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":1,"evidence_tier":"unstudied"},{"concept_id":"syphilis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.99,"evidence_tier":"unstudied"},{"concept_id":"wounds","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.94,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"cul:131-fluellin-or-lluellin":{"ref":"Culpeper, Complete Herbal: Fluellin, Or Lluellin","headword":"Fluellin, Or Lluellin","lang":"en","source":"culpeper","text":"It is a Lunar herb. The leaves bruised and applied with barley meal to watering eyes that are hot and inflamed by defluxions from the head, do very much help them, as also the fluxes of blood or humours, as the lask, bloody flux, women’s courses, and stays all manner of bleeding at the nose, mouth, or any other place, or that comes by any bruise or hurt, or bursting a vein; it wonderfully helps all those inward parts that need consolidating or strengthening, and is no less effectual both to heal and close green wounds, than to cleanse and heal all foul or old ulcers, fretting or spreading cankers or the like. This herb is of a fine cooling, drying quality, and an ointment or plaister of it might do a man a courtesy that hath any hot virulent sores: ’Tis admirable for the ulcers of the French pox; if taken inwardly, may cure the desease.","spans":[{"start":71,"end":84,"concept_id":"conjunctivitis","polarity":"therapeutic"},{"start":114,"end":124,"concept_id":"common_cold","polarity":"therapeutic"},{"start":176,"end":191,"concept_id":"hemorrhage","polarity":"therapeutic"},{"start":211,"end":215,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":217,"end":228,"concept_id":"dysentery","polarity":"therapeutic"},{"start":271,"end":291,"concept_id":"nosebleed","polarity":"therapeutic"},{"start":337,"end":347,"concept_id":"bruises","polarity":"therapeutic"},{"start":360,"end":375,"concept_id":"hemorrhage","polarity":"therapeutic"},{"start":517,"end":523,"concept_id":"wounds","polarity":"therapeutic"},{"start":566,"end":572,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":596,"end":603,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":752,"end":757,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":782,"end":788,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":803,"end":806,"concept_id":"syphilis","polarity":"therapeutic"}]}},"images":[]}