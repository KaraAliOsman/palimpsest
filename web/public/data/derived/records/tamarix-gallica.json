sistent":false,"epmc_pair":1,"lift":1.24,"evidence_tier":"sparse"},{"concept_id":"itch_scabies","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.91,"evidence_tier":"unstudied"},{"concept_id":"lice","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.94,"evidence_tier":"unstudied"},{"concept_id":"menorrhagia","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.97,"evidence_tier":"unstudied"},{"concept_id":"scaly_skin","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.8,"evidence_tier":"unstudied"},{"concept_id":"syphilis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.9,"evidence_tier":"unstudied"},{"concept_id":"toothache","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.86,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"cul:295-the-tamarisk-tree":{"ref":"Culpeper, Complete Herbal: The Tamarisk Tree","headword":"The Tamarisk Tree","lang":"en","source":"culpeper","text":"A gallant Saturnine herb it is. The root, leaves, young branches, or bark boiled in wine, and drank, stays the bleeding of the hæmorrhodical veins, the spitting of blood, the too abounding of women’s courses, the jaundice, the cholic, and the biting of all venomous serpents, except the asp; and outwardly applied, is very powerful against the hardness of the spleen, and the tooth-ache, pains in the ears, red and watering eyes. The decoction, with some honey put thereto, is good to stay gangrenes and fretting ulcers, and to wash those that are subject to nits and lice. Alpinus and Veslingius affirm, That the Egyptians do with good success use the wood of it to cure the French disease, as others do with lignum vitæ or guiacum; and give it also to those who have the leprosy, scabs, ulcers, or the like. Its ashes doth quickly heal blisters raised by burnings or scaldings. It helps the dropsy, arising from the hardness of the spleen, and therefore to drink out of cups made of the wood is good for splenetic persons. It is also helpful for melancholy, and the black jaundice that arise thereof.","spans":[{"start":111,"end":119,"concept_id":"hemorrhage","polarity":"therapeutic"},{"start":152,"end":169,"concept_id":"hemoptysis","polarity":"therapeutic"},{"start":179,"end":207,"concept_id":"menorrhagia","polarity":"therapeutic"},{"start":213,"end":221,"concept_id":"jaundice","polarity":"therapeutic"},{"start":227,"end":233,"concept_id":"colic","polarity":"therapeutic"},{"start":243,"end":252,"concept_id":"envenomation","polarity":"therapeutic"},{"start":257,"end":265,"concept_id":"envenomation","polarity":"therapeutic"},{"start":266,"end":274,"concept_id":"envenomation","polarity":"therapeutic"},{"start":360,"end":366,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":376,"end":386,"concept_id":"toothache","polarity":"therapeutic"},{"start":388,"end":405,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":407,"end":428,"concept_id":"conjunctivitis","polarity":"therapeutic"},{"start":490,"end":499,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":513,"end":519,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":559,"end":563,"concept_id":"lice","polarity":"therapeutic"},{"start":568,"end":572,"concept_id":"lice","polarity":"therapeutic"},{"start":676,"end":690,"concept_id":"syphilis","polarity":"therapeutic"},{"start":773,"end":780,"concept_id":"scaly_skin","polarity":"therapeutic"},{"start":782,"end":787,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":789,"end":795,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":838,"end":864,"concept_id":"burns","polarity":"therapeutic"},{"start":869,"end":878,"concept_id":"burns","polarity":"therapeutic"},{"start":893,"end":899,"concept_id":"edema_dropsy","polarity":"therapeutic"},{"start":934,"end":940,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":1006,"end":1015,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":1074,"end":1082,"concept_id":"jaundice","polarity":"therapeutic"}]}},"gloss":{"cul:295-the-tamarisk-tree":{"111":"bleeding (inward / outward / of wounds)","152":"spitting of blood","179":"immoderate / overflowing flux of the courses","213":"yellow jaundice, black jaundice","227":"cholic: colic, griping abdominal pain","243":"biting / stinging of (serpents, scorpions, beasts)","257":"venomous beasts / creatures","266":"serpents, vipers, adders, scorpions, wasps","360":"spleen: hardness, swelling, stoppings of the spleen","376":"tooth-ache","388":"pains / noise / singing / worms in the ears","407":"red / hot / watering / inflamed eyes","490":"gangrene","513":"ulcers (old, foul, running, fretting)","559":"nits, fleas, vermin, the lousy evil","568":"lice","676":"French disease: syphilis","773":"leprosy (lepra)","782":"scabs: scabies / scabby skin","789":"ulcers (old, foul, running, fretting)","838":"blisters raised by burnings","869":"scaldings","893":"dropsy, dropsies","934":"spleen: hardness, swelling, stoppings of the spleen","1006":"splenetic: suffering from the spleen","1074":"yellow jaundice, black jaundice"}},"images":[]}