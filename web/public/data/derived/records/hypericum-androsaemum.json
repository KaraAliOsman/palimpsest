{"slug":"hypericum-androsaemum","plant":{"taxon":"Hypericum androsaemum","family":"Hypericaceae","rank":"species","gbif_key":3189525,"wikidata":"Q886411","iucn":null,"gbif_occurrences":124565,"common_name":"tutsan","names":[{"source":"culpeper","name":"Tustan, Or Park Leaves","monograph_id":"cul:314-tustan-or-park-leaves","confidence":"high","note":"Tutsan, park leaves."}],"n_compounds":43,"top_compounds":[{"name":"chromium","qid":"Q725"},{"name":"nonane","qid":"Q150694"},{"name":"1-octene","qid":"Q161664"},{"name":"benzoic acid","qid":"Q191700"},{"name":"(±)-limonene","qid":"Q278809"},{"name":"beta-pinene","qid":"Q300928"},{"name":"kaempferol","qid":"Q393336"},{"name":"quercetin","qid":"Q409478"}],"epmc_total":42,"trials":0,"claims":[{"concept_id":"wounds","dsc":0,"cul":2,"persistent":false,"epmc_pair":2,"lift":2.94,"evidence_tier":"sparse"},{"concept_id":"burns","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":2.53,"evidence_tier":"sparse"},{"concept_id":"constipation","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.92,"evidence_tier":"unstudied"},{"concept_id":"gout","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.88,"evidence_tier":"unstudied"},{"concept_id":"hemorrhage","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.48,"evidence_tier":"unstudied"},{"concept_id":"sciatica","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.92,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.94,"evidence_tier":"unstudied"},{"concept_id":"syphilis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.92,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"cul:314-tustan-or-park-leaves":{"ref":"Culpeper, Complete Herbal: Tustan, Or Park Leaves","headword":"Tustan, Or Park Leaves","lang":"en","source":"culpeper","text":"It is an herb of Saturn, and a most noble anti-venerean. Tustan purges choleric humours, as St. Peter’s-wort, is said to do, for therein it works the same effects, both to help the sciatica and gout, and to heal burning by fire; it stays all the bleedings of wounds, if either the green herb be bruised, or the powder of the dry be applied thereto. It hath been accounted, and certainly it is, a sovereign herb to heal either wound or sore, either outwardly or inwardly, and therefore always used in drinks, lotions, balms, oils, ointments, or any other sorts of green wounds, ulcers, or old sores, in all which the continual experience of former ages hath confirmed the use thereof to be admirably good, though it be not so much in use now, as when physicians and surgeons were so wise as to use herbs more than now they do.","spans":[{"start":42,"end":55,"concept_id":"syphilis","polarity":"therapeutic"},{"start":64,"end":87,"concept_id":"constipation","polarity":"action"},{"start":181,"end":189,"concept_id":"sciatica","polarity":"therapeutic"},{"start":194,"end":198,"concept_id":"gout","polarity":"therapeutic"},{"start":212,"end":227,"concept_id":"burns","polarity":"therapeutic"},{"start":246,"end":255,"concept_id":"hemorrhage","polarity":"therapeutic"},{"start":259,"end":265,"concept_id":"wounds","polarity":"therapeutic"},{"start":426,"end":431,"concept_id":"wounds","polarity":"therapeutic"},{"start":569,"end":575,"concept_id":"wounds","polarity":"therapeutic"},{"start":577,"end":583,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":592,"end":597,"concept_id":"skin_ulcers","polarity":"therapeutic"}]}},"gloss":{"cul:314-tustan-or-park-leaves":{"42":"antivenereal: remedy against the pox","64":"purges choler, phlegm or melancholy downwards: cathartic","181":"sciatica","194":"gout","212":"burning by fire / iron","246":"bleeding (inward / outward / of wounds)","259":"wounds (green, fresh, inward, old); wound-herb","426":"wounds (green, fresh, inward, old); wound-herb","569":"wounds (green, fresh, inward, old); wound-herb","577":"ulcers (old, foul, running, fretting)","592":"sores, running sores"}},"images":[]}