{"slug":"jacobaea-vulgaris","plant":{"taxon":"Jacobaea vulgaris","family":"Asteraceae","rank":"species","gbif_key":5388602,"wikidata":"Q15630491","iucn":null,"gbif_occurrences":813486,"common_name":"common ragwort","names":[{"source":"culpeper","name":"Ragwort","monograph_id":"cul:249-ragwort","confidence":"high","note":"St James-wort/staggerwort with torn leaves: common ragwort."}],"n_compounds":46,"top_compounds":[{"name":"beta-sitosterol","qid":"Q121802"},{"name":"lupeol","qid":"Q409366"},{"name":"putrescine","qid":"Q410190"},{"name":"spermidine","qid":"Q418834"},{"name":"stigmasterol","qid":"Q425004"},{"name":"senecionine","qid":"Q2083871"},{"name":"α-amyrin","qid":"Q2501558"},{"name":"cosmene","qid":"Q24817453"}],"epmc_total":90,"trials":0,"claims":[{"concept_id":"skin_ulcers","dsc":0,"cul":3,"persistent":false,"epmc_pair":0,"lift":0.88,"evidence_tier":"unstudied"},{"concept_id":"abscess","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.71,"evidence_tier":"unstudied"},{"concept_id":"common_cold","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.73,"evidence_tier":"unstudied"},{"concept_id":"conjunctivitis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.84,"evidence_tier":"unstudied"},{"concept_id":"pain","dsc":0,"cul":1,"persistent":false,"epmc_pair":1,"lift":0.56,"evidence_tier":"sparse"},{"concept_id":"sciatica","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.85,"evidence_tier":"unstudied"},{"concept_id":"scrofula","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.86,"evidence_tier":"unstudied"},{"concept_id":"sore_throat","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.9,"evidence_tier":"unstudied"},{"concept_id":"wounds","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.4,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"cul:249-ragwort":{"ref":"Culpeper, Complete Herbal: Ragwort","headword":"Ragwort","lang":"en","source":"culpeper","text":"Ragwort is under the command of Dame Venus, and cleanses, digests, and discusses. The decoction of the herb is good to wash the mouth or throat that hath ulcers or sores therein: and for swellings, hardness, or imposthumes, for it thoroughly cleanses and heals them; as also the quinsy, and the king’s evil. It helps to stay catarrhs, thin rheums, and defluxions from the head into the eyes, nose, or lungs. The juice is found by experience to be singularly good to heal green wounds, and to cleanse and heal all old and filthy ulcers in the privities, and in other parts of the body, as also inward wounds and ulcers; stays the malignity of fretting and running cankers, and hollow fistulas, not suffering them to spread farther. It is also much commended to help aches and pains either in the fleshy part, or in the nerves and sinews, as also the sciatica, or pain of the hips or knuckle-bone, to bathe the places with the decoction of the herb, or to anoint them with an ointment made of the herb bruised and boiled in old hog’s suet, with some Mastick and Olibanum in powder added unto it after it is strained forth. In Sussex we call it Ragweed.","spans":[{"start":154,"end":160,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":164,"end":169,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":211,"end":222,"concept_id":"abscess","polarity":"therapeutic"},{"start":279,"end":285,"concept_id":"sore_throat","polarity":"therapeutic"},{"start":295,"end":306,"concept_id":"scrofula","polarity":"therapeutic"},{"start":325,"end":333,"concept_id":"common_cold","polarity":"therapeutic"},{"start":340,"end":346,"concept_id":"common_cold","polarity":"therapeutic"},{"start":352,"end":390,"concept_id":"conjunctivitis","polarity":"therapeutic"},{"start":477,"end":483,"concept_id":"wounds","polarity":"therapeutic"},{"start":528,"end":534,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":600,"end":606,"concept_id":"wounds","polarity":"therapeutic"},{"start":611,"end":617,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":663,"end":670,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":683,"end":691,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":765,"end":770,"concept_id":"pain","polarity":"therapeutic"},{"start":775,"end":780,"concept_id":"pain","polarity":"therapeutic"},{"start":849,"end":857,"concept_id":"sciatica","polarity":"therapeutic"},{"start":862,"end":878,"concept_id":"sciatica","polarity":"therapeutic"}]}},"images":[]}