tifacient","dsc":1,"cul":0,"persistent":false,"epmc_pair":19,"lift":2.47,"evidence_tier":"studied"},{"concept_id":"cancer","dsc":1,"cul":0,"persistent":false,"epmc_pair":41,"lift":0.14,"evidence_tier":"studied"},{"concept_id":"dermatitis","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.05,"evidence_tier":"unstudied"},{"concept_id":"edema_dropsy","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.03,"evidence_tier":"unstudied"},{"concept_id":"inflammation","dsc":1,"cul":0,"persistent":false,"epmc_pair":24,"lift":0.33,"evidence_tier":"studied"},{"concept_id":"itch_scabies","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.16,"evidence_tier":"unstudied"},{"concept_id":"jaundice","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.08,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:2.104":{"ref":"De materia medica 2.104","headword":"ἐρέβινθος ὁ ἥμερος","lang":"grc","source":"dioscorides","text":"ἐρέβινθος ὁ ἥμερος εὐκοίλιος, οὐρητικός, πνευμάτων γεννητικός, εὐχροίας περιποιητικός, καταμηνίων ἀγωγὸς καὶ ἐμβρύων, καὶ γάλακτος γεννητικός. καταπλάσσεται δὲ μάλιστα ὁ ροβίας ἔφθὸς πρὸς ὄρχεων φλεγμονὰς καὶ ἀχῶρας καὶ λειχῆνας καὶ ψώρας καὶ μυρμηκίας καὶ τὰ καρκινώδη ἕλκη καὶ κακοήθη σὺν μέλιτι. 2 καλεῖται δὲ τὸ ἕτερον αὐτῶν εἶδος κριός. ἀμφότεροι δʼ εἰσὶ διουρητικώτατοι, διδομένου πρὸς ἴκτερον καὶ ὕδρωπα τοῦ ἀρεψήματος αὐτῶν σὺν λιδανωτίδι, — βλάπτουσι δὲ καὶ κύστιν εἱλκωμένην καὶ νεφρούς — πρός τε μυρμηκίας καὶ ἀκροχορδόνας νουμηνίας οὔσης ἔνιοι ἑκάστης ἐξοχῆς ἐρεβίνθῳ ψαύοντες ἄλλῳ καὶ ἄλλῳ εἴς τε ὀθόνιον ἀποδήσαντες αὐτοὺς ῥίπτειν εἰς τοὐπίσω κελεύουσιν, ὡς ἀποπιπτουσῶν τῶν ἀκροχορδόνων. γίνεται δὲ καὶ ἄγριος ἐρέβινθος, ὅμοιος τοῖς φύλλοις τῷ ἡμέρῳ . ἐσμῇ δριμύς, τῷ καρπῷ διαφέρων, ποιῶν πρὸς ὅσα καὶ ὁ ἥμερος.","spans":[{"start":19,"end":26,"concept_id":"constipation","polarity":"action"},{"start":30,"end":37,"concept_id":"diuresis","polarity":"action"},{"start":41,"end":59,"concept_id":"flatulence","polarity":"adverse"},{"start":87,"end":104,"concept_id":"amenorrhea","polarity":"action"},{"start":98,"end":116,"concept_id":"abortifacient","polarity":"action"},{"start":122,"end":135,"concept_id":"lactation","polarity":"action"},{"start":195,"end":202,"concept_id":"inflammation","polarity":"therapeutic"},{"start":209,"end":213,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":220,"end":226,"concept_id":"dermatitis","polarity":"therapeutic"},{"start":233,"end":238,"concept_id":"itch_scabies","polarity":"therapeutic"},{"start":243,"end":250,"concept_id":"warts","polarity":"therapeutic"},{"start":260,"end":268,"concept_id":"cancer","polarity":"therapeutic"},{"start":270,"end":274,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":360,"end":369,"concept_id":"diuresis","polarity":"action"},{"start":392,"end":397,"concept_id":"jaundice","polarity":"therapeutic"},{"start":404,"end":409,"concept_id":"edema_dropsy","polarity":"therapeutic"},{"start":450,"end":471,"concept_id":"kidney_disease","polarity":"adverse"},{"start":474,"end":484,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":489,"end":496,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":507,"end":514,"concept_id":"warts","polarity":"therapeutic"},{"start":521,"end":529,"concept_id":"warts","polarity":"therapeutic"},{"start":689,"end":697,"concept_id":"warts","polarity":"therapeutic"}]},"cul:076-chick-pease-or-cicers":{"ref":"Culpeper, Complete Herbal: Chick-Pease, Or Cicers","headword":"Chick-Pease, Or Cicers","lang":"en","source":"culpeper","text":"They are both under the dominion of Venus. They are less windy than beans, but nourish more; they provoke urine, and are thought to increase sperm; they have a cleansing faculty, whereby they break the stone in the kidneys. To drink the cream of them, being boiled in water, is the best way. It moves the belly downwards, provokes women’s courses and urine, increases both milk and seed. One ounce of Cicers, two ounces of French barley, and a small handful of Marsh-mallow roots, clean washed and cut, being boiled in the broth of a chicken, and four ounces taken in the morning, and fasting two hours after, is a good medicine for a pain in the sides. The white Cicers are used more for meat than medicine, yet have the same effect, and are thought more powerful to increase milk and seed. The wild Cicers are so much more powerful than the garden kinds, by how much they exceed them in heat and dryness; whereby they do more open obstructions, break the stone, and have all the properties of cutting, opening, digesting, and dissolving; and this more speedily and certainly than the former. CINQUEFOIL, OR FIVE-LEAVED GRASS; CALLED IN SOME COUNTIES,","spans":[{"start":52,"end":62,"concept_id":"flatulence","polarity":"adverse"},{"start":98,"end":111,"concept_id":"diuresis","polarity":"action"},{"start":132,"end":146,"concept_id":"sexual_function","polarity":"action"},{"start":202,"end":207,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":215,"end":222,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":295,"end":310,"concept_id":"constipation","polarity":"action"},{"start":322,"end":346,"concept_id":"amenorrhea","polarity":"action"},{"start":358,"end":377,"concept_id":"lactation","polarity":"action"},{"start":768,"end":790,"concept_id":"sexual_function","polarity":"action"},{"start":957,"end":962,"concept_id":"urolithiasis","polarity":"therapeutic"}]}},"images":["erebinthos-119r-dioscoride-vienne"]}