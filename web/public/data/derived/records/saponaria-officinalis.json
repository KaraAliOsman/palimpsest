"cul":0,"persistent":false,"epmc_pair":0,"lift":0.19,"evidence_tier":"unstudied"},{"concept_id":"jaundice","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.58,"evidence_tier":"unstudied"},{"concept_id":"kidney_disease","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.21,"evidence_tier":"unstudied"},{"concept_id":"liver_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":2,"lift":0.94,"evidence_tier":"sparse"},{"concept_id":"scaly_skin","dsc":1,"cul":0,"persistent":false,"epmc_pair":3,"lift":3.76,"evidence_tier":"sparse"},{"concept_id":"spleen_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":3,"lift":2.14,"evidence_tier":"sparse"},{"concept_id":"syphilis","dsc":0,"cul":1,"persistent":false,"epmc_pair":0,"lift":0.72,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:2.163":{"ref":"De materia medica 2.163","headword":"στρούθιον","lang":"grc","source":"dioscorides","text":"στρούθιον, ᾧ οἱ ἐριοπλύται χρῶνται πρὸς κάθαρσιν τῶν ἐρίων, γνώριμόν ἐστιν, οὗ ἡ ῥίζα δριμεῖα καὶ οὐρητική, βοηθοῦσα ἡπατικοῖς, βηξίν, ἀρθοπνοίαις, ἰκτέρῳ σὺν μέλιτι κοχλιαρίου πλῆθος λαμβανομένη, κοιλίαν τε ὑπάγει. σὺν δὲ πάνακι καὶ καππάρεως ῥίζῃ λημφθὲν λίθους θρύπτει καὶ ἐξουρεῖν ποιεῖ καὶ σπλῆνα ἐσκιρρωμένον τήκει, προστεθὲν δὲ ἔμμηνα ἄγει καὶ ἔμβρυα φθείρει ἐνεργῶς, σὺν ἀλφίτῳ δὲ καὶ ὄξει καταπλασθὲν λέπρας αἴρει· διαφορεῖ καὶ τὰ φύματα σὺν ἀλεύρῳ κριθίνῳ καὶ οἴνῳ ἑψηθέν. μείγνυται δὲ καὶ κολλυρίοις ὀξυδερκέσι καὶ μαλάγμασι· κινεῖ δὲ καὶ πταρμούς, καὶ εἰς τὰς ῥῖνας δὲ ἐγχεόμενον λεῖον μετὰ μέλιτος καθαίρει διὰ στόματος.","spans":[{"start":98,"end":105,"concept_id":"diuresis","polarity":"action"},{"start":117,"end":126,"concept_id":"liver_disease","polarity":"therapeutic"},{"start":135,"end":141,"concept_id":"asthma_dyspnea","polarity":"therapeutic"},{"start":148,"end":153,"concept_id":"jaundice","polarity":"therapeutic"},{"start":197,"end":212,"concept_id":"constipation","polarity":"action"},{"start":257,"end":269,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":276,"end":284,"concept_id":"diuresis","polarity":"action"},{"start":295,"end":301,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":335,"end":346,"concept_id":"amenorrhea","polarity":"action"},{"start":342,"end":357,"concept_id":"abortifacient","polarity":"action"},{"start":410,"end":414,"concept_id":"scaly_skin","polarity":"therapeutic"},{"start":440,"end":446,"concept_id":"abscess","polarity":"therapeutic"},{"start":511,"end":518,"concept_id":"eye_disease","polarity":"therapeutic"}]},"cul:283-sopewort-or-bruisewort":{"ref":"Culpeper, Complete Herbal: Sopewort, Or Bruisewort","headword":"Sopewort, Or Bruisewort","lang":"en","source":"culpeper","text":"Venus owns it. The country people in divers places do use to bruise the leaves of Sopewort, and lay it to their fingers, hands or legs, when they are cut, to heal them up again. Some make great boast thereof, that it is diuretical to provoke urine, and thereby to expel gravel and the stone in the reins or kidneys, and do also account it singularly good to void hydropical waters: and they no less extol it to perform an absolute cure in the French pox, more than either sarsaparilla, guiacum, or China can do; which, how true it is, I leave others to judge.","spans":[{"start":220,"end":230,"concept_id":"diuresis","polarity":"action"},{"start":234,"end":247,"concept_id":"diuresis","polarity":"action"},{"start":270,"end":276,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":285,"end":290,"concept_id":"urolithiasis","polarity":"therapeutic"},{"start":298,"end":303,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":307,"end":314,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":363,"end":373,"concept_id":"edema_dropsy","polarity":"therapeutic"},{"start":450,"end":453,"concept_id":"syphilis","polarity":"therapeutic"}]}},"images":[]}