θέν. ἐσθιόμενον δὲ συνεχῶς ἀμαυρωτικὸν ὄψεως γίνεται, καὶ κακοστόμαχον δέ ἐστιν. ἀρήγει καὶ θηριοδήκτοις σὺν μελικράτῳ πινόμενος ὁ χυλός, καὶ αὐτὸ δὲ καταπλασσόμενον ὠφελεῖ· βοηθεῖ καὶ ὐταλγίαις ὁ χυλὸς καὶ ἤχοις σὺν ὄξει καὶ λιβανωτῷ ἢ γάλακτι ἢ ῥοδίνῳ ἐνσταγείς. αἴρει δὲ καὶ ἰόνθους τὰ φύλλα σὺν ῥοὶ τῷ ἐπὶ τὰ ὄψα καταπλασθέντα, καὶ ἐπινυκτίδας ἰᾶται, ἐσχάρας τε περιρρήττει σὺν ἁλσὶν ἐπιπλαττόμενα. τοῦ μέντοι σπέρματος δραχμαὶ δύο μετὰ μύρτων ἴσων ποθεῖσαι τὰς χρονίους ἀναγωγὰς τοῦ αἵματος ἐπέχουσιν.","spans":[{"start":230,"end":248,"concept_id":"diarrhea","polarity":"therapeutic"},{"start":316,"end":321,"concept_id":"flatulence","polarity":"adverse"},{"start":336,"end":344,"concept_id":"insomnia","polarity":"adverse"},{"start":348,"end":355,"concept_id":"diuresis","polarity":"action"},{"start":359,"end":366,"concept_id":"constipation","polarity":"action"},{"start":383,"end":390,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":405,"end":422,"concept_id":"amenorrhea","polarity":"action"},{"start":424,"end":438,"concept_id":"kidney_disease","polarity":"adverse"},{"start":442,"end":452,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":457,"end":463,"concept_id":"kidney_disease","polarity":"therapeutic"},{"start":497,"end":515,"concept_id":"cough","polarity":"action"},{"start":613,"end":620,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":865,"end":873,"concept_id":"sexual_function","polarity":"action"},{"start":956,"end":962,"concept_id":"tuberculosis","polarity":"therapeutic"},{"start":1055,"end":1065,"concept_id":"dyspepsia","polarity":"adverse"},{"start":1089,"end":1098,"concept_id":"envenomation","polarity":"therapeutic"},{"start":1204,"end":1209,"concept_id":"ear_disease","polarity":"therapeutic"},{"start":1275,"end":1279,"concept_id":"skin_blemishes","polarity":"therapeutic"},{"start":1333,"end":1342,"concept_id":"abscess","polarity":"therapeutic"},{"start":1472,"end":1490,"concept_id":"hemoptysis","polarity":"therapeutic"},{"start":1485,"end":1502,"concept_id":"hemorrhage","polarity":"therapeutic"}]}},"images":[]}