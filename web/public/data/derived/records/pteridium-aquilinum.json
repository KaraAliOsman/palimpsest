{"slug":"pteridium-aquilinum","plant":{"taxon":"Pteridium aquilinum","family":"Dennstaedtiaceae","rank":"species","gbif_key":5275012,"wikidata":"Q213548","iucn":null,"gbif_occurrences":1118236,"common_name":"bracken","names":[{"source":"dioscorides","name":"θηλυπτερίς","monograph_id":"dsc:4.185","confidence":"medium","note":"Many fronds, not from one stock; Berendes: Pteris aquilina (bracken)."}],"n_compounds":127,"top_compounds":[{"name":"coumarin","qid":"Q111812"},{"name":"beta-sitosterol","qid":"Q121802"},{"name":"ecdysone","qid":"Q139085"},{"name":"fumaric acid","qid":"Q139857"},{"name":"alpha carotene (stereochemistry specified)","qid":"Q142871"},{"name":"zeaxanthin","qid":"Q169337"},{"name":"benzoic acid","qid":"Q191700"},{"name":"succinic acid","qid":"Q213050"}],"epmc_total":473,"trials":1,"claims":[{"concept_id":"abortifacient","dsc":1,"cul":0,"persistent":false,"epmc_pair":2,"lift":1.46,"evidence_tier":"sparse"},{"concept_id":"constipation","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.51,"evidence_tier":"unstudied"},{"concept_id":"contraception","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.35,"evidence_tier":"unstudied"},{"concept_id":"helminthiasis","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.32,"evidence_tier":"unstudied"},{"concept_id":"skin_ulcers","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.58,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:4.185":{"ref":"De materia medica 4.185","headword":"θηλυπτερίς","lang":"grc","source":"dioscorides","text":"θηλυπτερίς· οἱ δὲ νυμφαίαν πτέριν ὀνομάζουσι. τὰ μὲν φύλλα πτέριδι ὅμοια, οὐ μονόμοσχα δὲ ὡς τὰ ἐκείνης, ἀλλὰ πολλὰς ἔχοντα ἀποφύσεις καὶ ὑψηλοτέρας· ῥίζαι δʼ ὕπεισι πλάγιαι, μακραί, πλείους ὑπόξανθοι ἐν τῷ μέλανι, τινὲς δʼ ῤυθραί. καὶ αὖται δὲ σὺν μέλιτι ἐν ἐκλεικτῷ πλατεῖαν ἕλμιν ἐξάγουσι, σὺν οἴνῳ δὲ πινόμεναι δραχμῶν τριῶν πλῆθος στρογγύλην ἐκτινάσσουσιν ἕλμιν· γυναιξὶ δὲ δοθεῖσαι ἀσυλλημψίαν ποιοῦσι, κἂν ἔγκυος δὲ λάβη, ἐκτιτρώσκει. ξηραὶ δὲ καὶ ἐπὶ τῶν δυσαλθῶν καὶ καθύγρων ἑλκῶν ἐπιπάσσονται, λόφους τε ὑποζυγίων ἰῶνται. τὰ δὲ φύλλα αὐτῆς ἀρτίβλαστα λαχανευθέντα ἑφθὰ καὶ βρωθέντα κοιλίαν μαλάσσει.","spans":[{"start":277,"end":282,"concept_id":"helminthiasis","polarity":"therapeutic"},{"start":361,"end":366,"concept_id":"helminthiasis","polarity":"therapeutic"},{"start":388,"end":394,"concept_id":"contraception","polarity":"action"},{"start":429,"end":438,"concept_id":"abortifacient","polarity":"action"},{"start":485,"end":490,"concept_id":"skin_ulcers","polarity":"therapeutic"},{"start":593,"end":605,"concept_id":"constipation","polarity":"action"}]}},"images":[]}