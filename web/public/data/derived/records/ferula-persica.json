e,"epmc_pair":0,"lift":0.76,"evidence_tier":"unstudied"},{"concept_id":"spleen_disease","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.76,"evidence_tier":"unstudied"},{"concept_id":"uterine_disorders","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.71,"evidence_tier":"unstudied"}],"lead_score":null},"texts":{"dsc:3.81":{"ref":"De materia medica 3.81","headword":"σαγαπηνόν","lang":"grc","source":"dioscorides","text":"σαγαπηνόν· ὀπός ἐστι πόας ναρθηκοειδοῦς, γεννωμένης ἐν Μηδίᾳ. διαφέρει δὲ αὐτοῦ τὸ διαυγές, ἔξωθεν μὲν κιρρόν, ἐκ δὲ τῶν ἐντὸς λευκόν, ὄζον μεταξὺ ὀποῦ σιλφίου καὶ χαλβάνης, δριμὺ ἐν τῇ γεύσει. ποιεῖ δὲ πρὸς θώρακος καὶ πλευρᾶς πόνον, ῥήγματα, σπάσματα, βῆχας χρονίους, πάχη τε τὰ ἐν πνεύμονι ἀνακαθαίρει. δίδοται δὲ καὶ ἐπιληπτικοῖς, ὀπισθοτονικοῖς, σπληνικοῖς, παραλυτικοῖς, κατεψυγμένοις, περιοδικοῖς πυρετοῖς ἐν ποτήματι· καὶ ἐν συγχρίσματι δὲ ὠφελίμως προσάγεται. ἄγει καὶ ἔμμηνα καὶ ἔμβρυα φθείρει μεθ᾿ ὑδρομέλιτος πινόμενον, ἀρήγει καὶ θηριοδήκτοις μετ᾿ οἴνου λαμβανόμενον, διεγείρει καὶ ὑστερικῶς πνιγομένας μετ᾿ ὄξους ὀσφραινόμενον, οὐλάς τε ἀποσμήχει τὰς ἐν ὀφθαλμοῖς καὶ ἀμβλυωπίας καὶ τὰ ἐπισκοτοῦντα ταῖς κόραις καὶ ὑποχύματα. διαλύεται δὲ ὥσπερ ὁ ὀπὸς πηγάνῳ καὶ ὕδατι ἢ πικροῖς ἀμυγδάλοις ἢ μέλιτι ἢ ἄρτῳ θερμῷ.","spans":[{"start":220,"end":231,"concept_id":"pleurisy_pneumonia","polarity":"therapeutic"},{"start":235,"end":239,"concept_id":"bruises","polarity":"therapeutic"},{"start":244,"end":251,"concept_id":"convulsions","polarity":"therapeutic"},{"start":254,"end":257,"concept_id":"cough","polarity":"therapeutic"},{"start":321,"end":328,"concept_id":"epilepsy","polarity":"therapeutic"},{"start":335,"end":344,"concept_id":"convulsions","polarity":"therapeutic"},{"start":351,"end":361,"concept_id":"spleen_disease","polarity":"therapeutic"},{"start":363,"end":372,"concept_id":"paralysis","polarity":"therapeutic"},{"start":392,"end":398,"concept_id":"malaria","polarity":"therapeutic"},{"start":469,"end":495,"concept_id":"abortifacient","polarity":"action"},{"start":543,"end":552,"concept_id":"envenomation","polarity":"therapeutic"},{"start":595,"end":602,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":668,"end":674,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":682,"end":689,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":700,"end":707,"concept_id":"eye_disease","polarity":"therapeutic"},{"start":729,"end":734,"concept_id":"eye_disease","polarity":"therapeutic"}]}},"images":[]}