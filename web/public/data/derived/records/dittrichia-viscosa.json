ent":false,"epmc_pair":1,"lift":1.06,"evidence_tier":"sparse"},{"concept_id":"headache","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.53,"evidence_tier":"unstudied"},{"concept_id":"jaundice","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.65,"evidence_tier":"unstudied"},{"concept_id":"uterine_disorders","dsc":1,"cul":0,"persistent":false,"epmc_pair":0,"lift":0.31,"evidence_tier":"unstudied"},{"concept_id":"wounds","dsc":1,"cul":0,"persistent":false,"epmc_pair":7,"lift":4.54,"evidence_tier":"studied"}],"lead_score":null},"texts":{"dsc:3.121":{"ref":"De materia medica 3.121","headword":"κόνυζα","lang":"grc","source":"dioscorides","text":"κόνυζα· ἡ μέν τις μικρά καλεῖται εὐωδεστέρα οὔσα, ἡ δὲ μείζων, ὑπερέχουσα τῷ θάμνῳ καὶ τοῖς φύλλοις, πλατυτέρα καὶ βαρύοσμος ἀμφότεραι δὲ ἐοίκασι τοῖς φύλλοις ἐλαίᾳ, Εστι δὲ δασέα ταῦτα καὶ λιπαρά· ὕψος δὲ τοῦ καυλοῦ ἡ μὲν μείζων δύο πήχεων ἔχει, ἡ δὲ ἐλάττων ποδός, ἄνθος ψαφαρόν, μήλινον, ὑπόπικρον, ἐκπαππούμενον, ῥίζαι ἄχρηστοι. 2 δύναται δὲ ὁ θάμνος σὺν τοῖς φύλλοις ὑποστρωννύμενος καὶ θυμιώμενος θηρία διώκειν καὶ κώνωπας ἀπελαύνειν· κτείνει δὲ καὶ ψύλλους. καταπλάσσεται δὲ τὰ φύλλα ὡφελίμως ἐπὶ ἑρπετοδήκτων καὶ φυμάτων καὶ τραυμάτων καὶ σὺν οἴνῳ δὲ πίνεται τὸ ἄνθος καὶ τὰ φύλλα πρὸς καταμηνίων ἀγωγὴν καὶ ἐκβολὴν ἐμβρύων καὶ στραγγουρίαν καὶ στρόφους καὶ ἴκτερον, μετʼ ὄξους δὲ ἐπιληπτικοὺς πινόμενα ὠφελεῖ· καὶ τὸ ἀφέψημα δὲ αὐτῶν ἐν ἐγκαθίσματι τὰ ἐν μήτρᾳ θεραπεύει. 3 ὁ δὲ χυλὸς προστεθεὶς ἑκτρωσμοὺς ποιεῖ· ποιεῖ δὲ καὶ πρὸς ῥίγη συγχριομένη ἡ πόα μετʼ ἐλαίου. ἡ δὲ λεπτὴ καὶ κεφαλαλγίας καταπλασσομένη ἰᾶται. γίνεται δὲ καὶ τρίτον εἶδος κονύζης, καυλῷ παχύτερον καὶ μαλακώτερον, τοῖς δὲ φύλλοις μεῖζον τῆς λεπτῆς, ἔλασσον δὲ τῆς μείζονος, οὐ λιπαρόν, βαρυοσμότερον δὲ πολλῷ καὶ ἀηδέστερον καὶ ἀπρακτότερον. φύεται δὲ ἐν ἐφύδροις τόποις.","spans":[{"start":403,"end":413,"concept_id":"envenomation","polarity":"action"},{"start":421,"end":426,"concept_id":"lice","polarity":"action"},{"start":456,"end":463,"concept_id":"lice","polarity":"action"},{"start":504,"end":514,"concept_id":"envenomation","polarity":"therapeutic"},{"start":521,"end":528,"concept_id":"abscess","polarity":"therapeutic"},{"start":533,"end":539,"concept_id":"wounds","polarity":"therapeutic"},{"start":594,"end":611,"concept_id":"amenorrhea","polarity":"action"},{"start":605,"end":631,"concept_id":"abortifacient","polarity":"action"},{"start":636,"end":645,"concept_id":"dysuria","polarity":"therapeutic"},{"start":653,"end":661,"concept_id":"colic","polarity":"therapeutic"},{"start":666,"end":671,"concept_id":"jaundice","polarity":"therapeutic"},{"start":689,"end":696,"concept_id":"epilepsy","polarity":"therapeutic"},{"start":764,"end":769,"concept_id":"uterine_disorders","polarity":"therapeutic"},{"start":805,"end":812,"concept_id":"abortifacient","polarity":"action"},{"start":841,"end":845,"concept_id":"fever","polarity":"therapeutic"},{"start":892,"end":903,"concept_id":"headache","polarity":"therapeutic"}]},"dsc:5.53":{"ref":"De materia medica 5.53","headword":"οἶνος κονυζίτης ὁμοίως σκευάζεται","lang":"grc","source":"dioscorides","text":"οἶνος κονυζίτης ὁμοίως σκευάζεται· ἔστι δὲ πάντων μᾶλλον θηριακός.","spans":[{"start":57,"end":63,"concept_id":"envenomation","polarity":"therapeutic"}]}},"images":[]}